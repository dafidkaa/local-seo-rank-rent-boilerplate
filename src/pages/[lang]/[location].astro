---
/**
 * [location].astro — Location Page Template
 * ============================================
 * Generates one page per service area location.
 * URL pattern: /en/plumbing-in-austin/ (keyword-rich: service + connector + city)
 * Target: 1,200–1,500 words of structured, locally-authoritative content
 *
 * SEO Strategy:
 *   H1: [Service] in [City], [Region]               ← primary keyword
 *   H2: [Service] Services in [City] / About [City] ← secondary keywords
 *   H3: Individual service names + city              ← long-tail keyword coverage
 *   Body: Local knowledge, landmarks, property context ← E-E-A-T local authority
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import FaqSection from "../../components/FaqSection.astro";
import FinalCta from "../../components/FinalCta.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { siteConfig, allServices } from "../../site.config";
import { t, locationSlug, locationPath, servicePath, subservicePath, localePathsFor } from "../../lib/routes";
import { seo, localBusinessSchema, breadcrumbSchema } from "../../lib/seo";
import { blocks, ui } from "../../i18n";
import ShortAnswer from "../../components/ShortAnswer.astro";
import StatsBar from "../../components/StatsBar.astro";

export async function getStaticPaths() {
  const paths: { params: { lang: string; location: string }; props: any }[] = [];
  for (const locale of siteConfig.locales) {
    for (const loc of siteConfig.locations) {
      paths.push({
        params: { lang: locale.code, location: locationSlug(locale.code, loc.id) },
        props: { locale: locale.code, location: loc },
      });
    }
  }
  return paths;
}

const { locale, location } = Astro.props;

const businessName   = siteConfig.business.name;
const city           = siteConfig.business.city;
const primaryService = t(siteConfig.business.primaryService, locale);
const phone          = siteConfig.business.phone;
const founded        = siteConfig.business.foundedYear;
const area           = siteConfig.business.serviceArea;

const locationName   = location.name;
const locationRegion = location.region;
const locSlug        = locationSlug(locale, location.id);
const pageUrl        = `/${locale}/${locSlug}/`;

// All body copy comes from the locale files (blocks.locationPage.*)
const vars = {
  business: businessName,
  service: primaryService,
  serviceLower: primaryService.toLowerCase(),
  city, area, founded, phone,
  location: locationName,
  region: locationRegion
};
const B = (key: string) => blocks(`blocks.locationPage.${key}`, locale, vars);
const whyItems: Array<{ title: string; desc: string }> = B("why.items");
const statsBarItems = [
  { value: siteConfig.stats.destinationsServed,                  label: locale === "hr" ? "Pokrivenih odredišta" : "Destinations Covered" },
  { value: locale === "hr" ? "Auto·Kombi·Bus" : "Cars·Vans·Buses", label: locale === "hr" ? "Na upit" : "On Request" },
  { value: "EN·HR·DE",                                            label: locale === "hr" ? "3 jezika" : "3 Languages" },
  { value: locale === "hr" ? "Povratni" : "Return",              label: locale === "hr" ? "Transferi dostupni" : "Transfers Available" },
];

// Local knowledge and attractions (from site.config.ts)
const knowledge   = location.knowledge  ?? `${locationName} is a community in ${locationRegion} served by ${businessName}.`;
const attractions = location.attractions ?? [];
const mapQuery    = location.mapEmbedQuery ?? `${locationName}, ${locationRegion}`;
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&t=m&z=12&ie=UTF8&iwloc=&output=embed`;

// Breadcrumbs
const crumbs = [
  { name: "Home",         url: `/${locale}/` },
  { name: "Service Areas", url: `/${locale}/service-area/` },
  { name: locationName,   url: pageUrl },
];

// FAQs from the locale content blocks
const faqs: Array<{ q: string; a: string }> = B("faqs");

// Schema
// FAQPage schema is emitted by FaqSection from its visible items.
const schemas = [
  localBusinessSchema(locale),
  breadcrumbSchema(crumbs),
];

const meta = seo({
  title:       locale === "hr" ? `Transfer Zračna luka Split – ${locationName} | ${businessName}` : `Split Airport Transfer to ${locationName} | ${businessName}`,
  description: locale === "hr"
    ? `Trebate transfer iz Zračne luke Split do ${locationName}? ${businessName} nudi privatni transfer, vozila na upit i fiksnu ponudu do ${locationName}, ${locationRegion}. Zatražite ponudu.`
    : `Need a transfer from Split Airport to ${locationName}? ${businessName} offers a private transfer, vehicles on request and a fixed quote to ${locationName}, ${locationRegion}. Request a quote.`,
  locale,
  path:        pageUrl,
  localePaths: localePathsFor((l) => locationPath(l, location.id)),
  schema:      schemas,
});

// Hero image — use location image or fallback to brand hero
const heroImage = location.image ?? (siteConfig.brand as any).images?.hero1 ?? "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1920&q=80";
const aboutImg  = (siteConfig.brand as any).images?.about ?? "https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=900&q=80";
---

<BaseLayout seo={meta}>

  <!-- ═══════════════════════════════════════════════════════════════════════
       1. HERO — H1: [Service] in [City], [Region]
       Primary keyword in H1, location in subtitle for geo-relevance
  ═══════════════════════════════════════════════════════════════════════════ -->
  <Hero
    title={`${primaryService} in ${locationName}`}
    text={B("heroText")}
    image={heroImage}
    imageAlt={`${primaryService} in ${locationName}, ${locationRegion} — ${businessName}`}
    locale={locale}
    breadcrumbs={crumbs}
  />

  <!-- AEO: direct local answer ("Do you serve {location}?") -->
  <ShortAnswer label={B("shortAnswer.label")} text={B("shortAnswer.text")} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       2. INTRO + LOCAL KNOWLEDGE (~250 words)
       H2 with location keyword, body copy establishes local authority
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="intro-heading">
    <div class="container loc-intro">
      <div class="loc-intro-copy">
        <p class="eyebrow">{primaryService} in {locationName}</p>
        <h2 id="intro-heading">{B("intro.heading")}</h2>
        <p>{B("intro.p1")}</p>
        <p>
          {knowledge}
        </p>
        <p>{B("intro.p3")}</p>
        {attractions.length > 0 && (
          <p class="loc-landmarks">
            <strong>{B("intro.landmarksLabel")}</strong>{" "}
            {attractions.join(" · ")}
          </p>
        )}
        <div class="intro-actions">
          <button class="btn btn-primary" data-open-form-popup aria-haspopup="dialog">
            {B("intro.ctaPrimary")}
          </button>
          <a href={`tel:${phone}`} class="btn btn-outline">{ui("blocks.common.callPhone", locale, { phone })}</a>
        </div>
      </div>
      <div class="loc-intro-image img-premium">
        <img
          src={heroImage}
          alt={`${primaryService} service in ${locationName} — ${businessName}`}
          width="600" height="400"
          loading="lazy" decoding="async"
          class="intro-img"
        />
      </div>
    </div>
  </section>

  <!-- Animated trust stats -->
  <StatsBar stats={statsBarItems} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       3. SERVICES IN LOCATION GRID (~300 words)
       H2 with service + location keyword, H3 per service = long-tail coverage
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <p class="eyebrow">{B("services.eyebrow")}</p>
      <h2 id="services-heading">{B("services.heading")}</h2>
      <p class="section-lead">{B("services.lead")}</p>
      <div class="loc-services-grid">
        {allServices.map((service: any) => (
          <div class="loc-service-card">
            <h3 class="loc-service-title">
              <a href={servicePath(locale, service)}>{t(service.title, locale)}</a>
            </h3>
            <p class="loc-service-desc">{t(service.short, locale)}</p>
            {service.children && service.children.length > 0 && (
              <ul class="loc-service-children">
                {service.children.slice(0, 3).map((child: any) => (
                  <li>
                    <a href={subservicePath(locale, service, child)} class="loc-child-link">
                      {t(child.title, locale)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <a href={servicePath(locale, service)} class="loc-service-cta">{ui("blocks.common.learnMore", locale)}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       4. WHY CHOOSE US FOR THIS LOCATION (~200 words)
       H2 with brand + location keyword
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-charcoal" aria-labelledby="why-heading">
    <div class="container">
      <p class="eyebrow" style="color:var(--brand-accent)">{B("why.eyebrow")}</p>
      <h2 id="why-heading" style="color:#fff">{B("why.heading")}</h2>
      <p class="section-lead" style="color:rgba(255,255,255,.75)">{B("why.lead")}</p>
      <div class="why-grid">
        {whyItems.map((item) => (
          <div class="why-item">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       5. PROCESS SECTION
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ProcessSection
    title={B("process.title")}
    subtitle={B("process.subtitle")}
    steps={B("process.steps")}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       6. GOOGLE MAPS EMBED — Service area visualization
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="map-heading">
    <div class="container">
      <p class="eyebrow">{B("map.eyebrow")}</p>
      <h2 id="map-heading">{B("map.heading")}</h2>
      <p class="section-lead">{B("map.lead")}</p>
      <div class="map-wrap">
        <iframe
          src={mapEmbedSrc}
          title={`${primaryService} service area map — ${locationName}, ${locationRegion}`}
          width="100%"
          height="420"
          style="border:0; border-radius: var(--radius-lg); display: block;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          aria-label={`Map showing ${locationName}, ${locationRegion} — ${businessName} service area`}
        ></iframe>
      </div>
      <div class="area-tags" style="margin-top:2rem">
        {siteConfig.locations
          .filter((l: any) => l.id !== location.id)
          .sort((a: any, b: any) => (b.region === locationRegion ? 1 : 0) - (a.region === locationRegion ? 1 : 0))
          .map((loc: any) => (
          <a href={`/${locale}/${locationSlug(locale, loc.id)}/`} class="area-tag">
            {locale === "hr" ? `Zračna luka Split → ${loc.name}` : `Split Airport → ${loc.name}`}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       7. ABOUT / TRUST SECTION (~150 words)
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container about-split">
      <div class="about-copy">
        <p class="eyebrow">{B("about.eyebrow")}</p>
        <h2 id="about-heading">{B("about.heading")}</h2>
        <p>{B("about.p1")}</p>
        <p>{B("about.p2")}</p>
        <p>{B("about.p3")}</p>
      </div>
      <div class="about-image-wrap img-premium">
        <img
          src={aboutImg}
          alt={`${businessName} — trusted ${primaryService.toLowerCase()} professionals in ${locationName}`}
          width="600" height="400"
          loading="lazy" decoding="async"
          class="about-img"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       8. REVIEWS
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ReviewsSection locale={locale as string} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       9. FAQ — AEO/GEO optimised with location + service keywords
  ═══════════════════════════════════════════════════════════════════════════ -->
  <FaqSection
    title={B("faqTitle")}
    items={faqs}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       10. CTA STRIP
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="cta-strip">
    <div class="container cta-strip-inner">
      <div class="cta-strip-text">
        <h2>{B("ctaStrip.heading")}</h2>
        <p>{B("ctaStrip.sub")}</p>
      </div>
      <div class="cta-strip-actions">
        <button class="btn btn-primary" data-open-form-popup aria-haspopup="dialog" aria-label={ui("blocks.common.requestEstimate", locale)}>
          {ui("blocks.common.requestEstimate", locale)}
        </button>
        <a href={`tel:${phone}`} class="btn btn-outline-light">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.93 2 2 0 0 1 3.6 2.73h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/></svg>
          {phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       11. FINAL CTA FORM
  ═══════════════════════════════════════════════════════════════════════════ -->
  <FinalCta
    locale={locale}
    title={B("finalCta.title")}
    text={B("finalCta.text")}
  />

</BaseLayout>

<style>
  /* ── Location intro split ────────────────────────────────────────────────── */
  .loc-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .loc-intro-copy h2 { margin-bottom: 20px; }
  .loc-intro-copy p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }
  .loc-landmarks {
    background: var(--brand-accent-light, #fef3c7);
    border-left: 3px solid var(--brand-accent);
    padding: 12px 16px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .intro-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .intro-img {
    width: 100%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
    display: block;
  }
  @media (max-width: 768px) {
    .loc-intro { grid-template-columns: 1fr; }
    .loc-intro-image { order: -1; }
  }

  /* ── Services grid ───────────────────────────────────────────────────────── */
  .loc-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: clamp(32px, 5vw, 48px);
  }
  .loc-service-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: clamp(20px, 3vw, 28px);
    transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
  }
  .loc-service-card:hover {
    box-shadow: var(--shadow-hover);
    border-color: var(--brand-accent);
    transform: translateY(-2px);
  }
  /* .loc-service-card-inner removed — padding now on .loc-service-card directly */
  .loc-service-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 10px;
  }
  .loc-service-title a { color: inherit; text-decoration: none; }
  .loc-service-title a:hover { color: var(--brand-accent); }
  .loc-service-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 14px;
  }
  .loc-service-children {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }
  .loc-service-children li { margin-bottom: 6px; }
  .loc-child-link {
    font-size: 0.8125rem;
    color: var(--brand-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .loc-child-link:hover { color: var(--brand-accent); text-decoration: underline; }
  .loc-service-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-accent);
    margin-top: auto;
    padding-top: 12px;
    display: block;
    text-decoration: none;
  }
  .loc-service-cta:hover { text-decoration: underline; }

  /* ── Why grid ────────────────────────────────────────────────────────────── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(24px, 4vw, 40px);
    margin-top: clamp(32px, 5vw, 48px);
  }
  .why-item h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 10px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--brand-accent);
  }
  .why-item p {
    font-size: 0.9rem;
    color: rgba(255,255,255,.7);
    line-height: 1.75;
    margin: 0;
  }
  @media (max-width: 640px) {
    .why-grid { grid-template-columns: 1fr; }
  }

  /* ── Map ─────────────────────────────────────────────────────────────────── */
  .map-wrap {
    margin-top: clamp(24px, 4vw, 36px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
  }

  /* ── Area tags ───────────────────────────────────────────────────────────── */
  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .area-tag {
    display: inline-block;
    padding: 8px 16px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: background .2s, border-color .2s, color .2s;
  }
  .area-tag:hover {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #fff;
  }

  /* ── About split ─────────────────────────────────────────────────────────── */
  .about-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .about-copy h2 { margin-bottom: 20px; }
  .about-copy p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }
  .about-img {
    width: 100%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
    display: block;
  }
  @media (max-width: 768px) {
    .about-split { grid-template-columns: 1fr; }
    .about-image-wrap { order: -1; }
  }

  /* ── CTA strip ───────────────────────────────────────────────────────────── */
  .cta-strip {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(700px 320px at 8% 120%, var(--accent-glow), transparent 60%),
      var(--gradient-primary);
    padding: 3.5rem 0;
  }
  .cta-strip-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-strip-text h2 { font-size: clamp(1.25rem, 2.5vw, 1.5rem); font-weight: 800; color: white; margin: 0 0 0.5rem; }
  .cta-strip-text p { color: rgba(255,255,255,0.75); margin: 0; font-size: 0.9375rem; }
  .cta-strip-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-outline-light {
    border: 2px solid rgba(255,255,255,0.5);
    color: white;
    background: transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-outline-light:hover { border-color: white; background: rgba(255,255,255,0.12); color: white; }
  @media (max-width: 640px) {
    .cta-strip-inner { flex-direction: column; text-align: center; }
    .cta-strip-actions { justify-content: center; }
  }

  /* ── Section lead ────────────────────────────────────────────────────────── */
  .section-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    max-width: 680px;
    line-height: 1.7;
    margin-top: 12px;
  }
</style>
