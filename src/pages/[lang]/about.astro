---
/**
 * About page — premium, trust-building, ~1,500 words
 * Fully aligned with SEO/AEO/GEO requirements
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import FaqSection from "../../components/FaqSection.astro";
import FinalCta from "../../components/FinalCta.astro";
import ContentSection from "../../components/ContentSection.astro";
import { t, locationPath } from "../../lib/routes";
import { siteConfig, allServices } from "../../site.config";
import { seo, localBusinessSchema, breadcrumbSchema, aboutPageSchema } from "../../lib/seo";

export async function getStaticPaths() {
  return siteConfig.locales.map(locale => ({
    params: { lang: locale.code },
    props: { locale: locale.code },
  }));
}

const { locale } = Astro.props;
const isHr = locale === "hr";
const city = siteConfig.business.city;
const businessName = siteConfig.business.name;
const phone = siteConfig.business.phone;
const area = siteConfig.business.serviceArea;
const primaryService = t(siteConfig.business.primaryService, locale);

const crumbs = [
  { name: isHr ? "Početna" : "Home", url: `/${locale}/` },
  { name: isHr ? "O nama" : "About Us", url: `/${locale}/about/` },
];

const faqsRaw = isHr ? [
  { q: `Što je ${businessName}?`, a: `${businessName} je online resurs za rezervaciju privatnih transfera iz Zračne luke Split (SPU) do odredišta diljem ${area}. Pošaljete upit, a operater potvrđuje dostupnost i fiksnu ponudu.` },
  { q: `Do kojih odredišta vozite?`, a: `Pokrivamo više od 60 odredišta, uključujući ${siteConfig.locations.slice(0, 5).map(l => l.name).join(", ")} i druga mjesta u ${area}. Javite nam svoju rutu i potvrdit ćemo je.` },
  { q: `Koja vozila su dostupna?`, a: `Na upit su dostupni automobili, kombiji, minibusi i autobusi — za parove, obitelji i grupe od 8 ili više osoba, s prostorom za prtljagu. Dječje sjedalice na upit.` },
  { q: `Plaćam li unaprijed na ovoj stranici?`, a: `Ne. Ova stranica služi za upite. Dobit ćete fiksnu ponudu za potvrdu, a plaćanje dogovarate izravno s operaterom transfera.` },
  { q: `Kako dobivam ponudu?`, a: `Ispunite obrazac, pošaljite e-poštu na ${siteConfig.business.email} ili nazovite ${phone}. Navedite rutu, broj leta, broj putnika i prtljagu kako bi ponuda bila točna.` },
] : [
  { q: `What is ${businessName}?`, a: `${businessName} is an online resource for booking private transfers from Split Airport (SPU) to destinations across ${area}. You send an inquiry, and the operator confirms availability and a fixed quote.` },
  { q: `Which destinations do you cover?`, a: `We cover over 60 destinations, including ${siteConfig.locations.slice(0, 5).map(l => l.name).join(", ")} and other places across ${area}. Tell us your route and we will confirm it.` },
  { q: `What vehicles are available?`, a: `Cars, vans, minibuses and buses are available on request — for couples, families and groups of 8 or more, with space for luggage. Child seats on request.` },
  { q: `Do I pay upfront on this site?`, a: `No. This site is for inquiries. You receive a fixed quote to confirm, and you arrange payment directly with the transfer operator.` },
  { q: `How do I get a quote?`, a: `Fill out the form, email ${siteConfig.business.email}, or call ${phone}. Share your route, flight number, passenger count and luggage so the quote is accurate.` },
];

const faqs = faqsRaw.map(f => ({ question: f.q, answer: f.a }));
const schemas = [
  localBusinessSchema(locale),
  breadcrumbSchema(crumbs),
  aboutPageSchema(locale),
].filter(Boolean);

const meta = seo({
  title: `${isHr ? "O nama" : "About"} ${businessName} | ${primaryService}`,
  description: isHr
    ? `Saznajte više o ${businessName} — privatni transferi iz Zračne luke Split do ${area}. Automobili, kombiji i autobusi na upit, fiksne ponude, više od 60 odredišta.`
    : `Learn about ${businessName} — private transfers from Split Airport to ${area}. Cars, vans and buses on request, fixed quotes, and over 60 destinations covered.`,
  locale,
  path: `/${locale}/about/`,
  schema: schemas,
});
---
<BaseLayout seo={meta}>
  <!-- HERO -->
  <Hero
    title={isHr ? `O nama — ${businessName}` : `About ${businessName}`}
    text={isHr
      ? `Privatni transferi iz Zračne luke Split do hotela, vila, marina i trajektne luke diljem ${area}. Automobili, kombiji i autobusi na upit, s fiksnom ponudom unaprijed.`
      : `Private transfers from Split Airport to hotels, villas, marinas and the ferry port across ${area}. Cars, vans and buses on request, with a fixed quote upfront.`}
    image={(siteConfig.brand as any).images?.about ?? 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80'}
    imageAlt={isHr ? `${businessName} — privatni transferi iz Zračne luke Split` : `${businessName} — private Split Airport transfers`}
    locale={locale as any}
    breadcrumbs={crumbs}
  />

  <!-- OUR STORY -->
  <ContentSection
    eyebrow={isHr ? "Tko smo" : "Who We Are"}
    title={isHr ? "Vaš resurs za dolazak u Split" : "Your Split Arrival Resource"}
    text={isHr
      ? `${businessName} postoji s jednostavnim ciljem: učiniti dolazak u Zračnu luku Split jednostavnim. Umjesto traženja prijevoza nakon dugog leta, pošaljete upit s rutom i detaljima leta, a operater potvrđuje dostupnost i jasnu fiksnu ponudu.\n\nPovezujemo putnike s privatnim transferima do hotela, apartmana, vila, marina, trajektne luke i obližnjih dalmatinskih odredišta. Vozila — automobili, kombiji, minibusi i autobusi — dostupna su na upit, pa pravo vozilo odgovara vašoj grupi i prtljazi.\n\nStranice su dostupne na engleskom, hrvatskom i njemačkom, a upit možete poslati u bilo koje doba. Ova stranica služi za upite: ne plaćate unaprijed ovdje, već dogovarate izravno s operaterom transfera.`
      : `${businessName} exists with one simple goal: to make arriving at Split Airport easy. Instead of hunting for transport after a long flight, you send an inquiry with your route and flight details, and the operator confirms availability and a clear fixed quote.\n\nWe connect travellers with private transfers to hotels, apartments, villas, marinas, the ferry port and nearby Dalmatian destinations. Vehicles — cars, vans, minibuses and buses — are available on request, so the right vehicle matches your group and luggage.\n\nPages are available in English, Croatian and German, and you can send an inquiry at any time. This site is for inquiries: you do not pay upfront here, but arrange directly with the transfer operator.`}
    image={(siteConfig.brand as any).images?.team ?? 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80'}
    imageAlt={isHr ? `Privatni transfer u ${area}` : `Private transfer in ${area}`}
  />

  <!-- HOW IT WORKS -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{isHr ? "Kako to funkcionira" : "How It Works"}</span>
        <h2 class="section-title">{isHr ? "Od upita do dolaska" : "From Quote to Arrival"}</h2>
        <p class="section-lead">{isHr ? "Četiri jednostavna koraka od upita do udobnog privatnog puta do vašeg odredišta." : "Four simple steps from inquiry to a comfortable private ride to your destination."}</p>
      </div>
      <div class="timeline">
        {(isHr ? [
          { year: "1", event: "Zatražite ponudu — podijelite rutu, broj leta, broj putnika i prtljagu putem obrasca ili e-pošte." },
          { year: "2", event: "Dobijte dostupnost i fiksnu ponudu od operatera — bez plaćanja unaprijed na ovoj stranici." },
          { year: "3", event: "Dolazak u Zračnu luku Split — pronađite svog vozača na dogovorenom mjestu preuzimanja." },
          { year: "4", event: "Privatni put do odredišta — hotela, vile, marine ili trajektne luke. Povratni transfer na upit." },
        ] : [
          { year: "1", event: "Request a quote — share your route, flight number, passenger count and luggage by form or email." },
          { year: "2", event: "Receive availability and a fixed quote from the operator — no upfront payment on this site." },
          { year: "3", event: "Arrive at Split Airport — meet your driver at the agreed pickup point." },
          { year: "4", event: "Travel privately to your destination — hotel, villa, marina or the ferry port. Return transfer on request." },
        ]).map((item) => (
          <div class="timeline-item">
            <div class="timeline-year">{item.year}</div>
            <div class="timeline-connector"><div class="timeline-dot"></div></div>
            <div class="timeline-content">{item.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT YOU CAN REQUEST -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{isHr ? "Što možete zatražiti" : "What You Can Request"}</span>
        <h2 class="section-title" style="color:var(--color-light)">{isHr ? "Transferi prilagođeni vašem putovanju" : "Transfers Built Around Your Trip"}</h2>
        <p class="section-lead" style="color:rgba(255,255,255,0.75)">{isHr ? `Privatni transferi po cijelom ${area}, planirani oko vašeg leta, grupe i odredišta.` : `Private transfers across ${area}, planned around your flight, your group and your destination.`}</p>
      </div>
      <div class="certs-grid">
        {(isHr ? [
          { label: "Privatno, od vrata do vrata", desc: "Izravan transfer do hotela, vile, apartmana, marine ili trajektne luke — bez dijeljenja vozila." },
          { label: "Pravo vozilo za grupu", desc: "Automobili, kombiji, minibusi i autobusi na upit, s prostorom za prtljagu cijele grupe." },
          { label: "Obitelji i grupe", desc: "Dječje i booster sjedalice na upit te mjesta za grupe od 8 ili više osoba." },
          { label: "Trajekt, marine i povratak", desc: "Vremenski osjetljivi transferi do trajektne luke i marina te povratni transferi na upit." },
        ] : [
          { label: "Private, Door-to-Door", desc: "A direct transfer to your hotel, villa, apartment, marina or the ferry port — no sharing the vehicle." },
          { label: "The Right Vehicle for Your Group", desc: "Cars, vans, minibuses and buses on request, with room for the whole group's luggage." },
          { label: "Family & Group Friendly", desc: "Child and booster seats on request, plus space for groups of 8 or more." },
          { label: "Ferry, Marinas & Return", desc: "Time-sensitive transfers to the ferry port and marinas, and return transfers on request." },
        ]).map(cert => (
          <div class="cert-card">
            <div class="cert-badge">✓</div>
            <div>
              <h3 class="cert-label">{cert.label}</h3>
              <p class="cert-desc">{cert.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{isHr ? "Naše vrijednosti" : "Our Values"}</span>
        <h2 class="section-title">{isHr ? "Što nam je važno" : "What We Stand For"}</h2>
        <p class="section-lead">{isHr ? `Načela koja vode svaki transfer koji organiziramo u ${area}.` : `The principles behind every transfer we help arrange across ${area}.`}</p>
      </div>
      <div class="values-grid">
        {(isHr ? [
          { icon: "shield", title: "Jasnoća", desc: "Dobivate fiksnu ponudu unaprijed, bez skrivenih troškova i bez plaćanja unaprijed na ovoj stranici." },
          { icon: "clock", title: "Pouzdanost", desc: "Preuzimanje se planira oko vašeg leta, pa kašnjenja ili raniji slijetanja ne znače jurnjavu za prijevozom." },
          { icon: "star", title: "Udobnost", desc: "Privatno vozilo prilagođeno vašoj grupi i prtljazi, izravno do vrata vašeg smještaja." },
          { icon: "users", title: "Za sve putnike", desc: `Parovi, obitelji s djecom, grupe te gosti vila, marina i trajekta — pokrivamo cijeli ${area}.` },
          { icon: "check", title: "Točne informacije", desc: "Iskrene smjernice o rutama, pješačkim zonama starog grada te vremenu trajekta i marina." },
          { icon: "heart", title: "Lokalno znanje", desc: "Vozači poznaju Split i Dalmaciju, od kratkih ruta do Trogira do duljih putovanja do Makarske ili Krke." },
        ] : [
          { icon: "shield", title: "Clarity", desc: "You get a fixed quote upfront, with no hidden charges and no upfront payment on this site." },
          { icon: "clock", title: "Reliability", desc: "Pickup is planned around your flight, so a delay or early landing does not leave you scrambling for transport." },
          { icon: "star", title: "Comfort", desc: "A private vehicle matched to your group and luggage, straight to the door of your accommodation." },
          { icon: "users", title: "For Every Traveller", desc: `Couples, families with children, groups, and villa, marina and ferry guests — we cover all of ${area}.` },
          { icon: "check", title: "Honest Information", desc: "Straight guidance on routes, old-town pedestrian zones, and ferry and marina timing." },
          { icon: "heart", title: "Local Knowledge", desc: "Drivers know Split and Dalmatia, from short hops to Trogir to longer trips to Makarska or Krka." },
        ]).map(v => (
          <div class="value-card">
            <div class="value-icon" aria-hidden="true">
              {v.icon === "shield" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {v.icon === "clock" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
              {v.icon === "star" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {v.icon === "users" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {v.icon === "check" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>}
              {v.icon === "heart" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
            </div>
            <div>
              <h3 class="value-title">{v.title}</h3>
              <p class="value-desc">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS / TRUST NUMBERS -->
  <section class="section section-dark">
    <div class="container">
      <div class="stats-row">
        {[
          { number: siteConfig.stats?.destinationsServed ?? "60+", label: isHr ? "Pokrivenih odredišta" : "Destinations Covered" },
          { number: isHr ? "Auto·Kombi·Bus" : "Cars·Vans·Buses", label: isHr ? "Vozila na upit" : "Vehicles on Request" },
          { number: "EN·HR·DE", label: isHr ? "Stranice na 3 jezika" : "Pages in 3 Languages" },
          { number: isHr ? "Povratni" : "Return", label: isHr ? "Transferi dostupni" : "Transfers Available" },
        ].map(stat => (
          <div class="stat-item">
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <ContentSection
    eyebrow={isHr ? "Naš pristup" : "Our Approach"}
    title={isHr ? "Kako planiramo vaš transfer" : "How We Plan Your Transfer"}
    text={isHr
      ? `Svaki transfer kreće od vašeg upita. Podijelite rutu, broj leta, broj putnika i prtljagu, a spomenete li dječje sjedalice, jedriličarsku prtljagu ili polazak trajekta, operater predlaže pravo vozilo.\n\nDobivate jasnu fiksnu ponudu za potvrdu prije puta. Komuniciramo jasno: vrijeme preuzimanja usklađuje se s vašim letom, a za stari grad Splita vozač koristi najbližu prikladnu pristupnu točku zbog pješačke zone.\n\nNa dan dolaska vozač vas dočeka u Zračnoj luci Split i vozi izravno do odredišta. Povratni transfer do zračne luke možete zatražiti u istom upitu, s dovoljnom rezervom za vaš odlazni let.\n\nTaj jednostavan, transparentan proces čini dolazak u ${area} bezbrižnim — od kratke rute do Trogira do duljeg puta do Makarske ili Šibenika.`
      : `Every transfer starts with your inquiry. Share your route, flight number, passenger count and luggage, and if you mention child seats, sailing bags or a ferry departure, the operator suggests the right vehicle.\n\nYou receive a clear fixed quote to confirm before you travel. We communicate clearly: pickup is timed around your flight, and for Split's old town the driver uses the nearest suitable access point because of the pedestrian zone.\n\nOn arrival day your driver meets you at Split Airport and drives you straight to your destination. You can request a return transfer to the airport in the same inquiry, with enough margin for your departure flight.\n\nThat simple, transparent process makes arriving in ${area} stress-free — from a short hop to Trogir to a longer trip to Makarska or Šibenik.`}
    image={(siteConfig as any).images?.process ?? "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=900&q=80"}
    imageAlt={isHr ? `Privatni transfer u ${area}` : `Private transfer in ${area}`}
    reversed={true}
  />

  <!-- SERVICE AREA -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{isHr ? "Kamo vozimo" : "Where We Go"}</span>
        <h2 class="section-title">{isHr ? "Naša odredišta" : "Our Destinations"}</h2>
        <p class="section-lead">{isHr ? `Pokrivamo Split i središnju Dalmaciju. Evo nekih od odredišta do kojih redovito vozimo:` : `We cover Split and Central Dalmatia. Here are some of the destinations we regularly drive to:`}</p>
      </div>
      <div class="area-grid">
        {siteConfig.locations.map(loc => (
          <a href={locationPath(locale, loc.id)} class="area-pill">{loc.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <ReviewsSection locale={locale as any} />

  <!-- FAQ -->
  <FaqSection faqs={faqsRaw.map(f => ({ q: f.q, a: f.a }))} locale={locale as any} />

  <!-- FINAL CTA -->
  <FinalCta locale={locale as any} />
</BaseLayout>

<style>
  .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .value-card { display: flex; gap: 1rem; padding: 1.5rem; background: white; border: 1px solid var(--color-border); border-radius: 12px; box-shadow: var(--shadow-card); }
  .value-icon { flex-shrink: 0; width: 44px; height: 44px; background: var(--brand-accent); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--color-text); }
  .value-title { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.375rem; }
  .value-desc { font-size: 0.875rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; }
  .section-dark { background: var(--surface-dark); }
  .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 2rem; text-align: center; }
  .stat-number { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: var(--brand-accent); line-height: 1; }
  .stat-label { font-size: 0.875rem; color: rgba(255,255,255,0.7); margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .area-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .area-pill { padding: 0.5rem 1.25rem; background: white; border: 1px solid var(--color-border); border-radius: 100px; font-size: 0.875rem; font-weight: 500; color: var(--color-text); text-decoration: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .area-pill:hover { background: var(--brand-accent); border-color: var(--brand-accent); color: var(--color-text); }
  /* Timeline */
  .timeline { display: flex; flex-direction: column; gap: 0; margin-top: 3rem; position: relative; }
  .timeline-item { display: grid; grid-template-columns: 100px 40px 1fr; gap: 1rem; align-items: flex-start; padding-bottom: 2rem; }
  .timeline-year { font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; color: var(--brand-accent); text-align: right; padding-top: 0.1rem; }
  .timeline-connector { display: flex; flex-direction: column; align-items: center; }
  .timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--brand-accent); flex-shrink: 0; margin-top: 0.2rem; }
  .timeline-connector::after { content: ''; display: block; width: 2px; background: var(--color-border); flex: 1; margin-top: 6px; min-height: 2rem; }
  .timeline-item:last-child .timeline-connector::after { display: none; }
  .timeline-content { color: var(--color-muted); line-height: 1.7; font-size: 0.95rem; padding-top: 0.05rem; }
  /* Certifications */
  .certs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .cert-card { display: flex; gap: 1rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.5rem; align-items: flex-start; }
  .cert-badge { width: 36px; height: 36px; border-radius: 50%; background: var(--brand-accent); color: var(--color-text); font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem; }
  .cert-label { font-size: 1rem; font-weight: 700; color: var(--color-light); margin: 0 0 0.35rem; }
  .cert-desc { font-size: 0.875rem; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.6; }
  @media (max-width: 640px) { .timeline-item { grid-template-columns: 70px 30px 1fr; } .timeline-year { font-size: 0.9rem; } }
</style>
