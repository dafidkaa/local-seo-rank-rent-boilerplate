---
/**
 * About page — premium, trust-building, ~1,500 words
 * Fully aligned with SEO/AEO/GEO requirements
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import FaqSection from "../../components/FaqSection.astro";
import FinalCta from "../../components/FinalCta.astro";
import ContentSection from "../../components/ContentSection.astro";
import { t } from "../../lib/routes";
import { siteConfig, allServices } from "../../site.config";
import { seo, localBusinessSchema, breadcrumbSchema, faqSchema, aboutPageSchema } from "../../lib/seo";

export async function getStaticPaths() {
  return siteConfig.locales.map(locale => ({
    params: { lang: locale.code },
    props: { locale: locale.code },
  }));
}

const { locale } = Astro.props;
const city = siteConfig.business.city;
const businessName = siteConfig.business.name;
const phone = siteConfig.business.phone;
const founded = siteConfig.business.foundedYear ?? "2012";
const primaryService = t(siteConfig.business.primaryService, locale);

const crumbs = [
  { name: "Home", url: `/${locale}/` },
  { name: "About Us", url: `/${locale}/about/` },
];

const faqsRaw = [
  { q: `How long has ${businessName} been serving ${city}?`, a: `${businessName} has been serving ${city} and the surrounding metro area since ${founded}. Over the years we have built a reputation for reliable, professional service and honest communication.` },
  { q: `Is ${businessName} licensed and insured?`, a: `Yes. ${businessName} is fully licensed, bonded, and insured for all work in ${city} and the surrounding area. Every member of our team meets the professional standards required for their trade.` },
  { q: `What areas does ${businessName} serve?`, a: `We serve ${city} and the surrounding metro area including ${siteConfig.locations.slice(0, 5).map(l => l.name).join(", ")}, and more. Contact us to confirm coverage for your specific address.` },
  { q: `What is your satisfaction guarantee?`, a: `We stand behind every job we complete. If you are not satisfied with our work, we will return to make it right at no additional cost. Your satisfaction is our priority.` },
  { q: `How do I get a quote from ${businessName}?`, a: `You can request a free, no-obligation estimate by filling out our online form, calling us at ${phone}, or sending us an email. We typically respond within the same business day.` },
];

const faqs = faqsRaw.map(f => ({ question: f.q, answer: f.a }));
const schemas = [
  localBusinessSchema(locale),
  breadcrumbSchema(crumbs),
  faqSchema(faqs),
  aboutPageSchema(locale),
].filter(Boolean);

const meta = seo({
  title: `About ${businessName} | ${primaryService} in ${city}`,
  description: `Learn about ${businessName} — ${city}'s trusted ${primaryService.toLowerCase()} professionals since ${founded}. Licensed, insured, and committed to your satisfaction.`,
  locale,
  path: `/${locale}/about/`,
  schema: schemas,
});
---
<BaseLayout seo={meta}>
  <!-- HERO -->
  <Hero
    title={`About ${businessName}`}
    text={`${city}'s trusted ${primaryService.toLowerCase()} professionals since ${founded}. Licensed, insured, and committed to your complete satisfaction.`}
    image={(siteConfig.brand as any).images?.about ?? 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80'}
    imageAlt={`${businessName} team — professional ${primaryService.toLowerCase()} in ${city}`}
    locale={locale as any}
    breadcrumbs={crumbs}
  />

  <!-- OUR STORY -->
  <ContentSection
    eyebrow={`Since ${founded}`}
    title={`Who We Are`}
    text={`${businessName} was founded in ${founded} with a simple mission: to provide ${city} homeowners and businesses with professional, reliable ${primaryService.toLowerCase()} services they could trust. Since then, we have grown into one of the most respected names in the ${city} metro area, completing thousands of jobs and earning the trust of our community.\n\nWe are a locally owned and operated company. We live and work in ${city}, and we take pride in serving our neighbours with the same care and professionalism we would want for our own homes and businesses. Every member of our team is fully licensed, bonded, and insured — and every job we complete is backed by our 100% satisfaction guarantee.\n\nOur growth has been built entirely on referrals and repeat customers. We do not rely on flashy advertising or empty promises. We rely on doing excellent work, communicating honestly, and treating every customer with respect.`}
    image={(siteConfig.brand as any).images?.team ?? 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80'}
    imageAlt={`${businessName} team in ${city}`}
  />

  <!-- COMPANY TIMELINE -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Our Journey</span>
        <h2 class="section-title">How We Grew in {city}</h2>
        <p class="section-lead">From a small local operation to one of {city}'s most trusted {primaryService.toLowerCase()} providers — here is our story.</p>
      </div>
      <div class="timeline">
        {[
          { year: founded, event: `${businessName} was founded in ${city} with a small team and a big commitment to quality and honest communication.` },
          { year: String(parseInt(founded) + 2), event: `Expanded service area to cover the full ${city} metro, adding more licensed technicians to meet growing demand.` },
          { year: String(parseInt(founded) + 4), event: `Reached 1,000 completed jobs milestone. Introduced same-day service guarantee across all service areas.` },
          { year: String(parseInt(founded) + 6), event: `Launched commercial services division, serving local businesses, property managers, and multi-unit developments.` },
          { year: "Today", event: `${siteConfig.stats?.jobsCompleted ?? "Thousands of"} jobs completed. ${siteConfig.stats?.averageRating ?? "5"}-star rated. Still locally owned, still committed to ${city}.` },
        ].map((item, i) => (
          <div class="timeline-item">
            <div class="timeline-year">{item.year}</div>
            <div class="timeline-connector"><div class="timeline-dot"></div></div>
            <div class="timeline-content">{item.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS & CREDENTIALS -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Credentials</span>
        <h2 class="section-title" style="color:var(--color-light)">Licensed, Certified &amp; Insured</h2>
        <p class="section-lead" style="color:rgba(255,255,255,0.75)">Every technician at {businessName} meets the professional standards required to work in {city} and the surrounding area.</p>
      </div>
      <div class="certs-grid">
        {[
          { label: "State Licensed", desc: `All technicians hold valid state licenses for ${primaryService.toLowerCase()} work in ${siteConfig.business.region}.` },
          { label: "Fully Insured", desc: "We carry full liability insurance and workers' compensation on every job — protecting you and your property." },
          { label: "Background Checked", desc: "Every team member passes a thorough background check before joining our crew. Your home is in safe hands." },
          { label: "Ongoing Training", desc: `We invest in continuous professional development to stay current with the latest ${primaryService.toLowerCase()} codes and best practices.` },
        ].map(cert => (
          <div class="cert-card">
            <div class="cert-badge">✓</div>
            <div>
              <h3 class="cert-label">{cert.label}</h3>
              <p class="cert-desc">{cert.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Our Values</span>
        <h2 class="section-title">What We Stand For</h2>
        <p class="section-lead">The principles that guide every job we complete in {city} and the surrounding area.</p>
      </div>
      <div class="values-grid">
        {[
          { icon: "shield", title: "Integrity", desc: `We are honest about what needs to be done, what it will cost, and how long it will take. No upselling, no hidden fees, no surprises.` },
          { icon: "clock", title: "Reliability", desc: `We show up on time, every time. When we say we will be there, we mean it. Your time is valuable and we respect that.` },
          { icon: "star", title: "Quality", desc: `We do not cut corners. Every job is completed to the highest professional standard, using quality materials and proven techniques.` },
          { icon: "users", title: "Community", desc: `We are a local business serving our own community. We care about ${city} and we are committed to making it a better place to live and work.` },
          { icon: "check", title: "Accountability", desc: `We stand behind our work. If something is not right, we come back and fix it. Our satisfaction guarantee is not just a slogan — it is a promise.` },
          { icon: "heart", title: "Respect", desc: `We treat every customer, every home, and every business with the same respect we would want for our own. Your property is in safe hands.` },
        ].map(v => (
          <div class="value-card">
            <div class="value-icon" aria-hidden="true">
              {v.icon === "shield" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {v.icon === "clock" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
              {v.icon === "star" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {v.icon === "users" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {v.icon === "check" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>}
              {v.icon === "heart" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
            </div>
            <div>
              <h3 class="value-title">{v.title}</h3>
              <p class="value-desc">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS / TRUST NUMBERS -->
  <section class="section section-dark">
    <div class="container">
      <div class="stats-row">
        {[
          { number: siteConfig.stats?.yearsInBusiness ?? `${new Date().getFullYear() - parseInt(founded)}+`, label: "Years in Business" },
          { number: siteConfig.stats?.jobsCompleted ?? "2,500+", label: "Jobs Completed" },
          { number: siteConfig.stats?.satisfactionRate ?? "99%", label: "Satisfaction Rate" },
          { number: siteConfig.stats?.citiesServed ?? `${siteConfig.locations.length}+`, label: "Cities Served" },
        ].map(stat => (
          <div class="stat-item">
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR TEAM / APPROACH -->
  <ContentSection
    eyebrow="Our Approach"
    title={`How We Work`}
    text={`Every job at ${businessName} follows the same professional process. We start with a thorough assessment to understand exactly what needs to be done. We provide a clear, written estimate before any work begins. Our team arrives on time, works efficiently, and cleans up after every job.\n\nWe communicate clearly throughout the process. If we discover anything unexpected, we let you know immediately and discuss your options before proceeding. We never start additional work without your approval.\n\nWhen the job is complete, we conduct a final walkthrough to make sure you are satisfied with the result. Our work is backed by a 100% satisfaction guarantee — if something is not right, we come back and fix it at no additional cost.\n\nThis approach has earned us the trust of thousands of ${city} homeowners and businesses, and it is the foundation of everything we do.`}
    image={(siteConfig as any).images?.process ?? "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=900&q=80"}
    imageAlt={`${businessName} professional work process in ${city}`}
    reversed={true}
  />

  <!-- SERVICE AREA -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Where We Work</span>
        <h2 class="section-title">Our Service Area</h2>
        <p class="section-lead">We serve {city} and the surrounding metro area. Here are some of the communities we regularly serve:</p>
      </div>
      <div class="area-grid">
        {siteConfig.locations.map(loc => (
          <a href={`/${locale}/${loc.id}/`} class="area-pill">{loc.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <ReviewsSection locale={locale as any} />

  <!-- FAQ -->
  <FaqSection faqs={faqsRaw.map(f => ({ q: f.q, a: f.a }))} locale={locale as any} />

  <!-- FINAL CTA -->
  <FinalCta locale={locale as any} />
</BaseLayout>

<style>
  .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .value-card { display: flex; gap: 1rem; padding: 1.5rem; background: white; border: 1px solid var(--color-border); border-radius: 12px; box-shadow: var(--shadow-card); }
  .value-icon { flex-shrink: 0; width: 44px; height: 44px; background: var(--color-accent); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--color-dark); }
  .value-title { font-size: 1rem; font-weight: 700; color: var(--color-dark); margin: 0 0 0.375rem; }
  .value-desc { font-size: 0.875rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; }
  .section-dark { background: var(--color-dark); }
  .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 2rem; text-align: center; }
  .stat-number { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: var(--color-accent); line-height: 1; }
  .stat-label { font-size: 0.875rem; color: rgba(255,255,255,0.7); margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .area-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .area-pill { padding: 0.5rem 1.25rem; background: white; border: 1px solid var(--color-border); border-radius: 100px; font-size: 0.875rem; font-weight: 500; color: var(--color-dark); text-decoration: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .area-pill:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-dark); }
  /* Timeline */
  .timeline { display: flex; flex-direction: column; gap: 0; margin-top: 3rem; position: relative; }
  .timeline-item { display: grid; grid-template-columns: 100px 40px 1fr; gap: 1rem; align-items: flex-start; padding-bottom: 2rem; }
  .timeline-year { font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; color: var(--brand-accent); text-align: right; padding-top: 0.1rem; }
  .timeline-connector { display: flex; flex-direction: column; align-items: center; }
  .timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--brand-accent); flex-shrink: 0; margin-top: 0.2rem; }
  .timeline-connector::after { content: ''; display: block; width: 2px; background: var(--color-border); flex: 1; margin-top: 6px; min-height: 2rem; }
  .timeline-item:last-child .timeline-connector::after { display: none; }
  .timeline-content { color: var(--color-muted); line-height: 1.7; font-size: 0.95rem; padding-top: 0.05rem; }
  /* Certifications */
  .certs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .cert-card { display: flex; gap: 1rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.5rem; align-items: flex-start; }
  .cert-badge { width: 36px; height: 36px; border-radius: 50%; background: var(--brand-accent); color: var(--color-dark); font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem; }
  .cert-label { font-size: 1rem; font-weight: 700; color: var(--color-light); margin: 0 0 0.35rem; }
  .cert-desc { font-size: 0.875rem; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.6; }
  @media (max-width: 640px) { .timeline-item { grid-template-columns: 70px 30px 1fr; } .timeline-year { font-size: 0.9rem; } }
</style>
