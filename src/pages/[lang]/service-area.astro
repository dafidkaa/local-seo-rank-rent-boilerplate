---
/**
 * Service Area Hub page
 * URL: /en/service-area/
 * Target: 800+ words of visible body copy
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import LocationCard from "@/components/LocationCard.astro";
import FinalCta from "@/components/FinalCta.astro";
import FaqSection from "@/components/FaqSection.astro";
import { siteConfig, type Locale } from "@/site.config";
import { locationPath, t } from "@/lib/routes";
import { localBusinessSchema, breadcrumbSchema, seo } from "@/lib/seo";

export function getStaticPaths() {
  return siteConfig.locales.map((locale) => ({ params: { lang: locale.code } }));
}

const locale = Astro.params.lang as Locale;
const isHr = locale === "hr";
const city = siteConfig.business.city;
const businessName = siteConfig.business.name;
const phone = siteConfig.business.phone;
const area = siteConfig.business.serviceArea;
const primaryService = t(siteConfig.business.primaryService, locale);
const stats = siteConfig.stats;

const crumbs = [
  { name: isHr ? "Početna" : "Home", url: `/${locale}/` },
  { name: isHr ? "Odredišta" : "Destinations", url: `/${locale}/service-area/` },
];

const faqs = isHr ? [
  { q: `Do kojih odredišta vozite?`, a: `Pokrivamo Split i središnju Dalmaciju, uključujući ${siteConfig.locations.map(l => l.name).join(", ")}. Javite nam svoju rutu i potvrdit ćemo je.` },
  { q: `Vozite li do trajektne luke i marina?`, a: `Da. Vozimo do trajektne luke Split za katamarane i trajekte te do marina i charter baza oko Splita i Trogira. Te su rute vremenski osjetljive pa transfer planiramo oko vašeg polaska.` },
  { q: `Vozite li i na veće udaljenosti?`, a: `Da. Uz kratke rute do Trogira i Kaštela vozimo i dulje transfere do Makarske, Šibenika, Krke i dalje. Navedite odredište pri upitu za fiksnu ponudu.` },
  { q: `Kako dobivam ponudu za svoje odredište?`, a: `Ispunite obrazac ili nazovite ${phone}. Navedite rutu, broj leta, broj putnika i prtljagu, a operater šalje fiksnu ponudu za potvrdu.` },
  { q: `Vozite li do vila i privatnog smještaja?`, a: `Da. Transfer ide od vrata do vrata do hotela, vila i privatnog smještaja. Navedite adresu ili naziv smještaja pri upitu, osobito za pješačke zone starog grada.` },
] : [
  { q: `Which destinations do you cover?`, a: `We cover Split and Central Dalmatia, including ${siteConfig.locations.map(l => l.name).join(", ")}. Tell us your route and we will confirm it.` },
  { q: `Do you drive to the ferry port and marinas?`, a: `Yes. We drive to Split Ferry Port for catamarans and ferries, and to the marinas and charter bases around Split and Trogir. These routes are time-sensitive, so we plan the transfer around your departure.` },
  { q: `Do you also do longer-distance transfers?`, a: `Yes. Alongside short routes to Trogir and Kaštela, we run longer transfers to Makarska, Šibenik, Krka and beyond. Share your destination when you inquire for a fixed quote.` },
  { q: `How do I get a quote for my destination?`, a: `Fill out the form or call ${phone}. Share your route, flight number, passenger count and luggage, and the operator sends back a fixed quote to confirm.` },
  { q: `Do you drive to villas and private accommodation?`, a: `Yes. The transfer is door-to-door to hotels, villas and private accommodation. Share the address or accommodation name when you inquire, especially for old-town pedestrian zones.` },
];

const pageSeo = seo({
  locale,
  path: "service-area",
  title: isHr ? `Odredišta transfera | ${businessName}` : `Transfer Destinations | ${businessName}`,
  description: isHr
    ? `${businessName} vozi privatne transfere iz Zračne luke Split po cijelom ${area}, uključujući ${city} i obližnja odredišta. Više od 60 odredišta, fiksne ponude.`
    : `${businessName} runs private transfers from Split Airport across ${area}, including ${city} and nearby destinations. Over 60 destinations, fixed quotes.`,
  schema: [
    localBusinessSchema(locale),
    breadcrumbSchema(crumbs),
  ],
});

const heroImage = (siteConfig.brand as any).images?.hero1 ?? "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1920&q=80";
---
<BaseLayout seo={pageSeo}>

  <!-- 1. HERO -->
  <Hero
    title={isHr ? "Odredišta transfera" : "Transfer Destinations"}
    text={isHr
      ? `${businessName} vozi privatne transfere iz Zračne luke Split po cijelom ${area}. Više od 60 odredišta, vozila na upit i fiksna ponuda unaprijed.`
      : `${businessName} runs private transfers from Split Airport across ${area}. Over 60 destinations, vehicles on request, and a fixed quote upfront.`}
    image={heroImage}
    imageAlt={isHr ? `Odredišta transfera — ${businessName}` : `Transfer destinations — ${businessName}`}
    locale={locale}
    breadcrumbs={crumbs}
  />

  <!-- 2. INTRO COPY -->
  <section class="section-light">
    <div class="container">
      <div class="sa-intro-grid">
        <div class="sa-intro-text">
          <p class="section-eyebrow">{isHr ? "Područje pokrivenosti" : "Coverage Area"}</p>
          <h2 class="section-heading">{isHr ? `Transferi po cijelom ${area}` : `Transfers Across ${area}`}</h2>
          <p class="section-lead">
            {isHr
              ? `${businessName} povezuje vaš let iz Zračne luke Split (SPU) s privatnim transferom do odredišta diljem ${area} — hotela, vila, apartmana, marina i trajektne luke.`
              : `${businessName} connects your flight from Split Airport (SPU) to a private transfer to destinations across ${area} — hotels, villas, apartments, marinas and the ferry port.`}
          </p>
          <p>
            {isHr
              ? `Bilo da idete u sam grad Split, na kratku rutu do Trogira i Kaštela ili dulje do Makarske i Šibenika, transfer ide izravno do vrata vašeg smještaja. Vozila — automobili, kombiji, minibusi i autobusi — dostupna su na upit, pa pravo vozilo odgovara vašoj grupi i prtljazi.`
              : `Whether you are heading to the city of Split, a short route to Trogir and Kaštela, or further to Makarska and Šibenik, the transfer goes straight to the door of your accommodation. Vehicles — cars, vans, minibuses and buses — are available on request, so the right vehicle matches your group and luggage.`}
          </p>
          <p>
            {isHr
              ? `Posebno smo korisni za goste vila, marina i charter baza te za putnike koji love trajekt ili katamaran iz trajektne luke Split. Te rute planiramo oko vašeg polaska kako bi veza bila bez stresa.`
              : `We are especially useful for villa, marina and charter-base guests, and for travellers catching a ferry or catamaran from Split Ferry Port. We plan those routes around your departure so the connection is stress-free.`}
          </p>
          <p>
            {isHr
              ? `Svaki transfer dolazi s jasnom fiksnom ponudom unaprijed — bez plaćanja unaprijed na ovoj stranici. Podijelite rutu i detalje leta, a operater predlaže pravo vozilo i potvrđuje cijenu.`
              : `Every transfer comes with a clear fixed quote upfront — no upfront payment on this site. Share your route and flight details, and the operator suggests the right vehicle and confirms the price.`}
          </p>
          <div class="sa-ctas">
            <button class="btn btn-primary" data-open-form-popup aria-haspopup="dialog">{isHr ? "Zatražite ponudu" : "Request a Quote"}</button>
            {phone && <a href={`tel:${phone}`} class="btn-secondary">{isHr ? "Nazovite" : "Call"} {phone}</a>}
          </div>
        </div>
        <div class="sa-stats-sidebar">
          <div class="sa-stat-card">
            <div class="sa-stat-number">{stats.destinationsServed}</div>
            <div class="sa-stat-label">{isHr ? "Odredišta" : "Destinations"}</div>
          </div>
          <div class="sa-stat-card">
            <div class="sa-stat-number">{isHr ? "Auto·Kombi·Bus" : "Cars·Vans·Buses"}</div>
            <div class="sa-stat-label">{isHr ? "Na upit" : "On Request"}</div>
          </div>
          <div class="sa-stat-card">
            <div class="sa-stat-number">EN·HR·DE</div>
            <div class="sa-stat-label">{isHr ? "3 jezika" : "3 Languages"}</div>
          </div>
          <div class="sa-stat-card">
            <div class="sa-stat-number">{isHr ? "Povratni" : "Return"}</div>
            <div class="sa-stat-label">{isHr ? "Dostupni" : "Available"}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. LOCATION CARDS GRID -->
  <section class="section-dark" id="locations">
    <div class="container">
      <p class="section-eyebrow" style="color:var(--brand-accent)">{isHr ? "Sva odredišta" : "All Destinations"}</p>
      <h2 class="section-heading" style="color:var(--color-light)">{isHr ? "Kamo vozimo" : "Where We Go"}</h2>
      <p class="section-subheading" style="color:rgba(255,255,255,0.75)">
        {isHr
          ? "Odaberite odredište i pogledajte rutu transfera iz Zračne luke Split, lokalne znamenitosti i savjete za dolazak."
          : "Pick a destination to see the transfer route from Split Airport, local landmarks and arrival tips."}
      </p>
      <div class="sa-locations-grid">
        {siteConfig.locations.map((location) => (
          <LocationCard
            title={location.name}
            href={locationPath(locale, location.id)}
            image={location.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. WHY LOCAL COVERAGE MATTERS -->
  <section class="section-light">
    <div class="container">
      <div class="sa-why-grid">
        <div>
          <p class="section-eyebrow">{isHr ? "Lokalno znanje" : "Local Knowledge"}</p>
          <h2 class="section-heading">{isHr ? "Zašto je poznavanje Dalmacije važno" : "Why Knowing Dalmatia Matters"}</h2>
          <p>
            {isHr
              ? `Privatni transfer s vozačem koji poznaje Split i okolicu znači glađe putovanje. Vozač zna gdje su pješačke zone starog grada, kako izbjeći ljetnu gužvu prema trajektnoj luci i koliko vremena treba do udaljenijih odredišta poput Makarske ili Šibenika.`
              : `A private transfer with a driver who knows Split and the surrounding area means a smoother journey. The driver knows where the old-town pedestrian zones are, how to avoid summer congestion near the ferry port, and how long it takes to reach further destinations like Makarska or Šibenik.`}
          </p>
          <p>
            {isHr
              ? `Pokrivamo cijeli niz odredišta — od grada Splita i njegova starog grada do Trogira, Čiova, Kaštela, Podstrane, Omiša i šire. Za svaku rutu transfer ide izravno do vrata vašeg smještaja, bez presjedanja s prtljagom.`
              : `We cover a full range of destinations — from the city of Split and its old town to Trogir, Čiovo, Kaštela, Podstrana, Omiš and beyond. For each route, the transfer goes straight to the door of your accommodation, with no changes with luggage.`}
          </p>
          <p>
            {isHr
              ? `Posade jahti, obitelji u vilama i gosti otoka cijene to lokalno znanje, osobito kada je riječ o usklađivanju s polaskom trajekta ili prijavom za charter. Podijelite detalje, a mi planiramo ostalo.`
              : `Yacht crews, families in villas and island-bound guests value that local knowledge, especially when timing matters around a ferry departure or charter check-in. Share the details, and we plan the rest.`}
          </p>
        </div>
        <div class="sa-coverage-features">
          {(isHr ? [
            { title: "Privatno, od vrata do vrata", desc: `Izravan transfer do hotela, vile, marine ili trajektne luke — bez dijeljenja vozila i bez presjedanja.` },
            { title: "Pravo vozilo za grupu", desc: `Automobili, kombiji, minibusi i autobusi na upit, s prostorom za prtljagu cijele grupe.` },
            { title: "Fiksna ponuda unaprijed", desc: `Cijena se potvrđuje prije puta — bez plaćanja unaprijed na ovoj stranici i bez skrivenih troškova.` },
            { title: "Trajekt, marine i povratak", desc: `Vremenski osjetljivi transferi do trajektne luke i marina te povratni transferi na upit.` },
          ] : [
            { title: "Private, Door-to-Door", desc: `A direct transfer to your hotel, villa, marina or the ferry port — no sharing the vehicle, no changes.` },
            { title: "The Right Vehicle for Your Group", desc: `Cars, vans, minibuses and buses on request, with room for the whole group's luggage.` },
            { title: "A Fixed Quote Upfront", desc: `The price is confirmed before you travel — no upfront payment on this site and no hidden charges.` },
            { title: "Ferry, Marinas & Return", desc: `Time-sensitive transfers to the ferry port and marinas, and return transfers on request.` },
          ]).map(f => (
            <div class="sa-feature">
              <span class="sa-feature-icon">✓</span>
              <div>
                <strong>{f.title}</strong>
                <p>{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <FaqSection
    title={isHr ? "Odredišta — često postavljana pitanja" : "Destinations — Frequently Asked Questions"}
    items={faqs}
    locale={locale}
  />

  <!-- 6. FINAL CTA -->
  <FinalCta
    locale={locale}
    title={isHr ? "Trebate transfer do svog odredišta?" : "Need a Transfer to Your Destination?"}
    text={isHr ? `Nazovite ${phone} ili zatražite fiksnu ponudu danas. Pokrivamo cijeli ${area}.` : `Call ${phone} or request a fixed quote today. We cover all of ${area}.`}
  />

</BaseLayout>

<style>
.sa-intro-grid { display: grid; grid-template-columns: 1fr 220px; gap: 3rem; align-items: start; }
.sa-intro-text p { color: var(--color-muted); line-height: 1.85; margin-bottom: 1.25rem; }
.sa-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
.sa-stats-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; position: sticky; top: 6rem; }
.sa-stat-card { background: var(--color-light); border: 1px solid var(--color-border); border-radius: 1rem; padding: 1.25rem 1rem; text-align: center; }
.sa-stat-number { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; color: var(--brand-accent); line-height: 1; }
.sa-stat-label { font-size: 0.75rem; color: var(--color-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
.sa-locations-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
.sa-why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.sa-why-grid > div > p { color: var(--color-muted); line-height: 1.85; margin-bottom: 1.25rem; }
.sa-coverage-features { display: flex; flex-direction: column; gap: 1.25rem; }
.sa-feature { display: flex; gap: 1rem; align-items: flex-start; padding: 1.25rem; background: white; border: 1px solid var(--color-border); border-radius: 0.75rem; box-shadow: var(--shadow-card); }
.sa-feature-icon { width: 28px; height: 28px; border-radius: 50%; background: var(--brand-accent); color: var(--color-dark); font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.85rem; }
.sa-feature strong { display: block; font-weight: 700; color: var(--color-dark); margin-bottom: 0.25rem; font-size: 0.95rem; }
.sa-feature p { color: var(--color-muted); font-size: 0.875rem; line-height: 1.6; margin: 0; }
@media (max-width: 1024px) { .sa-intro-grid { grid-template-columns: 1fr; } .sa-stats-sidebar { position: static; grid-template-columns: repeat(4, 1fr); } .sa-why-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
@media (max-width: 640px) { .sa-stats-sidebar { grid-template-columns: 1fr 1fr; } }
</style>
