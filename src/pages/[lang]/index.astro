        </p>
      </div>
      <div class="community-trust-stats">
        <div class="community-stat">
          <span class="community-stat-number">{siteConfig.stats?.jobsCompleted ?? "500+"}</span>
          <span class="community-stat-label">Jobs Completed in {area}</span>
        </div>
        <div class="community-stat">
          <span class="community-stat-number">{siteConfig.stats?.yearsInBusiness ?? "12"}+</span>
          <span class="community-stat-label">Years Serving {city}</span>
        </div>
        <div class="community-stat">
          <span class="community-stat-number">{siteConfig.stats?.averageRating ?? "4.9"}★</span>
          <span class="community-stat-label">Average Customer Rating</span>
        </div>
        <div class="community-stat">
          <span class="community-stat-number">100%</span>
          <span class="community-stat-label">Satisfaction Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       9. SERVICE AREA SECTION — LocationCard grid
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" id="service-area" aria-labelledby="area-heading">
    <div class="container">
      <p class="eyebrow">{ui("locations.eyebrow", locale)}</p>
      <h2 id="area-heading">{serviceName} Across {area}</h2>
      <p class="section-lead">
