---
/**
 * HOMEPAGE — 1,500-word content density, 12+ sections
 * Follows: PROMPT.md, DESIGN-home-services.md, pasted_content_2.txt, pasted_content_3.txt
 *
 * Sections:
 *  1. HeroSlider (full-height, 3 slides, popup CTA)
 *  2. Trust bar (stats)
 *  3. Problems section (pain points)
 *  4. Welcome / About split (image + copy)
 *  5. Services grid (ServiceCard)
 *  6. Why Choose Us (icon cards + stats)
 *  7. Process section (numbered steps)
 *  8. Image-rich split section (work in progress photo + copy)
 *  9. Service area section (LocationCard grid)
 * 10. Reviews section
 * 11. Blog preview (BlogCard)
 * 12. Final CTA + form
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSlider from "@/components/HeroSlider.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ProcessSection from "@/components/ProcessSection.astro";
import ReviewsSection from "@/components/ReviewsSection.astro";
import FinalCta from "@/components/FinalCta.astro";
import LocationCard from "@/components/LocationCard.astro";
import BlogCard from "@/components/BlogCard.astro";
import FaqSection from "@/components/FaqSection.astro";
import { allServices, siteConfig, type Locale } from "@/site.config";
import { getCollection } from "astro:content";
import { localizedPath, locationPath, servicePath, t } from "@/lib/routes";
import { websiteSchema, localBusinessSchema, seo } from "@/lib/seo";
import { ui } from "@/i18n";

export function getStaticPaths() {
  return siteConfig.locales.map((locale) => ({ params: { lang: locale.code } }));
}

const locale = Astro.params.lang as Locale;
const city        = siteConfig.business.city;
const serviceName = t(siteConfig.business.primaryService, locale);
const name        = siteConfig.business.name;
const phone       = siteConfig.business.phone;
const email       = siteConfig.business.email;
const area        = siteConfig.business.serviceArea;

const pageSeo = seo({
  locale,
  path: "",
  title: `${serviceName} to ${area} | ${name}`,
  description: `Private ${serviceName.toLowerCase()} from Split Airport (SPU) to Split, Trogir, Kaštela, Podstrana, Omiš, the ferry port, marinas, hotels and villas. Request a fixed quote for a car, van, minibus or bus.`,
  schema: [websiteSchema(locale), localBusinessSchema(locale)],
});

const allPosts = (await getCollection("blog")).filter((p) => !false).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const recentPosts = allPosts.slice(0, 3);

// Homepage FAQ — AEO-optimised direct answers
const homeFaqs = locale === "hr" ? [
  {
    q: `Kako rezerviram transfer iz Zračne luke Split?`,
    a: `Pošaljite upit s rutom, brojem leta, brojem putnika i prtljagom. Operater provjerava dostupnost i šalje fiksnu ponudu za potvrdu — bez plaćanja unaprijed na ovoj stranici.`
  },
  {
    q: `Koja vozila su dostupna?`,
    a: `Na upit su dostupni automobili, kombiji, minibusi i autobusi — za parove, obitelji te grupe od 8 ili više osoba, s prostorom za prtljagu. Navedite broj putnika i prtljagu da operater predloži pravo vozilo.`
  },
  {
    q: `Možete li osigurati dječje sjedalice?`,
    a: `Da, dječje i booster sjedalice mogu se osigurati na upit. Navedite broj i dob djece pri slanju upita.`
  },
  {
    q: `Do kojih odredišta vozite?`,
    a: `Pokrivamo Split, Trogir, Kaštela, Podstranu, Omiš, trajektnu luku Split, marine, hotele, vile i druga odredišta u Splitu i središnjoj Dalmaciji — više od 60 odredišta.`
  },
  {
    q: `Mogu li rezervirati i povratni transfer?`,
    a: `Da. Dolazni i povratni transfer možete zatražiti u jednom upitu, a operater će potvrditi vrijeme preuzimanja s dovoljnom rezervom za vaš odlazni let.`
  },
] : [
  {
    q: `How do I book a transfer from Split Airport?`,
    a: `Send a quote request with your route, flight number, passenger count and luggage. The operator checks availability and sends back a fixed quote to confirm — there is no upfront payment on this site.`
  },
  {
    q: `What vehicles are available?`,
    a: `Cars, vans, minibuses and buses are available on request — for couples, families and groups of 8 or more, with space for luggage. Tell us your passenger count and luggage so the operator can suggest the right vehicle.`
  },
  {
    q: `Can you provide child seats?`,
    a: `Yes, child and booster seats can be arranged on request. Just tell us the number and ages of children when you send your inquiry.`
  },
  {
    q: `Which destinations do you cover?`,
    a: `We cover Split, Trogir, Kaštela, Podstrana, Omiš, Split Ferry Port, the marinas, hotels, villas and other destinations across Split and Central Dalmatia — over 60 destinations in total.`
  },
  {
    q: `Can I book a return transfer too?`,
    a: `Yes. You can request both your arrival and return transfer in one inquiry, and the operator will confirm a pickup time that leaves enough margin for your departure flight.`
  },
];
---
<BaseLayout seo={pageSeo}>

  <!-- ═══════════════════════════════════════════════════════════════════════
       1. HERO SLIDER — full-height, 3 slides, popup CTA
  ═══════════════════════════════════════════════════════════════════════════ -->
  <HeroSlider
    locale={locale}
    slides={siteConfig.heroSlides ?? []}
    badges={[
      locale === "hr" ? "Privatni transferi od vrata do vrata" : "Private door-to-door transfers",
      locale === "hr" ? "Automobili, kombiji i autobusi na upit" : "Cars, vans & buses on request",
      locale === "hr" ? "Fiksna ponuda" : "Fixed quote",
    ]}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       2. TRUST BAR — social proof numbers below the fold
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="trust-bar-section" aria-label="Key statistics">
    <div class="container">
      <div class="trust-stat-grid">
        {[
          { value: siteConfig.stats?.destinationsServed ?? "60+",  label: locale === "hr" ? "Pokrivenih odredišta" : "Destinations Covered" },
          { value: locale === "hr" ? "Auto · Kombi · Bus" : "Cars · Vans · Buses", label: locale === "hr" ? "Na upit" : "On Request" },
          { value: "EN · HR · DE",                                 label: locale === "hr" ? "Stranice na 3 jezika" : "Pages in 3 Languages" },
          { value: locale === "hr" ? "Povratni" : "Return",        label: locale === "hr" ? "Transferi dostupni" : "Transfers Available" },
        ].map((stat) => (
          <div class="trust-stat-item">
            <span class="trust-stat-number">{stat.value}</span>
            <span class="trust-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       3. PROBLEMS SECTION — pain-point recognition
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" id="problems" aria-labelledby="problems-heading">
    <div class="container">
      <p class="eyebrow">{ui("problems.eyebrow", locale)}</p>
      <h2 id="problems-heading">{ui("problems.heading", locale).replace("{service}", serviceName).replace("{city}", city)}</h2>
      <p class="section-lead">{locale === "hr" ? "Prepoznajete li neku od ovih situacija?" : "Do any of these sound familiar?"}</p>
      <div class="problems-grid">
        {[
          ui("problems.p1", locale),
          ui("problems.p2", locale),
          ui("problems.p3", locale).replace("{city}", city),
          ui("problems.p4", locale).replace("{city}", city),
          ui("problems.p5", locale),
          ui("problems.p6", locale),
        ].map((problem) => (
          <div class="problem-card">
            <span class="problem-check" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <p>{problem}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       4. WELCOME / ABOUT SPLIT — image + copy, Est. badge
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" id="about" aria-labelledby="welcome-heading">
    <div class="container welcome-split">
      <div class="welcome-image-wrap">
        <img
          src={(siteConfig.brand as any).images?.team ?? 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80'}
          alt={`${name} team providing ${serviceName} in ${city}`}
          width="900" height="600"
          loading="lazy" decoding="async"
          class="welcome-img"
        />
        <div class="welcome-badge" aria-label="Split Airport transfers">
          <span class="welcome-badge-year">{locale === "hr" ? "Privatni" : "Private"}</span>
          <span class="welcome-badge-label">{locale === "hr" ? "Zračna luka Split (SPU)" : "Split Airport (SPU)"}</span>
        </div>
      </div>
      <div class="welcome-copy">
        <p class="eyebrow">{ui("welcome.eyebrow", locale)}</p>
        <h2 id="welcome-heading">{ui("welcome.heading", locale).replace("{name}", name)}</h2>
        <p class="welcome-lead">{locale === "hr" ? `${name} povezuje vaš let s odredištem u Splitu i središnjoj Dalmaciji privatnim transferom od vrata do vrata. Zatražite fiksnu ponudu za automobil, kombi, minibus ili autobus — udobno za parove, obitelji i grupe, s prostorom za prtljagu.` : `${name} connects your flight to your destination across Split and Central Dalmatia with a private, door-to-door transfer. Request a fixed quote for a car, van, minibus or bus — comfortable for couples, families and groups, with room for luggage.`}</p>
        <p>{locale === "hr" ? "Cilj nam je biti najkorisniji izvor za dolazak u Zračnu luku Split. Podijelite rutu, broj leta, broj putnika i prtljagu, a operater će potvrditi dostupnost i fiksnu ponudu prije puta — bez plaćanja unaprijed na ovoj stranici i bez iznenađenja." : "Our aim is to be the most useful Split Airport arrival resource. Share your route, flight number, passenger count and luggage, and the operator confirms availability and a fixed quote before you travel — no upfront payment on this site and no surprises."}</p>
        <ul class="welcome-list" role="list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {locale === "hr" ? "Privatni transferi od vrata do vrata do hotela, vila, marina i trajekta" : "Private door-to-door transfers to hotels, villas, marinas and the ferry port"}
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {locale === "hr" ? "Automobili, kombiji, minibusi i autobusi na upit" : "Cars, vans, minibuses and buses on request"}
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {locale === "hr" ? "Prilagođeno obiteljima i grupama — dječje sjedalice na upit" : "Family & group friendly — child seats on request"}
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {locale === "hr" ? "Povratni transferi i planiranje preuzimanja prema letu" : "Return transfers and flight-aware pickup planning"}
          </li>
        </ul>
        <div class="welcome-actions">
          <button class="btn btn-primary" data-open-form-popup aria-label={locale === "hr" ? "Zatražite ponudu" : "Request a quote"}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
            {locale === "hr" ? "Zatražite ponudu" : "Request a Quote"}
          </button>
          {phone && (
            <a href={`tel:${phone}`} class="btn btn-outline" aria-label={`Call ${name}`}>
              {locale === "hr" ? "Nazovite" : "Call"} {phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       4b. LOCAL EXPERTISE NARRATIVE — ~200 words of city-specific body copy
       (AEO: answers "why choose a local provider in [city]?")
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="local-heading">
    <div class="container local-narrative">
      <div class="local-narrative-text">
        <p class="eyebrow">{locale === "hr" ? "Lokalno poznavanje" : "Local Knowledge"}</p>
        <h2 id="local-heading">{locale === "hr" ? "Kome odgovara privatni transfer iz Zračne luke Split" : "Who a Private Split Airport Transfer Suits"}</h2>
        <p>
          {locale === "hr"
            ? `Privatni transfer ima najviše smisla kada se ne želite oslanjati na red autobusa nakon dugog leta. Odgovara parovima koji idu u hotel ili stan, obiteljima s djecom i prtljagom, te grupama od 8 ili više koje žele putovati zajedno u jednom vozilu. Idealan je i za goste vila, marina i charter baza te za one koji love trajekt ili katamaran iz trajektne luke Split.`
            : `A private transfer makes the most sense when you would rather not depend on a bus queue after a long flight. It suits couples heading to a hotel or apartment, families with children and luggage, and groups of 8 or more who want to travel together in one vehicle. It is also ideal for villa, marina and charter-base guests, and for anyone catching a ferry or catamaran from Split Ferry Port.`}
        </p>
        <p>
          {locale === "hr"
            ? `Vozila su dostupna na upit, od automobila za par do kombija, minibusa ili autobusa za veće grupe — s prostorom za kovčege, jedriličarsku prtljagu, kolica i opremu za plažu. Dječje i booster sjedalice mogu se osigurati na upit; samo navedite dob djece. Povratni transferi mogu se rezervirati u istom upitu, a vrijeme preuzimanja planira se s rezervom za vaš odlazni let.`
            : `Vehicles are available on request, from a car for a couple to a van, minibus or bus for larger groups — with space for suitcases, sailing bags, strollers and beach gear. Child and booster seats can be arranged on request; just share the ages of the children. Return transfers can be booked in the same inquiry, and pickup is planned with margin for your departure flight.`}
        </p>
        <p>
          {locale === "hr"
            ? `Velik dio starog grada Splita je pješačka zona, pa vozač ostavlja goste na najbližoj prikladnoj točki — javite naziv smještaja unaprijed. Za trajektnu luku i marine vrijeme je važno, pa transfer planiramo prema vašem polasku.`
            : `Much of Split's old town is a pedestrian zone, so the driver drops guests at the nearest suitable access point — share the accommodation name in advance. For the ferry port and marinas, timing matters, so the transfer is planned around your departure.`}
        </p>
      </div>
      <div class="local-narrative-features">
        {(locale === "hr" ? [
          { title: "Od vrata do vrata", body: "Privatni transfer izravno do hotela, vile, apartmana, marine ili trajektne luke — bez presjedanja s prtljagom." },
          { title: "Pravo vozilo za grupu", body: "Automobili, kombiji, minibusi i autobusi na upit, s prostorom za prtljagu cijele grupe." },
          { title: "Obitelji i grupe", body: "Dječje sjedalice na upit i mjesta za grupe od 8 ili više — javite broj putnika i dob djece pri upitu." },
          { title: "Preuzimanje prema letu", body: "Vrijeme preuzimanja planira se prema vašem letu i polasku trajekta; povratni transferi dostupni." },
        ] : [
          { title: "Door-to-Door", body: "A private transfer straight to your hotel, villa, apartment, marina or the ferry port — no changes with luggage." },
          { title: "The Right Vehicle for Your Group", body: "Cars, vans, minibuses and buses on request, with room for the whole group's luggage." },
          { title: "Family & Group Friendly", body: "Child seats on request and space for groups of 8 or more — share passenger numbers and children's ages when you inquire." },
          { title: "Flight-Aware Pickup", body: "Pickup is planned around your flight and ferry departure, and return transfers are available." },
        ]).map((feat) => (
          <div class="local-feature-item">
            <div class="local-feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <strong class="local-feature-title">{feat.title}</strong>
              <p class="local-feature-body">{feat.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       5. SERVICES GRID — ServiceCard components
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" id="services" aria-labelledby="services-heading">
    <div class="container">
      <p class="eyebrow">{ui("services.eyebrow", locale)}</p>
      <h2 id="services-heading">{locale === "hr" ? "Transferi iz Zračne luke Split" : "Split Airport Transfer Services"}</h2>
      <p class="section-lead">
        {locale === "hr"
          ? `Bilo da trebate ${allServices.slice(0,3).map((s) => t(s.title, locale)).join(", ")} ili pomoć pri odabiru pravog vozila, ${name} čini upit jednostavnim.`
          : `Whether you need ${allServices.slice(0,3).map((s) => t(s.title, locale)).join(", ")}, or help choosing the right vehicle, ${name} makes requesting a quote simple.`}
      </p>
      <div class="grid grid-3" style="margin-top:clamp(32px,5vw,48px)">
        {allServices.map((service) => (
          <ServiceCard
              locale={locale}
            title={t(service.title, locale)}
            description={t(service.short, locale)}
            image={service.image}
            href={servicePath(locale, service)}
            alt={`${t(service.title, locale)} in ${city}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       6. WHY CHOOSE US — icon cards on dark background + stats row
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-charcoal" id="why" aria-labelledby="why-heading">
    <div class="container">
      <p class="eyebrow" style="color:var(--brand-accent)">{locale === "hr" ? "Zašto odabrati nas" : "Why Travel With Us"}</p>
      <h2 id="why-heading" style="color:#fff">{locale === "hr" ? "Jednostavan, privatan dolazak u Split" : "A Simple, Private Arrival in Split"}</h2>
      <p class="section-lead" style="color:rgba(255,255,255,.7)">{locale === "hr" ? "Privatni transferi planirani oko vašeg leta, grupe i odredišta." : "Private transfers planned around your flight, your group and your destination."}</p>
      <div class="why-grid">
        {(locale === "hr" ? [
          { icon: "shield", title: "Od vrata do vrata", text: "Privatni transfer izravno do hotela, vile, marine ili trajektne luke — bez dijeljenja vozila s nepoznatima." },
          { icon: "map",    title: "Vozila za svaku grupu", text: "Automobili, kombiji, minibusi i autobusi na upit, s prostorom za prtljagu cijele grupe." },
          { icon: "dollar", title: "Fiksna ponuda unaprijed", text: "Operater potvrđuje dostupnost i jasnu fiksnu cijenu prije puta — bez plaćanja unaprijed na ovoj stranici." },
          { icon: "star",   title: "Obitelji i grupe", text: "Dječje sjedalice na upit i mjesta za grupe od 8 ili više osoba — javite detalje pri upitu." },
          { icon: "clock",  title: "Preuzimanje prema letu", text: "Vrijeme preuzimanja usklađeno s dolaskom leta i polaskom trajekta; povratni transferi dostupni." },
          { icon: "phone",  title: "Trajektna luka i marine", text: "Vremenski osjetljivi transferi do trajektne luke Split i marina oko Splita i Trogira." },
        ] : [
          { icon: "shield", title: "Door-to-Door", text: "A private transfer straight to your hotel, villa, marina or the ferry port — no sharing the vehicle with strangers." },
          { icon: "map",    title: "Vehicles for Every Group", text: "Cars, vans, minibuses and buses on request, with room for the whole group's luggage." },
          { icon: "dollar", title: "A Fixed Quote Upfront", text: "The operator confirms availability and a clear fixed price before you travel — no upfront payment on this site." },
          { icon: "star",   title: "Family & Group Friendly", text: "Child seats on request and space for groups of 8 or more — just share the details when you inquire." },
          { icon: "clock",  title: "Flight-Aware Pickup", text: "Pickup is timed around your flight arrival and ferry departure, and return transfers are available." },
          { icon: "phone",  title: "Ferry Port & Marinas", text: "Time-sensitive transfers to Split Ferry Port and the marinas around Split and Trogir." },
        ]).map((card) => (
          <div class="why-card">
            <div class="why-icon" aria-hidden="true">
              {card.icon === "clock" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
              {card.icon === "shield" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {card.icon === "dollar" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>}
              {card.icon === "star" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {card.icon === "map" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>}
