---
/**
 * [post].astro — Blog post template
 * - Featured image as full-width hero background with overlay
 * - Breadcrumbs inside the hero bottom bar
 * - Two-column layout: main content + sticky sidebar
 * - Sidebar: TOC, CTA widget, related services, recent posts
 * - Prev/Next navigation inside the article
 * - Reading progress bar, share buttons
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import FinalCta from "@/components/FinalCta.astro";
import { allServices, siteConfig, type Locale } from "@/site.config";
import { localizedPath, t, blogPostPath, servicePath, dateLocale } from "@/lib/routes";
import { articleSchema, breadcrumbSchema, seo } from "@/lib/seo";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return siteConfig.locales.flatMap((locale) =>
    posts.map((post) => ({
      params: { lang: locale.code, post: post.slug },
      props: { post }
    }))
  );
}

const { post } = Astro.props;
const locale = Astro.params.lang as Locale;
const { Content } = await post.render();
const bodyText = post.body ?? "";
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = await getCollection("blog");
const sortedPosts = [...allPosts].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const fallbackRelated = relatedPosts.length >= 3
  ? relatedPosts
  : [
      ...relatedPosts,
      ...allPosts
        .filter((p) => p.id !== post.id && p.data.category !== post.data.category)
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
        .slice(0, 3 - relatedPosts.length)
    ];

const relatedServices = (post.data.relatedServices ?? [])
  .map((id: string) => {
    const svc = allServices.find((s) => s.id === id);
    return svc ? { id: svc.id, title: t(svc.title, locale), href: servicePath(locale, svc) } : null;
  })
  .filter(Boolean);

// Sidebar services: use post's relatedServices or fall back to first 4 services
const sidebarServices = relatedServices.length > 0
  ? relatedServices
  : allServices.slice(0, 4).map((s) => ({ id: s.id, title: t(s.title, locale), href: servicePath(locale, s) }));

const postUrl = `${siteConfig.siteUrl}${blogPostPath(locale, post.slug)}`;
const pageSeo = seo({
  locale,
  path: `blog/${post.slug}`,
  title: `${t(post.data.title, locale)} | ${siteConfig.business.name}`,
  description: t(post.data.excerpt, locale),
  image: post.data.image,
  ogType: "article",
  article: {
    publishedTime: post.data.date,
    modifiedTime: post.data.updatedAt ?? post.data.date,
    author: post.data.author
  },
  schema: [
    articleSchema({
      headline: t(post.data.title, locale),
      description: t(post.data.excerpt, locale),
      url: postUrl,
      image: post.data.image,
      datePublished: post.data.date,
      dateModified: post.data.updatedAt ?? post.data.date,
      wordCount,
      articleBody: bodyText.slice(0, 5000)
    }),
    breadcrumbSchema([
      { name: "Home", url: localizedPath(locale) },
      { name: "Blog", url: localizedPath(locale, "blog") },
      { name: t(post.data.title, locale), url: blogPostPath(locale, post.slug) }
    ])
  ]
});

const author = post.data.author;
const updatedAt = post.data.updatedAt;
const tags = post.data.tags ?? [];
const phone = siteConfig.business.phone;
const businessName = siteConfig.business.name;
const primaryService = t(siteConfig.business.primaryService, locale);
const city = siteConfig.business.city;
---
<BaseLayout seo={pageSeo}>
  <ReadingProgress />

  <!-- HERO: featured image as full-width background -->
  <section class="post-hero" aria-label={t(post.data.title, locale)}>
    <img
      src={post.data.image}
      alt={t(post.data.title, locale)}
      class="post-hero-bg"
      width="1920"
      height="600"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="post-hero-overlay" aria-hidden="true"></div>
    <div class="post-hero-body">
      <div class="container post-hero-content">
        <nav class="post-hero-breadcrumbs" aria-label="Breadcrumb">
          <ol class="post-hero-crumb-list">
            <li>
              <a href={`/${locale}/`} class="post-hero-crumb-link">Home</a>
              <span class="post-hero-crumb-sep" aria-hidden="true">›</span>
            </li>
            <li>
              <a href={localizedPath(locale, "blog")} class="post-hero-crumb-link">Blog</a>
              <span class="post-hero-crumb-sep" aria-hidden="true">›</span>
            </li>
            <li>
              <span aria-current="page" class="post-hero-crumb-current">{t(post.data.title, locale)}</span>
            </li>
          </ol>
        </nav>
        {post.data.category && (
          <span class="post-hero-category">{post.data.category}</span>
        )}
        <h1 class="post-hero-title">{t(post.data.title, locale)}</h1>
        <p class="post-hero-excerpt">{t(post.data.excerpt, locale)}</p>
        <div class="post-hero-meta">
          <time datetime={post.data.date} class="post-hero-date">
            {new Date(post.data.date).toLocaleDateString(dateLocale(locale), { year: "numeric", month: "long", day: "numeric" })}
          </time>
          <span class="post-hero-sep" aria-hidden="true">·</span>
          <span class="post-hero-reading">{readingTime} min read · {wordCount} words</span>
          {author && (
            <>
              <span class="post-hero-sep" aria-hidden="true">·</span>
              <span class="post-hero-author">By {author}</span>
            </>
          )}
        </div>
        <ShareButtons url={postUrl} title={t(post.data.title, locale)} />
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT + SIDEBAR -->
  <section class="section post-section">
    <div class="container post-layout">

      <!-- Main article -->
      <article class="post-main prose" id="post-content">
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag: string) => <span class="post-tag">{tag}</span>)}
          </div>
        )}

        <Content />

        {updatedAt && (
          <p class="post-updated">
            <em>Last updated: <time datetime={updatedAt}>{new Date(updatedAt).toLocaleDateString(dateLocale(locale), { year: "numeric", month: "long", day: "numeric" })}</time></em>
          </p>
        )}

        <div class="post-share-bottom">
          <p class="post-share-label">Found this helpful? Share it:</p>
          <ShareButtons url={postUrl} title={t(post.data.title, locale)} />
        </div>

        {(prevPost || nextPost) && (
          <nav class="post-prevnext" aria-label="Post navigation">
            <div class="post-prevnext-inner">
              {prevPost ? (
                <a href={blogPostPath(locale, prevPost.slug)} class="post-prevnext-card post-prevnext-prev">
                  <span class="post-prevnext-dir">← Previous</span>
                  <span class="post-prevnext-title">{t(prevPost.data.title, locale)}</span>
                </a>
              ) : <div />}
              {nextPost ? (
                <a href={blogPostPath(locale, nextPost.slug)} class="post-prevnext-card post-prevnext-next">
                  <span class="post-prevnext-dir">Next →</span>
                  <span class="post-prevnext-title">{t(nextPost.data.title, locale)}</span>
                </a>
              ) : <div />}
            </div>
          </nav>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="post-sidebar" aria-label="Article sidebar">

        <!-- Table of Contents (populated by JS) -->
        <div class="sidebar-widget sidebar-toc" id="sidebar-toc" style="display:none">
          <h3 class="sidebar-widget-title">Table of Contents</h3>
          <ol class="sidebar-toc-list" id="sidebar-toc-list"></ol>
        </div>

        <!-- CTA Widget -->
        <div class="sidebar-widget sidebar-cta">
          <p class="sidebar-cta-eyebrow">Free Estimate</p>
          <h3 class="sidebar-cta-title">Need {primaryService} in {city}?</h3>
          <p class="sidebar-cta-text">Get a free, no-obligation estimate from {businessName}. Same-day service available.</p>
          <button
            class="btn btn-primary sidebar-cta-btn"
            data-open-form-popup
            aria-haspopup="dialog"
          >
            Request a Free Estimate
          </button>
          {phone && (
            <a href={`tel:${phone}`} class="sidebar-cta-phone">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
              {phone}
            </a>
          )}
        </div>

        <!-- Related Services -->
        {sidebarServices.length > 0 && (
          <div class="sidebar-widget sidebar-services">
            <h3 class="sidebar-widget-title">Our Services</h3>
            <ul class="sidebar-services-list">
              {sidebarServices.map((svc: any) => (
                <li>
                  <a href={svc.href} class="sidebar-service-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    {svc.title}
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/${locale}/#services`} class="sidebar-services-all">View all services →</a>
          </div>
        )}

        <!-- Recent Posts -->
        {fallbackRelated.length > 0 && (
          <div class="sidebar-widget sidebar-recent">
            <h3 class="sidebar-widget-title">More Articles</h3>
            <ul class="sidebar-recent-list">
              {fallbackRelated.slice(0, 3).map((p) => (
                <li class="sidebar-recent-item">
                  <a href={blogPostPath(locale, p.slug)} class="sidebar-recent-link">
                    <img
                      src={p.data.image}
                      alt={t(p.data.title, locale)}
                      class="sidebar-recent-img"
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="sidebar-recent-body">
                      <span class="sidebar-recent-title">{t(p.data.title, locale)}</span>
                      <time class="sidebar-recent-date" datetime={p.data.date}>
                        {new Date(p.data.date).toLocaleDateString(dateLocale(locale), { month: "short", day: "numeric", year: "numeric" })}
                      </time>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </aside>
    </div>
  </section>

  <!-- RELATED POSTS -->
  <RelatedPosts posts={fallbackRelated} locale={locale} />

  <!-- FINAL CTA -->
  <FinalCta
    locale={locale}
    title={`Ready to schedule ${primaryService}?`}
    text={`Request a free estimate in ${city} and nearby areas.`}
  />
</BaseLayout>

<script is:inline>
(function() {
  // Table of Contents
  var article = document.getElementById("post-content");
  var tocWidget = document.getElementById("sidebar-toc");
  var tocList = document.getElementById("sidebar-toc-list");
  if (article && tocWidget && tocList) {
    var headings = article.querySelectorAll("h2, h3");
    if (headings.length >= 2) {
      headings.forEach(function(h, i) {
        var id = "heading-" + i;
        h.id = id;
        var li = document.createElement("li");
        li.className = h.tagName === "H3" ? "toc-h3" : "toc-h2";
        var a = document.createElement("a");
        a.href = "#" + id;
        a.textContent = h.textContent;
        li.appendChild(a);
        tocList.appendChild(li);
      });
      tocWidget.style.display = "block";
    }
  }
  // Active TOC item on scroll
  if (tocList && tocList.children.length > 0) {
    var tocLinks = Array.from(tocList.querySelectorAll("a"));
    var headingEls = tocLinks.map(function(a) { return document.querySelector(a.getAttribute("href")); }).filter(Boolean);
    function updateActiveToc() {
      var scrollY = window.scrollY + 120;
      var active = headingEls.reduce(function(acc, el) {
        return el.offsetTop <= scrollY ? el : acc;
      }, headingEls[0]);
      tocLinks.forEach(function(a) { a.classList.remove("is-active"); });
      if (active) {
        var activeLink = tocList.querySelector('a[href="#' + active.id + '"]');
        if (activeLink) activeLink.classList.add("is-active");
      }
    }
    window.addEventListener("scroll", updateActiveToc, { passive: true });
    updateActiveToc();
  }
})();
</script>

<style>
  /* Post Hero */
  .post-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #0a0f1e;
    min-height: clamp(280px, 45vh, 520px);
  }
  .post-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .post-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8,14,35,.82) 45%, rgba(8,14,35,.5) 100%),
      linear-gradient(to top, rgba(0,0,0,.65) 0%, transparent 50%);
    z-index: -1;
  }
  .post-hero-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    position: relative;
    z-index: 1;
  }
  .post-hero-content { padding-block: clamp(28px, 4vw, 52px); }
  .post-hero-category {
    display: inline-block;
    background: var(--brand-accent);
    color: var(--brand-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .post-hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    max-width: 760px;
    text-wrap: balance;
  }
  .post-hero-excerpt {
    font-size: clamp(0.9rem, 1.3vw, 1.0625rem);
    color: rgba(255,255,255,.78);
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: 620px;
  }
  .post-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.8125rem;
    color: rgba(255,255,255,.6);
    margin-bottom: 16px;
  }
  .post-hero-sep { color: rgba(255,255,255,.3); }
  .post-hero-breadcrumbs { margin: 0 0 14px; }
  .post-hero-crumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }
  .post-hero-crumb-list li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .post-hero-crumb-link { color: rgba(255,255,255,.6); text-decoration: none; transition: color 0.15s; }
  .post-hero-crumb-link:hover { color: white; }
  .post-hero-crumb-current { color: rgba(255,255,255,.92); font-weight: 600; }
  .post-hero-crumb-sep { color: rgba(255,255,255,.32); }

  /* Layout */
  .post-section { padding-top: 3rem; }
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }
  .post-main { min-width: 0; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1.5rem; }
  .post-tag {
    display: inline-block;
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text-muted, #64748b);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .post-updated {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #64748b);
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }
  .post-share-bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }
  .post-share-label {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  /* Prev/Next */
  .post-prevnext {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }
  .post-prevnext-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .post-prevnext-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 1rem 1.25rem;
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .post-prevnext-card:hover { border-color: var(--brand-accent); background: white; }
  .post-prevnext-next { text-align: right; }
  .post-prevnext-dir {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .post-prevnext-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-dark, #0f172a);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Sidebar */
  .post-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-widget {
    background: white;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
  }
  .sidebar-widget-title {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-dark, #0f172a);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--brand-accent);
  }
  /* TOC */
  .sidebar-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.8125rem;
  }
  .sidebar-toc-list a {
    color: var(--color-text-muted, #64748b);
    text-decoration: none;
    display: block;
    padding: 3px 0 3px 8px;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1.4;
  }
  .sidebar-toc-list a:hover, .sidebar-toc-list a.is-active { color: var(--brand-primary); border-left-color: var(--brand-accent); }
  .toc-h3 a { padding-left: 20px; }
  /* CTA Widget */
  .sidebar-cta { background: var(--brand-primary); border-color: var(--brand-primary); }
  .sidebar-cta-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin: 0 0 6px;
  }
  .sidebar-cta-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    color: white;
    margin: 0 0 8px;
    line-height: 1.25;
  }
  .sidebar-cta-text { font-size: 0.8125rem; color: rgba(255,255,255,.75); line-height: 1.6; margin: 0 0 1rem; }
  .sidebar-cta-btn { width: 100%; justify-content: center; font-size: 0.875rem; }
  .sidebar-cta-phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255,255,255,.8);
    text-decoration: none;
    transition: color 0.15s;
  }
  .sidebar-cta-phone:hover { color: var(--brand-accent); }
  /* Services */
  .sidebar-services-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .sidebar-service-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--color-text-muted, #64748b);
    text-decoration: none;
    padding: 5px 0;
    transition: color 0.15s;
  }
  .sidebar-service-link svg { color: var(--brand-accent); flex-shrink: 0; }
  .sidebar-service-link:hover { color: var(--brand-primary); }
  .sidebar-services-all { display: block; margin-top: 10px; font-size: 0.8rem; font-weight: 600; color: var(--brand-accent); text-decoration: none; }
  .sidebar-services-all:hover { text-decoration: underline; }
  /* Recent Posts */
  .sidebar-recent-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .sidebar-recent-link { display: flex; gap: 10px; text-decoration: none; align-items: flex-start; }
  .sidebar-recent-img { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .sidebar-recent-body { display: flex; flex-direction: column; gap: 4px; }
  .sidebar-recent-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-dark, #0f172a);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }
  .sidebar-recent-link:hover .sidebar-recent-title { color: var(--brand-accent); }
