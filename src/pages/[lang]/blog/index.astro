---
/**
 * Blog hub — page 1 (/en/blog/)
 * Pages 2+ are statically generated at /en/blog/page/2/ etc.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogHub from "@/components/BlogHub.astro";
import { siteConfig, type Locale } from "@/site.config";
import { t } from "@/lib/routes";
import { seo } from "@/lib/seo";
import { getCollection } from "astro:content";

export const POSTS_PER_PAGE = 9;

export async function getStaticPaths() {
  return siteConfig.locales.map((locale) => ({ params: { lang: locale.code } }));
}

const locale = Astro.params.lang as Locale;
const allPosts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const [featured, ...rest] = allPosts;
const totalPages = Math.max(1, Math.ceil(rest.length / POSTS_PER_PAGE));
const pagePosts = rest.slice(0, POSTS_PER_PAGE);

const pageSeo = seo({
  locale,
  path: "blog",
  title: `${siteConfig.business.name} Blog | ${t(siteConfig.business.primaryService, locale)} Tips In ${siteConfig.business.city}`,
  description: `Tips, guides, and updates about ${t(siteConfig.business.primaryService, locale)}, local service advice, and helpful information for customers in ${siteConfig.business.serviceArea}.`
});
---
<BaseLayout seo={pageSeo}>
  <BlogHub
    locale={locale}
    pagePosts={pagePosts}
    featured={featured}
    allPosts={allPosts}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>
