---
/**
 * Legal pages — disclaimer.
 * Privacy policy and terms have their own standalone routes
 * (privacy-policy.astro / terms-and-conditions.astro).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/Hero.astro";
import { siteConfig } from "../../../site.config";
import { seo, breadcrumbSchema } from "../../../lib/seo";

export async function getStaticPaths() {
  const pages = [
    {
      slug: "disclaimer",
      title: "Disclaimer",
      heading: "Disclaimer",
      subtext: "Important information about the limitations of our website content.",
    },
  ];
  const paths = [];
  for (const locale of siteConfig.locales) {
    for (const page of pages) {
      paths.push({ params: { lang: locale.code, page: page.slug }, props: { locale: locale.code, page } });
    }
  }
  return paths;
}

const { locale, page } = Astro.props;
const businessName = siteConfig.business.name;
const city = siteConfig.business.city;
const email = siteConfig.business.email;

const crumbs = [
  { name: "Home", url: `/${locale}/` },
  { name: page.title, url: `/${locale}/legal/${page.slug}/` },
];

const meta = seo({
  title: `${page.title} | ${businessName}`,
  description: `${page.title} for ${businessName} — ${city}. ${page.subtext}`,
  locale,
  path: `/${locale}/legal/${page.slug}/`,
  schema: [breadcrumbSchema(crumbs)],
  noindex: false,
});
---
<BaseLayout seo={meta}>
  <Hero
    title={page.heading}
    text={page.subtext}
    image={(siteConfig as any).images?.hero ?? "https://images.unsplash.com/photo-1486325212027-8081e485255e?auto=format&fit=crop&w=1920&q=80"}
    imageAlt={`${page.title} — ${businessName}`}
    locale={locale}
    breadcrumbs={crumbs}
  />

  <section class="section section-white" style="padding-block: 3rem 5rem;">
    <div class="container">
      <div class="legal-content">
        <>
            <p class="legal-updated">Last updated: {new Date().toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</p>
            <h2>Website Disclaimer</h2>
            <p>The information provided on this website is for general informational purposes only. While we strive to keep the information accurate and up to date, we make no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, or suitability of the information.</p>
            <h2>Professional Advice</h2>
            <p>The content on this website does not constitute professional advice. For specific advice about your situation, please contact us directly to discuss your needs with a qualified professional.</p>
            <h2>External Links</h2>
            <p>This website may contain links to external websites. We have no control over the content of those sites and accept no responsibility for them or for any loss or damage that may arise from your use of them.</p>
            <h2>Contact</h2>
            <p>For any questions about this disclaimer, please contact us at <a href={`mailto:${email}`}>{email}</a>.</p>
        </>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Legal content wrapper */
  .legal-content {
    max-width: 760px;
    margin: 0 auto;
    padding-bottom: 2rem;
  }
  /* "Last updated" meta line */
  .legal-updated {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    margin: 0 0 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }
  /* Section headings */
  .legal-content h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-dark, #0f172a);
    margin: 3rem 0 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
    line-height: 1.3;
  }
  .legal-content h2:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  /* Sub-headings */
  .legal-content h3 {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-dark, #0f172a);
    margin: 2rem 0 0.75rem;
    line-height: 1.4;
  }
  /* Body text */
  .legal-content p {
    color: var(--color-text-muted, #64748b);
    line-height: 1.85;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }
  /* Links */
  .legal-content a {
    color: var(--color-accent, #d97706);
    text-decoration: none;
    font-weight: 500;
  }
  .legal-content a:hover { text-decoration: underline; }
  /* Lists */
  .legal-content ul,
  .legal-content ol {
    color: var(--color-text-muted, #64748b);
    line-height: 1.85;
    margin: 0.5rem 0 1.5rem 1.75rem;
    font-size: 0.9375rem;
  }
  .legal-content li {
    margin-bottom: 0.625rem;
  }
  /* Responsive */
  @media (max-width: 640px) {
    .legal-content h2 { font-size: 1.125rem; margin-top: 2.5rem; }
  }
</style>
