---
/**
 * [slug].astro — Service Page Template
 * ======================================
 * Generates one page per top-level service (e.g. /en/drain-cleaning/)
 * Target: 1,200–1,500 words of structured, SEO-rich content
 *
 * SEO Strategy:
 *   H1: [Service] in [City]                          ← primary keyword
 *   H2: What is [Service]? / Why Choose Us / etc.    ← secondary keywords
 *   H3: Sub-service names, benefit titles, FAQ items ← long-tail keywords
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import FaqSection from "../../components/FaqSection.astro";
import FinalCta from "../../components/FinalCta.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { siteConfig, allServices } from "../../site.config";
import { t, servicePath, subservicePath, locationPath, serviceSlug, localePathsFor } from "../../lib/routes";
import { seo, serviceSchema, breadcrumbSchema } from "../../lib/seo";
import { blocks, ui } from "../../i18n";
import ShortAnswer from "../../components/ShortAnswer.astro";
import ProsCons from "../../components/ProsCons.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import StatsBar from "../../components/StatsBar.astro";
import Gallery from "../../components/Gallery.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const paths: { params: { lang: string; slug: string }; props: any }[] = [];
  for (const locale of siteConfig.locales) {
    for (const service of allServices) {
      paths.push({
        params: { lang: locale.code, slug: serviceSlug(locale.code, service) },
        props: { locale: locale.code, service },
      });
    }
  }
  return paths;
}

const { locale, service } = Astro.props;

const businessName = siteConfig.business.name;
const city         = siteConfig.business.city;
const area         = siteConfig.business.serviceArea;
const phone        = siteConfig.business.phone;
const email        = siteConfig.business.email;
const founded      = siteConfig.business.foundedYear;
const primaryService = t(siteConfig.business.primaryService, locale);

const serviceName      = t(service.title, locale);
const serviceNameLower = serviceName.toLowerCase();
const serviceShort     = t(service.short, locale);
const children         = service.children ?? [];

// All body copy comes from the locale files (blocks.servicePage.*) so a new
// niche or language never requires edits to this template.
const vars = { business: businessName, service: serviceName, serviceLower: serviceNameLower, city, area, founded, phone, short: serviceShort };
const B = (key: string) => blocks(`blocks.servicePage.${key}`, locale, vars);
type Item = { icon?: string; title: string; desc: string };
const signItems: Item[] = B("signs.items");
const prosConsData: { title: string; lead: string; prosTitle: string; consTitle: string; pros: string[]; cons: string[] } = B("prosCons");
const comparisonData: { title: string; lead: string; columns: string[]; rows: string[][] } = B("comparison");
const statsBarItems = [
  { value: siteConfig.stats.yearsInBusiness, label: ui("blocks.statsBar.years", locale) },
  { value: siteConfig.stats.jobsCompleted,   label: ui("blocks.statsBar.jobs", locale) },
  { value: siteConfig.stats.averageRating,   label: ui("blocks.statsBar.rating", locale) },
  { value: siteConfig.stats.satisfactionRate, label: ui("blocks.statsBar.satisfaction", locale) },
];
const whyItems: Item[] = B("why.items");
const problemItems: Item[] = B("problems.items");

// Breadcrumbs
const crumbs = [
  { name: "Home",     url: `/${locale}/` },
  { name: "Services", url: `/${locale}/#services` },
  { name: serviceName, url: servicePath(locale, service) },
];

// FAQs — keyword-rich Q&As from the locale content blocks
const faqs: Array<{ q: string; a: string }> = B("faqs");

// Schema
// FAQPage and HowTo schema are emitted by FaqSection / ProcessSection from
// their visible items, so structured data always matches on-page content.
const schemas = [
  serviceSchema(locale, serviceName, servicePath(locale, service)),
  breadcrumbSchema(crumbs),
];

const meta = seo({
  title:       `${serviceName} in ${city} | ${businessName}`,
  description: `Need ${serviceNameLower} in ${city}? ${businessName} provides professional, licensed ${serviceNameLower} with free estimates and same-day service. Call now.`,
  locale,
  path:        servicePath(locale, service),
  localePaths: localePathsFor((l) => servicePath(l, service)),
  schema:      schemas,
});

// Related services (exclude current)
const relatedServices = allServices.filter((s: any) => s.id !== service.id).slice(0, 3);

// Image helpers
const heroImage  = service.image ?? "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1920&q=80";
const teamImg    = (siteConfig.brand as any).images?.team  ?? "https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=900&q=80";
const aboutImg   = (siteConfig.brand as any).images?.about ?? "https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=900&q=80";
---

<BaseLayout seo={meta}>

  <!-- ═══════════════════════════════════════════════════════════════════════
       1. HERO — H1: [Service] in [City]
       Primary keyword in H1, subtext reinforces trust signals
  ═══════════════════════════════════════════════════════════════════════════ -->
  <Hero
    title={`${serviceName} in ${city}`}
    text={B("heroText")}
    image={heroImage}
    imageAlt={`${serviceName} professionals in ${city} — ${businessName}`}
    locale={locale}
    breadcrumbs={crumbs}
  />

  <!-- AEO: direct-answer block targeting featured snippets / AI answers -->
  <ShortAnswer label={B("shortAnswer.label")} text={B("shortAnswer.text")} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       2. INTRODUCTION — What is [Service]? (~200 words)
       H2 with primary keyword, body copy answers "what does this service include?"
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="intro-heading">
    <div class="container service-intro">
      <div class="service-intro-copy">
        <p class="eyebrow">{serviceName} in {city}</p>
        <h2 id="intro-heading">{B("intro.heading")}</h2>
        <p>{B("intro.p1")}</p>
        <p>{B("intro.p2")}</p>
        <p>{B("intro.p3")}</p>
        <div class="intro-actions">
          <button class="btn btn-primary" data-open-form-popup data-service={service.id} aria-haspopup="dialog">
            {ui("blocks.common.getEstimate", locale)}
          </button>
          <a href={`tel:${phone}`} class="btn btn-outline">{ui("blocks.common.callPhone", locale, { phone })}</a>
        </div>
      </div>
      <div class="service-intro-image img-premium">
        <img
          src={heroImage}
          alt={`${serviceName} service in ${city} — ${businessName}`}
          width="600" height="400"
          loading="lazy" decoding="async"
          class="intro-img"
        />
      </div>
    </div>
  </section>

  <!-- Animated trust stats (values from siteConfig.stats) -->
  <StatsBar stats={statsBarItems} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       3. SUB-SERVICES GRID — [Service] Types We Offer (~200 words)
       H2 with service keyword, H3 per sub-service = long-tail keyword coverage
  ═══════════════════════════════════════════════════════════════════════════ -->
  {children.length > 0 && (
    <section class="section" aria-labelledby="subservices-heading">
      <div class="container">
        <p class="eyebrow">{B("sub.eyebrow")}</p>
        <h2 id="subservices-heading">{B("sub.heading")}</h2>
        <p class="section-lead">{B("sub.lead")}</p>
        <div class="subservices-grid">
          {children.map((child: any) => (
            <a href={subservicePath(locale, service, child)} class="subservice-card">
              <div class="subservice-card-inner">
                <h3 class="subservice-title">{t(child.title, locale)}</h3>
                <p class="subservice-desc">{t(child.short, locale)}</p>
                <span class="subservice-link" aria-hidden="true">
                  {ui("blocks.common.learnMore", locale)}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════════
       4. SIGNS YOU NEED THIS SERVICE (~200 words)
       H2 with problem-aware keyword, answers "do I need [service]?"
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="signs-heading">
    <div class="container">
      <p class="eyebrow">{B("signs.eyebrow")}</p>
      <h2 id="signs-heading">{B("signs.heading")}</h2>
      <p class="section-lead">{B("signs.lead")}</p>
      <div class="signs-grid">
        {signItems.map((sign) => (
          <div class="sign-card">
            <div class="sign-icon" aria-hidden="true"><Icon name={sign.icon ?? "check"} size={19} /></div>
            <div>
              <h3 class="sign-title">{sign.title}</h3>
              <p class="sign-desc">{sign.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Decision support: balanced pros/cons + comparison table (AEO) -->
  <ProsCons
    title={prosConsData.title}
    lead={prosConsData.lead}
    prosTitle={prosConsData.prosTitle}
    consTitle={prosConsData.consTitle}
    pros={prosConsData.pros}
    cons={prosConsData.cons}
  />
  <ComparisonTable
    title={comparisonData.title}
    lead={comparisonData.lead}
    columns={comparisonData.columns}
    rows={comparisonData.rows}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       5. WHY CHOOSE US — Benefits deep-dive (~250 words)
       H2 with brand + city keyword, H3 per benefit
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-charcoal" aria-labelledby="why-heading">
    <div class="container">
      <p class="eyebrow" style="color:var(--brand-accent)">{B("why.eyebrow")}</p>
      <h2 id="why-heading" style="color:#fff">{B("why.heading")}</h2>
      <p class="section-lead" style="color:rgba(255,255,255,.75)">{B("why.lead")}</p>
      <div class="benefits-grid">
        {whyItems.map((item) => (
          <div class="benefit-item">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       6. PROCESS SECTION — How it works
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ProcessSection
    title={B("process.title")}
    subtitle={B("process.subtitle")}
    steps={B("process.steps")}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       7. COMMON PROBLEMS SECTION (~150 words)
       H2 with problem-aware keyword, answers "what problems do you solve?"
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="problems-heading">
    <div class="container">
      <p class="eyebrow">{B("problems.eyebrow")}</p>
      <h2 id="problems-heading">{B("problems.heading")}</h2>
      <p class="section-lead">{B("problems.lead")}</p>
      <div class="problems-grid">
        {problemItems.map((item) => (
          <div class="problem-card">
            <div class="problem-icon" aria-hidden="true"><Icon name={item.icon ?? "check"} size={19} /></div>
            <div>
              <h3 class="problem-title">{item.title}</h3>
              <p class="problem-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       8. ABOUT / TRUST SECTION (~150 words)
       H2 with brand + service keyword
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container about-split">
      <div class="about-copy">
        <p class="eyebrow">{B("about.eyebrow")}</p>
        <h2 id="about-heading">{B("about.heading")}</h2>
        <p>{B("about.p1")}</p>
        <p>{B("about.p2")}</p>
        <p>{B("about.p3")}</p>
      </div>
      <div class="about-image-wrap img-premium">
        <img
          src={aboutImg}
          alt={`${businessName} — trusted ${serviceNameLower} professionals in ${city}`}
          width="600" height="400"
          loading="lazy" decoding="async"
          class="about-img"
        />
      </div>
    </div>
  </section>

  <!-- Image-rich proof: gallery + before/after (render when config provides data) -->
  {service.gallery && service.gallery.length > 0 && (
    <Gallery
      images={service.gallery}
      eyebrow={B("gallery.eyebrow")}
      title={B("gallery.title")}
      lead={B("gallery.lead")}
    />
  )}
  {service.beforeAfter && (
    <BeforeAfter
      before={service.beforeAfter.before}
      after={service.beforeAfter.after}
      eyebrow={B("gallery.eyebrow")}
      title={B("gallery.title")}
    />
  )}

  <!-- ═══════════════════════════════════════════════════════════════════════
       9. SERVICE AREA — Other locations we serve
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section-light" aria-labelledby="area-heading">
    <div class="container">
      <p class="eyebrow">{B("area.eyebrow")}</p>
      <h2 id="area-heading">{B("area.heading")}</h2>
      <p class="section-lead">{B("area.lead")}</p>
      <div class="area-tags">
        {siteConfig.locations.map((loc: any) => (
          <a href={locationPath(locale, loc.id)} class="area-tag">
            {serviceName} in {loc.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       10. RELATED SERVICES
  ═══════════════════════════════════════════════════════════════════════════ -->
  {relatedServices.length > 0 && (
    <section class="section" aria-labelledby="related-heading">
      <div class="container">
        <p class="eyebrow">{B("related.eyebrow")}</p>
        <h2 id="related-heading">{blocks("blocks.servicePage.related.heading", locale, { ...vars, service: t(siteConfig.business.primaryService, locale) })}</h2>
        <div class="services-grid">
          {relatedServices.map((s: any) => (
            <ServiceCard
              locale={locale}
              title={t(s.title, locale)}
              description={t(s.short, locale)}
              image={s.image ?? (siteConfig.brand as any).images?.hero1 ?? 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=600&q=80'}
              href={servicePath(locale, s)}
              alt={`${t(s.title, locale)} in ${city}`}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════════
       11. REVIEWS
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ReviewsSection locale={locale as string} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       12. FAQ — AEO/GEO optimised
  ═══════════════════════════════════════════════════════════════════════════ -->
  <FaqSection
    title={B("faqTitle")}
    items={faqs}
  />

  <!-- ═══════════════════════════════════════════════════════════════════════
       13. CTA STRIP
  ═══════════════════════════════════════════════════════════════════════════ -->
  <section class="cta-strip">
    <div class="container cta-strip-inner">
      <div class="cta-strip-text">
        <h2>{B("ctaStrip.heading")}</h2>
        <p>{B("ctaStrip.sub")}</p>
      </div>
      <div class="cta-strip-actions">
        <button class="btn btn-primary" data-open-form-popup data-service={service.id} aria-haspopup="dialog" aria-label={ui("blocks.common.requestEstimate", locale)}>
          {ui("blocks.common.requestEstimate", locale)}
        </button>
        <a href={`tel:${phone}`} class="btn btn-outline-light">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.93 2 2 0 0 1 3.6 2.73h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/></svg>
          {phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       14. FINAL CTA FORM
  ═══════════════════════════════════════════════════════════════════════════ -->
  <FinalCta
    locale={locale}
    title={B("finalCta.title")}
    text={B("finalCta.text")}
  />

</BaseLayout>

<style>
  /* ── Service intro split ─────────────────────────────────────────────────── */
  .service-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .service-intro-copy h2 { margin-bottom: 20px; }
  .service-intro-copy p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }
  .intro-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .intro-img {
    width: 100%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
    display: block;
  }
  @media (max-width: 768px) {
    .service-intro { grid-template-columns: 1fr; }
    .service-intro-image { order: -1; }
  }

  /* ── Sub-services grid ───────────────────────────────────────────────────── */
  .subservices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: clamp(32px, 5vw, 48px);
  }
  .subservice-card {
    display: block;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
  }
  .subservice-card:hover {
    box-shadow: var(--shadow-hover);
    border-color: var(--brand-accent);
    transform: translateY(-2px);
  }
  .subservice-card-inner { padding: clamp(20px, 3vw, 28px); }
  .subservice-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 10px;
  }
  .subservice-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 14px;
  }
  .subservice-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  /* ── Signs grid ──────────────────────────────────────────────────────────── */
  .signs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: clamp(32px, 5vw, 48px);
  }
  .sign-card {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  .sign-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, var(--brand-accent-light, #fef3c7), color-mix(in srgb, var(--brand-accent-light, #fef3c7) 35%, white));
    border: 1px solid color-mix(in srgb, var(--brand-accent) 22%, transparent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-accent-dark, #d97706);
    margin-top: 2px;
  }
  .sign-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 0.375rem;
  }
  .sign-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Benefits grid ───────────────────────────────────────────────────────── */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 40px);
    margin-top: clamp(32px, 5vw, 48px);
  }
  .benefit-item h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 10px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--brand-accent);
  }
  .benefit-item p {
    font-size: 0.9rem;
    color: rgba(255,255,255,.7);
    line-height: 1.75;
    margin: 0;
  }
  @media (max-width: 768px) {
    .benefits-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Problems grid ───────────────────────────────────────────────────────── */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: clamp(32px, 5vw, 48px);
  }
  .problem-card {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  .problem-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, var(--brand-accent-light, #fef3c7), color-mix(in srgb, var(--brand-accent-light, #fef3c7) 35%, white));
    border: 1px solid color-mix(in srgb, var(--brand-accent) 22%, transparent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-accent-dark, #d97706);
    margin-top: 2px;
  }
  .problem-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 0.375rem;
  }
  .problem-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── About split ─────────────────────────────────────────────────────────── */
  .about-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .about-copy h2 { margin-bottom: 20px; }
  .about-copy p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }
