---
/**
 * Sub-service (child) page template
 * e.g. /en/drain-cleaning/kitchen-drain-cleaning/
 * Target: 600–900 words of visible body copy
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/Hero.astro";
import FaqSection from "../../../components/FaqSection.astro";
import ProcessSection from "../../../components/ProcessSection.astro";
import ServiceCard from "../../../components/ServiceCard.astro";
import FinalCta from "../../../components/FinalCta.astro";
import { siteConfig, allServices } from "../../../site.config";
import { t, servicePath, subservicePath, locationPath, serviceSlug, localePathsFor } from "../../../lib/routes";
import { seo, serviceSchema, breadcrumbSchema } from "../../../lib/seo";
import { blocks, ui } from "../../../i18n";
import type { Locale } from "../../../site.config";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of siteConfig.locales) {
    for (const parent of allServices) {
      for (const child of (parent.children ?? [])) {
        paths.push({
          params: { lang: locale.code, parent: serviceSlug(locale.code, parent), child: serviceSlug(locale.code, child) },
          props: { locale: locale.code as string, parent, child },
        });
      }
    }
  }
  return paths;
}

const { locale, parent, child } = Astro.props;
const city = siteConfig.business.city;
const businessName = siteConfig.business.name;
const phone = siteConfig.business.phone;
const stats = siteConfig.stats;

// Resolve localized text
const parentName = t(parent.title, locale);
const childName  = t(child.title, locale);
const childShort = t(child.short, locale);
const parentShort = t(parent.short, locale);

// All body copy comes from the locale files (blocks.childPage.*)
const vars = {
  business: businessName,
  city,
  phone,
  parent: parentName,
  parentLower: parentName.toLowerCase(),
  child: childName,
  childLower: childName.toLowerCase(),
  short: childShort,
  years: stats.yearsInBusiness,
  rating: stats.averageRating,
  jobs: stats.jobsCompleted
};
const B = (key: string) => blocks(`blocks.childPage.${key}`, locale, vars);
const trustItems: Array<{ strong: string; rest: string }> = B("trust.items");
const signItems: string[] = B("signs.items");
const benefitCards: Array<{ title: string; desc: string }> = B("benefits.cards");

const pageTitle       = `${childName} | ${businessName}`;
const pageDescription = locale === "hr"
  ? `${childName} iz Zračne luke Split uz ${businessName}. Privatni transfer, vozila na upit i fiksna ponuda. Nazovite ${phone} ili zatražite ponudu.`
  : `${childName} from Split Airport with ${businessName}. A private transfer, vehicles on request and a fixed quote. Call ${phone} or request a quote.`;

const faqs: Array<{ q: string; a: string }> = [
  ...(child.faq ?? []).map((f: any) => ({ q: t(f.question, locale), a: t(f.answer, locale) })),
  ...B("faqs"),
];

const crumbs = [
  { name: "Home",      url: `/${locale}/` },
  { name: parentName,  url: servicePath(locale, parent) },
  { name: childName,   url: subservicePath(locale, parent, child) },
];

// FAQPage schema is emitted by FaqSection from its visible items.
const schema = [
  serviceSchema(locale, childName, subservicePath(locale, parent, child)),
  breadcrumbSchema(crumbs),
];

const meta = seo({
  title: pageTitle,
  description: pageDescription,
  locale,
  path: subservicePath(locale, parent, child),
  localePaths: localePathsFor((l) => subservicePath(l, parent, child)),
  schema,
});

const heroImage = parent.image ?? "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1920&q=80";
const siblingServices = (parent.children ?? []).filter((c: any) => c.id !== child.id).slice(0, 3);
const relatedServices = allServices.filter((s: any) => s.id !== parent.id).slice(0, 3);
---
<BaseLayout seo={meta}>

  <!-- 1. HERO -->
  <Hero
    title={`${childName} in ${city}`}
    text={B("heroText")}
    image={heroImage}
    imageAlt={`${childName} in ${city} — ${businessName}`}
    locale={locale as any}
    breadcrumbs={crumbs}
  />

  <!-- 2. OVERVIEW + INTRO COPY -->
  <section class="section-light">
    <div class="container">
      <div class="child-intro-grid">
        <div class="child-intro-text">
          <p class="section-eyebrow">{parentName} › {childName}</p>
          <h2 class="section-heading">{B("intro.heading")}</h2>
          <p class="section-lead">{childShort}</p>
          <p>{B("intro.p1")}</p>
          <p>{B("intro.p2")}</p>
          <p>{B("intro.p3")}</p>
          <div class="child-ctas">
            <button class="btn btn-primary" data-open-form-popup data-service={parent.id} aria-haspopup="dialog">{ui("blocks.common.getEstimate", locale)}</button>
            {phone && <a href={`tel:${phone}`} class="btn-secondary">{ui("blocks.common.callPhone", locale, { phone })}</a>}
          </div>
        </div>
        <div class="child-intro-sidebar">
          <div class="child-trust-card">
            <h3>{B("trust.heading")}</h3>
            <ul class="child-trust-list">
              {trustItems.map((item) => (
                <li>
                  <span class="trust-icon">✓</span>
                  <span><strong>{item.strong}</strong>{item.rest}</span>
                </li>
              ))}
            </ul>
            <button class="btn btn-primary btn-full" data-open-form-popup data-service={parent.id} aria-haspopup="dialog">{ui("blocks.common.requestQuote", locale)}</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHEN YOU NEED IT + BENEFITS -->
  <section class="section-dark">
    <div class="container">
      <div class="child-benefits-grid">
        <div class="child-benefits-col">
          <h2 class="section-heading light">{B("signs.heading")}</h2>
          <p class="section-lead light">{B("signs.lead")}</p>
          <ul class="child-signs-list">
            {signItems.map((item) => <li>{item}</li>)}
          </ul>
          <p>{B("signs.outro")}</p>
        </div>
        <div class="child-benefits-col">
          <h2 class="section-heading light">{B("benefits.heading")}</h2>
          <p class="section-lead light">{B("benefits.lead")}</p>
          <div class="child-benefit-cards">
            {benefitCards.map((card, i) => (
              <div class="child-benefit-card">
                <span class="benefit-num">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <strong>{card.title}</strong>
                  <p>{card.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PROCESS -->
  <ProcessSection
    title={B("process.title")}
    subtitle={B("process.subtitle")}
    steps={B("process.steps")}
  />

  <!-- 5. SIBLING SERVICES (other children of same parent) -->
  {siblingServices.length > 0 && (
    <section class="section-light">
      <div class="container">
        <p class="section-eyebrow">{B("siblings.eyebrow")}</p>
        <h2 class="section-heading">{B("siblings.heading")}</h2>
        <p class="section-subheading">{B("siblings.lead")}</p>
        <div class="services-grid">
          {siblingServices.map((s: any) => (
            <ServiceCard
              locale={locale}
              title={`${t(s.title, locale)} in ${city}`}
              description={t(s.short, locale)}
              image={heroImage}
              href={subservicePath(locale, parent, s)}
              alt={t(s.title, locale)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. FAQ -->
  <FaqSection
    title={B("faqTitle")}
    items={faqs}
    locale={locale as any}
  />

  <!-- 7. OTHER SERVICES -->
  {relatedServices.length > 0 && (
    <section class="section-light">
      <div class="container">
        <p class="section-eyebrow">{B("more.eyebrow")}</p>
        <h2 class="section-heading">{B("more.heading")}</h2>
        <div class="services-grid">
          {relatedServices.map((s: any) => (
            <ServiceCard
              locale={locale}
              title={t(s.title, locale)}
              description={t(s.short, locale)}
              image={s.image}
              href={servicePath(locale, s)}
              alt={t(s.title, locale)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7b. POPULAR ROUTES — internal links to top route money pages -->
  <section class="section">
    <div class="container">
      <p class="section-eyebrow">{locale === "hr" ? "Popularne rute" : "Popular Routes"}</p>
      <h2 class="section-heading">{locale === "hr" ? "Popularne rute transfera iz Zračne luke Split" : "Popular Split Airport Transfer Routes"}</h2>
      <div class="child-routes">
        {siteConfig.locations.slice(0, 10).map((loc: any) => (
          <a href={locationPath(locale, loc.id)} class="child-route-tag">
            {locale === "hr" ? `Zračna luka Split → ${loc.name}` : `Split Airport → ${loc.name}`}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FINAL CTA -->
  <FinalCta locale={locale as any} />

</BaseLayout>

<style>
/* ── Child page layout ─────────────────────────────────────────────────────── */
.child-intro-grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 3rem;
  align-items: start;
}
.child-intro-text p {
  color: var(--color-muted);
  line-height: 1.85;
  margin-bottom: 1.25rem;
}
.child-ctas {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}
.child-trust-card {
  background: var(--color-light);
  border: 1px solid var(--color-border);
  border-radius: 1rem;
  padding: 2rem;
  position: sticky;
  top: 6rem;
}
.child-trust-card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 1.25rem;
}
.child-trust-list {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.child-trust-list li {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  font-size: 0.9rem;
  color: var(--color-muted);
  line-height: 1.5;
}
.trust-icon {
  color: var(--brand-accent);
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 0.1rem;
}
.btn-full { width: 100%; justify-content: center; }

/* ── Benefits section ──────────────────────────────────────────────────────── */
.child-benefits-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.section-heading.light,
.section-lead.light { color: var(--color-light); }
.child-signs-list {
  list-style: none;
  padding: 0;
  margin: 1rem 0 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.child-signs-list li {
  color: rgba(255,255,255,0.8);
  padding-left: 1.5rem;
  position: relative;
  line-height: 1.6;
  font-size: 0.95rem;
}
.child-signs-list li::before {
  content: "→";
  position: absolute;
  left: 0;
  color: var(--brand-accent);
}
.child-benefits-col > p {
  color: rgba(255,255,255,0.75);
  line-height: 1.8;
  margin-bottom: 1rem;
}
.child-benefit-cards {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.child-benefit-card {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 0.75rem;
  padding: 1.25rem;
}
.benefit-num {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--brand-accent);
  line-height: 1;
  flex-shrink: 0;
  min-width: 2rem;
}
.child-benefit-card strong {
  display: block;
  color: var(--color-light);
  font-weight: 700;
  margin-bottom: 0.35rem;
}
.child-benefit-card p {
  color: rgba(255,255,255,0.7);
  font-size: 0.9rem;
  line-height: 1.6;
  margin: 0;
}

/* ── Responsive ────────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .child-intro-grid { grid-template-columns: 1fr; }
  .child-trust-card { position: static; }
  .child-benefits-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
.child-routes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(24px, 4vw, 36px); }
.child-route-tag {
  display: inline-block;
  padding: 8px 16px;
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 100px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text);
  text-decoration: none;
  transition: background .2s, border-color .2s, color .2s;
}
.child-route-tag:hover { background: var(--brand-accent); border-color: var(--brand-accent); color: #fff; }
</style>
