---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProcessSection from "@/components/ProcessSection.astro";
import FinalCta from "@/components/FinalCta.astro";
import FaqSection from "@/components/FaqSection.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import LocationCard from "@/components/LocationCard.astro";
import { allServices, siteConfig, type Locale } from "@/site.config";
import { localizedPath, locationPath, servicePath, subservicePath, t } from "@/lib/routes";
import { breadcrumbSchema, faqSchema, seo, serviceSchema } from "@/lib/seo";

export function getStaticPaths() {
  return siteConfig.locales.flatMap((locale) => allServices.flatMap((parent) => parent.children.map((child) => ({ params: { lang: locale.code, parent: parent.id, child: child.id }, props: { parent, child } }))));
}
const { parent, child } = Astro.props;
const locale = Astro.params.lang as Locale;
const faqs = [
  { question: `When should I request ${t(child.title, locale)}?`, answer: `Request ${t(child.title, locale)} when you want clear guidance, reliable scheduling, and professional help in ${siteConfig.business.serviceArea}.` },
  { question: `Is ${t(child.title, locale)} available in ${siteConfig.business.city}?`, answer: `Yes. ${siteConfig.business.name} provides this service in ${siteConfig.business.city} and nearby communities.` },
  { question: "What happens after I submit the form?", answer: "The team reviews your details and follows up about timing, scope, and next steps." }
];
const path = `${parent.id}/${child.id}`;
const pageSeo = seo({ locale, path, title: `${t(child.title, locale)} In ${siteConfig.business.city} | ${siteConfig.business.name}`, description: `${siteConfig.business.name} provides ${t(child.title, locale)} in ${siteConfig.business.city} with clear communication, reliable scheduling, and free estimates.`, image: parent.image, schema: [serviceSchema(locale, t(child.title, locale), path), breadcrumbSchema([{ name: "Home", url: localizedPath(locale) }, { name: t(parent.title, locale), url: servicePath(locale, parent) }, { name: t(child.title, locale), url: subservicePath(locale, parent, child.id) }]), faqSchema(faqs)] });
---
<BaseLayout seo={pageSeo}>
  <Hero eyebrow="Subservice" title={`${t(child.title, locale)} In ${siteConfig.business.city}`} text={`${siteConfig.business.name} provides ${t(child.title, locale)} in ${siteConfig.business.city} and surrounding areas with clear communication, reliable scheduling, and professional service.`} image={parent.image} primaryHref={localizedPath(locale, "contact")} primaryText="Get A Free Estimate" secondaryHref={`tel:${siteConfig.business.phone}`} secondaryText={`Call ${siteConfig.business.phone}`} badges={[`Serving ${siteConfig.business.city}`, "Free Local Estimates", "Fast Response"]} />
  <div class="container"><Breadcrumbs locale={locale} items={[{ label: t(parent.title, locale), href: servicePath(locale, parent) }, { label: t(child.title, locale), href: subservicePath(locale, parent, child.id) }]} /></div>
  <section class="section"><div class="container" style="max-width:850px"><p class="eyebrow">Detailed Service</p><h2>Local Help For {t(child.title, locale)}</h2><p>This child page is designed to become a deep, non-duplicate page. Replace this starter copy with 900 to 1800 words of niche-specific information, real customer scenarios, what is included, when the service is needed, and practical local details.</p><p>For Rank-and-Rent builds, keep the page focused on one search intent. Link back to the parent page, link to related services, and mention relevant locations naturally.</p><p><a href={servicePath(locale, parent)}>View {t(parent.title, locale)}</a></p></div></section>
  <section class="section section-light"><div class="container"><h2>When You Need {t(child.title, locale)}</h2><div class="grid grid-3">{["The problem is affecting daily use", "You need clear options before booking", "You want local help without confusing next steps"].map((item) => <article class="card"><div class="card-body"><span class="icon-mark">✓</span><h3>{item}</h3><p>Adapt this intent block to the niche so visitors can quickly recognize their situation and take the next step.</p></div></article>)}</div></div></section>
  <section class="section section-light"><div class="container"><h2>What Is Included</h2><div class="grid grid-3">{["Problem review", "Clear estimate", "Professional service"].map((item) => <article class="card"><div class="card-body"><span class="icon-mark">✓</span><h3>{item}</h3><p>Customize this explanation for {t(child.title, locale)} so visitors understand the exact value and scope.</p></div></article>)}</div></div></section>
  <ProcessSection title={`How ${t(child.title, locale)} Works`} steps={[{title:"Tell Us What You Need",text:"Share the situation and location."},{title:"Review The Scope",text:"We explain timing and next steps."},{title:"Complete The Service",text:"The work is handled professionally."},{title:"Confirm The Result",text:"You know what was completed and what to expect next."}]} />
  <section class="section"><div class="container"><h2>Related Services</h2><div class="grid grid-3">{parent.children.filter((item) => item.id !== child.id).slice(0,3).map((item) => <ServiceCard title={t(item.title, locale)} description={t(item.short, locale)} image={parent.image} href={subservicePath(locale, parent, item.id)} alt={`${t(item.title, locale)} in ${siteConfig.business.city}`} />)}</div></div></section>
  <section class="section section-light"><div class="container"><h2>Service Areas Served</h2><p>{siteConfig.business.name} provides {t(child.title, locale)} across {siteConfig.business.serviceArea}. These local pages help visitors and search engines understand where the service is available.</p><div class="grid grid-3">{siteConfig.locations.slice(0,6).map((location) => <LocationCard title={location.name} href={locationPath(locale, location.id)} image={location.image} />)}</div></div></section>
  <FaqSection faqs={faqs} />
  <FinalCta locale={locale} service={parent.id} title={`Request ${t(child.title, locale)} In ${siteConfig.business.city}`} text={`Use the form to request ${t(child.title, locale)} in ${siteConfig.business.city} and nearby areas.`} />
</BaseLayout>
