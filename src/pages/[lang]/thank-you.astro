---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, type Locale } from "@/site.config";
import { localizedPath } from "@/lib/routes";
import { seo } from "@/lib/seo";
export function getStaticPaths() { return siteConfig.locales.map((locale) => ({ params: { lang: locale.code } })); }
const locale = Astro.params.lang as Locale;
const pageSeo = seo({ locale, path: "thank-you", title: `Thank You | ${siteConfig.business.name}`, description: "Thank you for your request.", noindex: true });
---
<BaseLayout seo={pageSeo}><section class="section section-light"><div class="container" style="max-width:760px"><h1>Thank You</h1><p>Your request has been received. Replace the form action with your CRM or server endpoint when you connect lead delivery.</p><a class="button button-primary" href={localizedPath(locale)}>Back Home</a></div></section></BaseLayout>
