---
/**
 * Contact page — popup form model, multiple contact paths, trust signals
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import FaqSection from "../../components/FaqSection.astro";
import FinalCta from "../../components/FinalCta.astro";
import { siteConfig } from "../../site.config";
import { seo, localBusinessSchema, breadcrumbSchema } from "../../lib/seo";
import { t } from "../../lib/routes";

export async function getStaticPaths() {
  return siteConfig.locales.map(locale => ({
    params: { lang: locale.code },
    props: { locale: locale.code },
  }));
}

const { locale } = Astro.props;
const isHr = locale === "hr";
const city = siteConfig.business.city;
const businessName = siteConfig.business.name;
const phone = siteConfig.business.phone;
const email = siteConfig.business.email;
const address = siteConfig.business.address;
const hours = siteConfig.business.hours;
const area = siteConfig.business.serviceArea;
const primaryService = t(siteConfig.business.primaryService, locale);

const crumbs = [
  { name: isHr ? "Početna" : "Home", url: `/${locale}/` },
  { name: isHr ? "Kontakt" : "Contact", url: `/${locale}/contact/` },
];

const faqsRaw = isHr ? [
  { q: "Kako brzo ćete odgovoriti na moj upit?", a: `Nastojimo odgovoriti na sve upite što prije. Za hitne situacije nazovite nas izravno na ${phone} za najbrži odgovor.` },
  { q: "Plaćam li unaprijed na ovoj stranici?", a: `Ne. Ova stranica služi za upite. ${businessName} vam šalje fiksnu ponudu za potvrdu, a plaćanje dogovarate izravno s operaterom transfera.` },
  { q: "Koje informacije trebam pripremiti pri upitu?", a: "Korisno je navesti rutu (odakle i kamo), broj leta i vrijeme dolaska, broj putnika i prtljagu te eventualne dječje sjedalice. Što više detalja, to je ponuda točnija." },
  { q: "Mogu li poslati upit izvan radnog vremena?", a: `Da, online obrazac možete poslati u bilo koje doba i odgovorit ćemo čim prije. Za hitne upite nazovite ${phone}.` },
] : [
  { q: "How quickly will you respond to my inquiry?", a: `We aim to respond to all inquiries as soon as possible. For urgent situations, please call us directly at ${phone} for the fastest response.` },
  { q: "Do I pay upfront on this site?", a: `No. This site is for inquiries. ${businessName} sends you a fixed quote to confirm, and you arrange payment directly with the transfer operator.` },
  { q: "What information should I have ready when I contact you?", a: "It helps to have your route (from and to), flight number and arrival time, passenger count and luggage, plus any child seats needed. The more detail you provide, the more accurate the quote." },
  { q: "Can I contact you outside of business hours?", a: `Yes — you can submit our online form at any time and we will respond as soon as possible. For urgent inquiries, please call ${phone}.` },
];

const faqs = faqsRaw.map(f => ({ question: f.q, answer: f.a }));
const schema = [
  localBusinessSchema(locale),
  breadcrumbSchema(crumbs),
];

const meta = seo({
  title: `${isHr ? "Kontakt" : "Contact"} ${businessName} | ${primaryService}`,
  description: isHr
    ? `Kontaktirajte ${businessName} za privatni transfer iz Zračne luke Split do ${area}. Zatražite fiksnu ponudu putem obrasca, nazovite ${phone} ili pošaljite e-poštu.`
    : `Contact ${businessName} for a private transfer from Split Airport to ${area}. Request a fixed quote by form, call ${phone} or send an email.`,
  locale,
  path: `/${locale}/contact/`,
  schema: schema ?? [],
});
---
<BaseLayout seo={meta}>
  <!-- HERO -->
  <Hero
    title={isHr ? `Kontakt — ${businessName}` : `Contact ${businessName}`}
    text={isHr
      ? `Spremni za rezervaciju? Zatražite fiksnu ponudu putem obrasca, nazovite nas ili pošaljite poruku. Odgovaramo na sve upite što prije.`
      : `Ready to book? Request a fixed quote with our form, call us, or send a message. We respond to all inquiries as soon as possible.`}
    image={(siteConfig.brand as any).images?.contact ?? 'https://images.unsplash.com/photo-1423666639041-f56000c27a9a?auto=format&fit=crop&w=1920&q=80'}
    imageAlt={isHr ? `Kontaktirajte ${businessName} — transferi iz Zračne luke Split` : `Contact ${businessName} — Split Airport transfers`}
    locale={locale as any}
    breadcrumbs={crumbs}
  />

  <!-- CONTACT OPTIONS -->
  <section class="section section-white">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{isHr ? "Javite nam se" : "Get in Touch"}</span>
        <h2 class="section-title">{isHr ? "Kako nas želite kontaktirati?" : "How Would You Like to Reach Us?"}</h2>
        <p class="section-lead">{isHr ? "Odaberite način kontakta koji vam najviše odgovara. Tu smo da pomognemo." : "Choose the contact method that works best for you. We are here to help."}</p>
      </div>
      <div class="contact-options">
        <!-- Request a Quote (popup trigger) -->
        <div class="contact-card contact-card-primary">
          <div class="contact-card-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3>{isHr ? "Zatražite fiksnu ponudu" : "Request a Fixed Quote"}</h3>
          <p>{isHr ? "Ispunite kratki obrazac s rutom i detaljima leta, a operater vam šalje fiksnu ponudu za potvrdu." : "Fill out the quick form with your route and flight details, and the operator sends back a fixed quote to confirm."}</p>
          <button class="btn btn-primary" data-open-form-popup aria-haspopup="dialog" aria-label={isHr ? "Otvorite obrazac za upit" : "Open quote request form"}>{isHr ? "Zatražite ponudu" : "Request a Quote"}</button>
        </div>

        <!-- Phone -->
        {phone && (
          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.93 2 2 0 0 1 3.6 2.73h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/></svg>
            </div>
            <h3>{isHr ? "Nazovite nas" : "Call Us Directly"}</h3>
            <p>{isHr ? "Za hitne upite ili ako želite razgovarati izravno, nazovite nas." : "For urgent inquiries or if you prefer to speak with someone directly, give us a call."}</p>
            <a href={`tel:${phone}`} class="btn btn-outline-dark">{phone}</a>
          </div>
        )}

        <!-- Email -->
        {email && (
          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <h3>{isHr ? "Pošaljite e-poštu" : "Send Us an Email"}</h3>
            <p>{isHr ? "Više volite pisati? Pošaljite nam e-poštu s detaljima i odgovorit ćemo čim prije." : "Prefer to write? Send us an email with the details and we will reply as soon as possible."}</p>
            <a href={`mailto:${email}`} class="btn btn-outline-dark">{email}</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- BUSINESS DETAILS -->
  <section class="section section-light">
    <div class="container">
      <div class="details-grid">
        <div class="details-info">
          <span class="section-eyebrow">{isHr ? "Podaci" : "Business Details"}</span>
          <h2 class="details-title">{businessName}</h2>
          <div class="details-list">
            {address && (
              <div class="detail-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{address}</span>
              </div>
            )}
            {phone && (
              <div class="detail-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.93 2 2 0 0 1 3.6 2.73h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/></svg>
                <a href={`tel:${phone}`}>{phone}</a>
              </div>
            )}
            {email && (
              <div class="detail-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href={`mailto:${email}`}>{email}</a>
              </div>
            )}
            {hours && (
              <div class="detail-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <div>
                  {Object.entries(hours).map(([day, time]) => (
                    <div class="hours-row"><span class="hours-day">{day}</span><span class="hours-time">{time}</span></div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
        <div class="details-trust">
          <h3>{isHr ? "Što možete očekivati" : "What to Expect"}</h3>
          <ul class="expect-list">
            {(isHr ? [
              "Odgovaramo na sve upite što prije",
              "Fiksna ponuda unaprijed — bez plaćanja unaprijed na ovoj stranici",
              "Privatni transfer od vrata do vrata",
              "Automobili, kombiji, minibusi i autobusi na upit",
              "Dječje sjedalice i povratni transferi na upit",
              "Preuzimanje planirano prema vašem letu",
            ] : [
              "We respond to all inquiries as soon as possible",
              "A fixed quote upfront — no upfront payment on this site",
              "A private, door-to-door transfer",
              "Cars, vans, minibuses and buses on request",
              "Child seats and return transfers on request",
              "Pickup planned around your flight",
            ]).map(item => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FaqSection faqs={faqsRaw.map(f => ({ q: f.q, a: f.a }))} locale={locale as any} />

  <!-- FINAL CTA -->
  <FinalCta locale={locale as any} />
</BaseLayout>

<style>
  .contact-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
  .contact-card { padding: 2rem; background: white; border: 1px solid var(--color-border); border-radius: 16px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 1rem; }
  .contact-card-primary { border-color: var(--color-accent); background: #fffbeb; }
  .contact-card-icon { width: 56px; height: 56px; background: var(--color-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--color-dark); }
  .contact-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--color-dark); margin: 0; }
  .contact-card p { font-size: 0.9375rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; flex: 1; }
  .btn-outline-dark { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--color-dark); border-radius: 8px; font-weight: 600; color: var(--color-dark); background: transparent; text-decoration: none; font-size: 0.9375rem; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .btn-outline-dark:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-dark); }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .details-title { font-size: 1.75rem; font-weight: 800; color: var(--color-dark); margin: 0.5rem 0 1.5rem; }
  .details-list { display: flex; flex-direction: column; gap: 1rem; }
  .detail-row { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.9375rem; color: var(--color-text-muted); }
  .detail-row svg { flex-shrink: 0; color: var(--color-accent); margin-top: 2px; }
  .detail-row a { color: var(--color-accent); text-decoration: none; }
  .detail-row a:hover { text-decoration: underline; }
  .hours-row { display: flex; gap: 1rem; }
  .hours-day { font-weight: 600; color: var(--color-dark); min-width: 100px; }
  .hours-time { color: var(--color-text-muted); }
  .details-trust { padding: 2rem; background: white; border: 1px solid var(--color-border); border-radius: 16px; }
  .details-trust h3 { font-size: 1.125rem; font-weight: 700; color: var(--color-dark); margin: 0 0 1.25rem; }
  .expect-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .expect-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; color: var(--color-text-muted); }
  .expect-list li svg { flex-shrink: 0; color: var(--color-accent); margin-top: 2px; }
  @media (max-width: 768px) { .details-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
