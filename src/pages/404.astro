---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";
import { seo } from "@/lib/seo";
const defaultLocale = siteConfig.defaultLocale;
const pageSeo = seo({ locale: defaultLocale, path: "404", title: `Page Not Found | ${siteConfig.business.name}`, description: `The page you are looking for does not exist. Return to the ${siteConfig.business.name} homepage or contact us for help.`, noindex: true });
---
<BaseLayout seo={pageSeo}>
  <section class="section" style="text-align:center;min-height:60vh;display:grid;align-items:center">
    <div class="container" style="max-width:600px">
      <span class="eyebrow">404</span>
      <h1>Page Not Found</h1>
      <p>We could not find the page you were looking for. It may have been moved, removed, or never existed.</p>
      <div class="actions" style="justify-content:center">
        <a class="button button-primary" href="/">Return Home</a>
        <a class="button button-secondary" href={`/${defaultLocale}/contact/`}>Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
