---
/**
 * HeroSlider — Full-bleed photo hero with slider
 * - Homepage only: full viewport height
 * - Trust badge row (styled correctly)
 * - Slide dots only (no side arrows per design spec)
 * - Supports: form popup CTA, phone CTA, email CTA (configurable via site.config)
 */
import { siteConfig, type Locale } from "@/site.config";
import { localizedPath, t } from "@/lib/routes";
import { ui } from "@/i18n";
type LocalizedText = string | { en: string; hr?: string; [key: string]: string | undefined };
interface Slide {
  title: LocalizedText;
  text: LocalizedText;
  image: string;
  primaryText?: LocalizedText;
  primaryHref?: string;
  secondaryText?: LocalizedText;
  secondaryHref?: string;
}
interface Props {
  slides: Slide[];
  locale: Locale;
  badges?: string[];
}
const { slides, locale, badges = [] } = Astro.props;
const ctaMode = siteConfig.business.ctaMode ?? "form_phone";
const phone   = siteConfig.business.phone;
const email   = siteConfig.business.email;
---
<section
  class="hero-slider"
  data-hero-slider
  aria-roledescription="carousel"
  aria-label="Featured slides"
>
  {slides.map((slide, i) => (
    <div
      class={`hs-slide${i === 0 ? " is-active" : ""}`}
      role="group"
      aria-roledescription="slide"
      aria-label={`Slide ${i + 1} of ${slides.length}`}
      aria-hidden={i !== 0}
    >
      <!-- Background image -->
      <img
        class="hs-bg"
        src={slide.image}
        alt=""
        role="presentation"
        width="1920"
        height="1080"
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={i === 0 ? "high" : "auto"}
      />
      <!-- Overlay -->
      <div class="hs-overlay" aria-hidden="true"></div>
      <!-- Content -->
      <div class="hs-content">
        <div class="container">
          <div class="hs-inner">
            <p class="hs-eyebrow animate-fade-in">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {ui("hero.eyebrow", locale).replace("{city}", siteConfig.business.city)}
            </p>
            <h1 class="hs-heading animate-fade-in delay-100">{t(slide.title as any, locale)}</h1>
            <p class="hs-subheading animate-fade-in delay-200">{t(slide.text as any, locale)}</p>
            <!-- CTAs — driven by ctaMode -->
            <div class="hs-actions animate-fade-in delay-300">
              {/* Always show form popup trigger */}
              <button
                type="button"
                class="btn btn-primary btn-lg"
                data-open-form-popup
                aria-haspopup="dialog"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                {t(siteConfig.business.cta, locale)}
              </button>
              {/* Phone CTA */}
              {(ctaMode === "form_phone" || ctaMode === "form_phone_email" || ctaMode === "phone_only") && phone && (
                <a href={`tel:${phone}`} class="btn btn-secondary btn-lg">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                  {ui("hero.callCta", locale)} {phone}
                </a>
              )}
              {/* Email CTA */}
              {(ctaMode === "form_email" || ctaMode === "form_phone_email" || ctaMode === "email_only") && email && (
                <a href={`mailto:${email}`} class="btn btn-secondary btn-lg">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  {ui("hero.emailCta", locale)}
                </a>
              )}
            </div>
            <!-- Trust badges -->
            {badges.length > 0 && (
              <div class="hs-trust animate-fade-in delay-400" role="list" aria-label="Trust indicators">
                {badges.map((badge) => (
                  <span class="hs-trust-item" role="listitem">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    {badge}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  ))}
  <!-- Slide dots only (no arrows per spec) -->
  {slides.length > 1 && (
    <div class="hs-controls" role="tablist" aria-label="Slide navigation">
      {slides.map((_, i) => (
        <button
          class={`hs-dot${i === 0 ? " is-active" : ""}`}
          role="tab"
          aria-selected={i === 0}
          aria-label={`Go to slide ${i + 1}`}
          data-slide-btn={i}
          type="button"
        ></button>
      ))}
    </div>
  )}
</section>
<style>
  /* ── Slider container ──────────────────────────────────────────────────── */
  .hero-slider {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--brand-primary);
  }
  /* ── Individual slide ──────────────────────────────────────────────────── */
  .hs-slide {
    position: absolute;
    inset: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s ease, visibility 0.7s ease;
  }
  .hs-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }
  /* ── Background image ──────────────────────────────────────────────────── */
  .hs-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transform: scale(1.04);
    transition: transform 6s ease;
  }
  .hs-slide.is-active .hs-bg { transform: scale(1); }
  /* ── Overlay ───────────────────────────────────────────────────────────── */
  .hs-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(15,23,42,.88) 55%, rgba(15,23,42,.4) 100%),
      linear-gradient(to top, rgba(0,0,0,.5) 0%, transparent 55%);
    z-index: 1;
  }
  /* ── Content ───────────────────────────────────────────────────────────── */
  .hs-content {
    position: relative;
    z-index: 2;
    padding-block: clamp(100px, 14vw, 160px);
    width: 100%;
  }
  .hs-inner { max-width: 740px; }
  /* ── Eyebrow ───────────────────────────────────────────────────────────── */
  .hs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin: 0 0 20px;
  }
  /* ── Heading ───────────────────────────────────────────────────────────── */
  .hs-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: white;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  /* ── Subheading ────────────────────────────────────────────────────────── */
  .hs-subheading {
    font-size: clamp(1rem, 1.5vw, 1.175rem);
    color: rgba(255,255,255,.82);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 580px;
  }
  /* ── Actions ───────────────────────────────────────────────────────────── */
  .hs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-bottom: 32px;
  }
  /* ── Trust badges ──────────────────────────────────────────────────────── */
  .hs-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    align-items: center;
  }
  .hs-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,.9);
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.15);
    backdrop-filter: blur(6px);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }
  .hs-trust-item svg { color: var(--brand-accent); flex-shrink: 0; }
  /* ── Slide dots ────────────────────────────────────────────────────────── */
  .hs-controls {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }
  .hs-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255,255,255,.35);
    border: none;
    cursor: pointer;
    transition: background 0.2s, width 0.2s;
    padding: 0;
  }
  .hs-dot.is-active { background: var(--brand-accent); width: 28px; }
  .hs-dot:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 3px; }
  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-slider { min-height: 90svh; }
    .hs-slide { min-height: 90svh; }
    .hs-actions { flex-direction: column; align-items: flex-start; }
    .hs-actions .btn { width: 100%; justify-content: center; }
    .hs-trust { gap: 8px; }
  }
</style>
<script is:inline>
(function() {
  var sliders = document.querySelectorAll("[data-hero-slider]");
  sliders.forEach(function(slider) {
    var slides  = slider.querySelectorAll(".hs-slide");
    var dots    = slider.querySelectorAll("[data-slide-btn]");
    var current = 0;
    var total   = slides.length;
    var timer;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (total <= 1) return;
    function goTo(n) {
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      dots[current].classList.remove("is-active");
      dots[current].setAttribute("aria-selected", "false");
      current = (n + total) % total;
      slides[current].classList.add("is-active");
      slides[current].setAttribute("aria-hidden", "false");
      dots[current].classList.add("is-active");
      dots[current].setAttribute("aria-selected", "true");
    }
    function startAuto() {
      if (reduced) return;
      timer = setInterval(function() { goTo(current + 1); }, 5500);
    }
    function resetAuto() { clearInterval(timer); startAuto(); }
    dots.forEach(function(dot, i) {
      dot.addEventListener("click", function() { goTo(i); resetAuto(); });
    });
    slider.addEventListener("keydown", function(e) {
      if (e.key === "ArrowLeft")  { goTo(current - 1); resetAuto(); }
      if (e.key === "ArrowRight") { goTo(current + 1); resetAuto(); }
    });
    startAuto();
  });
})();
</script>
