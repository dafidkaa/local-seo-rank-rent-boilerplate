---
/**
 * HeroSlider — Premium full-bleed photo hero with slideshow
 * - Dark overlay with brand color
 * - Large Poppins heading, trust badges, dual CTAs
 * - Keyboard-accessible slide controls
 * - prefers-reduced-motion respected
 */
import { t, localizedPath } from "@/lib/routes";
import { siteConfig, type Locale, type HeroSlide } from "@/site.config";
import { ui } from "@/i18n";

interface Props {
  slides: HeroSlide[];
  locale: Locale;
  badges?: string[];
}

const { slides, locale, badges = [] } = Astro.props;
const contactPath = localizedPath(locale, "contact");
---

<section
  class="hero-slider"
  aria-label="Hero slideshow"
  data-hero-slider
>
  <!-- Slides -->
  {slides.map((slide, i) => (
    <div
      class={`hs-slide${i === 0 ? " is-active" : ""}`}
      data-slide={i}
      aria-hidden={i !== 0}
    >
      <!-- Background image -->
      <img
        src={slide.image}
        alt=""
        role="presentation"
        class="hs-bg"
        width="1920"
        height="1080"
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : "auto"}
        decoding="async"
      />
      <div class="hs-overlay" aria-hidden="true"></div>

      <!-- Content -->
      <div class="hs-content container">
        <div class="hs-inner">
          <p class="hs-eyebrow animate-fade-in">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {slide.eyebrow ?? ui("hero.eyebrow", locale).replace("{city}", siteConfig.business.city)}
          </p>

          <h1 class="hs-heading animate-fade-in delay-100">
            {t(slide.title, locale)}
          </h1>

          <p class="hs-subheading animate-fade-in delay-200">
            {t(slide.text, locale)}
          </p>

          <div class="hs-actions animate-fade-in delay-300">
            <a
              href={slide.primaryHref ?? contactPath}
              class="btn btn-primary btn-lg"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
              {t(slide.primaryText, locale)}
            </a>
            {slide.secondaryHref && (
              <a
                href={slide.secondaryHref}
                class="btn btn-secondary btn-lg"
              >
                {t(slide.secondaryText ?? { en: "Learn More", hr: "Saznaj više" }, locale)}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            )}
            {!slide.secondaryHref && (
              <a
                href={`tel:${siteConfig.business.phone}`}
                class="btn btn-secondary btn-lg"
              >
                {ui("hero.callCta", locale)} {siteConfig.business.phone}
              </a>
            )}
          </div>

          <!-- Trust badges -->
          {badges.length > 0 && (
            <div class="trust-bar animate-fade-in delay-400" role="list" aria-label="Trust indicators">
              {badges.map((badge) => (
                <span class="trust-item" role="listitem">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {badge}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  ))}

  <!-- Slide controls -->
  {slides.length > 1 && (
    <div class="hs-controls" role="tablist" aria-label="Slide navigation">
      {slides.map((_, i) => (
        <button
          class={`hs-dot${i === 0 ? " is-active" : ""}`}
          role="tab"
          aria-selected={i === 0}
          aria-label={`Go to slide ${i + 1}`}
          data-slide-btn={i}
          type="button"
        ></button>
      ))}
    </div>
  )}

  <!-- Prev / Next arrows -->
  {slides.length > 1 && (
    <>
      <button class="hs-arrow hs-arrow-prev" type="button" aria-label={ui("a11y.prevSlide", locale)} data-slide-prev>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="hs-arrow hs-arrow-next" type="button" aria-label={ui("a11y.nextSlide", locale)} data-slide-next>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </>
  )}
</section>

<style>
  .hero-slider {
    position: relative;
    isolation: isolate;
    min-height: 90vh;
    overflow: hidden;
    background: #0a0f1e;
  }

  /* Slide */
  .hs-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }
  .hs-slide.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  /* Background */
  .hs-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transform: scale(1.04);
    transition: transform 6s ease;
  }
  .hs-slide.is-active .hs-bg { transform: scale(1); }

  /* Overlay — two-layer for depth */
  .hs-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--brand-hero-overlay) 55%, rgba(0,0,0,.25) 100%),
      linear-gradient(to top, rgba(0,0,0,.45) 0%, transparent 60%);
    z-index: -1;
  }

  /* Content */
  .hs-content {
    position: relative;
    z-index: 1;
    padding-block: clamp(80px, 12vw, 140px);
    width: 100%;
  }

  .hs-inner {
    max-width: 720px;
  }

  .hs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin: 0 0 20px;
    max-width: none;
  }
  .hs-eyebrow svg { flex-shrink: 0; }

  .hs-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: white;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .hs-subheading {
    font-size: clamp(1rem, 1.5vw, 1.175rem);
    color: rgba(255,255,255,.82);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 580px;
  }

  .hs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  /* Slide dots */
  .hs-controls {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .hs-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255,255,255,.35);
    border: none;
    cursor: pointer;
    transition: background 0.2s, width 0.2s;
    padding: 0;
  }
  .hs-dot.is-active {
    background: var(--brand-accent);
    width: 28px;
  }
  .hs-dot:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 3px; }

  /* Arrows */
  .hs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
  }
  .hs-arrow:hover { background: rgba(255,255,255,.22); border-color: rgba(255,255,255,.4); }
  .hs-arrow:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 3px; }
  .hs-arrow-prev { left: 24px; }
  .hs-arrow-next { right: 24px; }

  @media (max-width: 768px) {
    .hero-slider { min-height: 80vh; }
    .hs-slide.is-active { min-height: 80vh; }
    .hs-arrow { display: none; }
    .hs-actions { flex-direction: column; align-items: flex-start; }
    .hs-actions .btn { width: 100%; justify-content: center; }
  }
</style>

<script is:inline>
(function() {
  var sliders = document.querySelectorAll("[data-hero-slider]");
  sliders.forEach(function(slider) {
    var slides = slider.querySelectorAll(".hs-slide");
    var dots   = slider.querySelectorAll("[data-slide-btn]");
    var prev   = slider.querySelector("[data-slide-prev]");
    var next   = slider.querySelector("[data-slide-next]");
    var current = 0;
    var total   = slides.length;
    var timer;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (total <= 1) return;

    function goTo(n) {
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      dots[current].classList.remove("is-active");
      dots[current].setAttribute("aria-selected", "false");
      current = (n + total) % total;
      slides[current].classList.add("is-active");
      slides[current].setAttribute("aria-hidden", "false");
      dots[current].classList.add("is-active");
      dots[current].setAttribute("aria-selected", "true");
    }

    function startAuto() {
      if (reduced) return;
      timer = setInterval(function() { goTo(current + 1); }, 5500);
    }

    function resetAuto() {
      clearInterval(timer);
      startAuto();
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener("click", function() { goTo(i); resetAuto(); });
    });

    if (prev) prev.addEventListener("click", function() { goTo(current - 1); resetAuto(); });
    if (next) next.addEventListener("click", function() { goTo(current + 1); resetAuto(); });

    // Keyboard support
    slider.addEventListener("keydown", function(e) {
      if (e.key === "ArrowLeft")  { goTo(current - 1); resetAuto(); }
      if (e.key === "ArrowRight") { goTo(current + 1); resetAuto(); }
    });

    startAuto();
  });
})();
</script>
