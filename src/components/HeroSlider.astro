---
import { t, localizedPath } from "@/lib/routes";
import { siteConfig, type Locale, type HeroSlide } from "@/site.config";
import { ui } from "@/i18n";

interface Props {
  slides: HeroSlide[];
  locale: Locale;
  trustItems?: string[];
}

const { slides, locale, trustItems } = Astro.props;

const defaultTrust = [
  ui("hero.trust.licensed",     locale),
  ui("hero.trust.sameDay",      locale),
  ui("hero.trust.guarantee",    locale),
  ui("hero.trust.freeEstimate", locale),
];
const trust = trustItems ?? defaultTrust;

const eyebrow = ui("hero.badge", locale)
  .replace("{city}",  siteConfig.business.city)
  .replace("{year}",  siteConfig.business.foundedYear);
---

<section class="hero-slider" role="region" aria-label="Featured content" aria-live="polite">
  {slides.map((slide, index) => (
    <div class={`hs-slide ${index === 0 ? "hs-slide--active" : ""}`} data-slide={index} aria-hidden={index !== 0 ? "true" : "false"}>
      <img src={slide.image} alt="" role="presentation" width="1920" height="1080" fetchpriority={index === 0 ? "high" : "low"} loading={index === 0 ? "eager" : "lazy"} decoding={index === 0 ? "sync" : "async"} class="hs-bg" />
      <div class="hs-overlay"></div>
      <div class="hs-bottom-fade"></div>
      <div class="container">
        <div class="hs-content">
          <div class="hs-eyebrow">
            <span class="hs-eyebrow-dot"></span>
            {eyebrow}
          </div>
          <h1 class="hs-title">{t(slide.title, locale)}</h1>
          <p class="hs-subtitle">{t(slide.text, locale)}</p>
          <div class="hs-actions">
            {slide.primaryText && (
              <a class="btn btn-primary hs-btn-primary" href={slide.primaryHref.startsWith("tel:") || slide.primaryHref.startsWith("http") ? slide.primaryHref : localizedPath(locale, slide.primaryHref)}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                {t(slide.primaryText, locale)}
              </a>
            )}
            {slide.secondaryText && slide.secondaryHref && (
              <a class="btn btn-outline-white hs-btn-secondary" href={slide.secondaryHref.startsWith("tel:") || slide.secondaryHref.startsWith("http") ? slide.secondaryHref : localizedPath(locale, slide.secondaryHref)}>
                {t(slide.secondaryText, locale)}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
          </div>
          {trust.length > 0 && (
            <div class="trust-bar">
              {trust.map((item) => (
                <div class="trust-item">
                  <div class="trust-item-check" aria-hidden="true">✓</div>
                  {item}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  ))}
  {slides.length > 1 && (
    <div class="hs-dots" role="tablist" aria-label="Slide navigation">
      {slides.map((_, index) => (
        <button class={`hs-dot ${index === 0 ? "hs-dot--active" : ""}`} data-dot={index} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-label={`Go to slide ${index + 1}`} type="button" />
      ))}
    </div>
  )}
  <div class="hs-scroll-hint" aria-hidden="true"><div class="hs-scroll-line"></div></div>
</section>

<style>
.hero-slider { position:relative; isolation:isolate; min-height:92vh; overflow:hidden; display:flex; align-items:stretch; }
.hs-slide { position:absolute; inset:0; display:flex; align-items:center; opacity:0; transition:opacity 0.9s cubic-bezier(0.4,0,0.2,1); pointer-events:none; }
.hs-slide--active { opacity:1; pointer-events:auto; position:relative; flex:1; }
.hs-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; z-index:-2; transform:scale(1.04); transition:transform 8s ease; }
.hs-slide--active .hs-bg { transform:scale(1); }
.hs-overlay { position:absolute; inset:0; background:var(--brand-hero-overlay,rgba(10,24,50,0.68)); z-index:-1; }
.hs-bottom-fade { position:absolute; bottom:0; left:0; right:0; height:200px; background:linear-gradient(to top,rgba(10,24,50,0.5) 0%,transparent 100%); z-index:-1; }
.hs-content { padding:clamp(80px,12vw,140px) 0 clamp(60px,8vw,100px); max-width:760px; color:white; }
.hs-eyebrow { display:inline-flex; align-items:center; gap:10px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.25); backdrop-filter:blur(8px); border-radius:100px; padding:8px 18px 8px 12px; font-family:var(--font-display); font-weight:700; font-size:0.78rem; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.92); margin-bottom:24px; }
.hs-eyebrow-dot { width:8px; height:8px; background:var(--brand-accent,#f59e0b); border-radius:50%; flex-shrink:0; box-shadow:0 0 0 3px rgba(245,158,11,0.3); animation:pulse-dot 2s ease infinite; }
@keyframes pulse-dot { 0%,100%{box-shadow:0 0 0 3px rgba(245,158,11,0.3)} 50%{box-shadow:0 0 0 6px rgba(245,158,11,0.15)} }
.hs-title { font-family:var(--font-display); font-size:clamp(2.6rem,6vw,4.2rem); font-weight:900; line-height:1.05; letter-spacing:-0.03em; color:white; margin:0 0 20px; text-shadow:0 2px 20px rgba(0,0,0,0.3); }
.hs-subtitle { font-size:clamp(1rem,1.6vw,1.15rem); line-height:1.7; color:rgba(255,255,255,0.85); margin:0 0 36px; max-width:580px; }
.hs-actions { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:36px; }
.hs-btn-primary { min-height:56px; padding:16px 32px; font-size:0.95rem; box-shadow:0 4px 20px rgba(245,158,11,0.4); }
.hs-btn-secondary { min-height:56px; padding:16px 28px; font-size:0.95rem; }
.hs-dots { position:absolute; bottom:32px; left:50%; transform:translateX(-50%); display:flex; gap:8px; z-index:10; }
.hs-dot { width:8px; height:8px; border-radius:100px; background:rgba(255,255,255,0.4); border:none; cursor:pointer; transition:all 0.3s ease; padding:0; }
.hs-dot--active { width:28px; background:var(--brand-accent,#f59e0b); }
.hs-scroll-hint { position:absolute; bottom:32px; right:40px; display:flex; flex-direction:column; align-items:center; gap:6px; opacity:0.5; }
.hs-scroll-line { width:1px; height:48px; background:linear-gradient(to bottom,rgba(255,255,255,0.8),transparent); animation:scroll-line 2s ease infinite; }
@keyframes scroll-line { 0%{transform:scaleY(0);transform-origin:top} 50%{transform:scaleY(1);transform-origin:top} 51%{transform:scaleY(1);transform-origin:bottom} 100%{transform:scaleY(0);transform-origin:bottom} }
@media(max-width:768px){.hero-slider{min-height:auto}.hs-content{padding:100px 0 80px}.hs-title{font-size:clamp(2rem,8vw,2.8rem)}.hs-actions{flex-direction:column;align-items:flex-start}.hs-btn-primary,.hs-btn-secondary{width:100%;justify-content:center}.hs-scroll-hint{display:none}}
</style>

<script is:inline>
(function(){var s=document.querySelector(".hero-slider");if(!s)return;var slides=s.querySelectorAll(".hs-slide"),dots=s.querySelectorAll(".hs-dot"),cur=0,total=slides.length,timer=null;function goTo(i){slides[cur].classList.remove("hs-slide--active");slides[cur].setAttribute("aria-hidden","true");if(dots[cur]){dots[cur].classList.remove("hs-dot--active");dots[cur].setAttribute("aria-selected","false");}cur=(i+total)%total;slides[cur].classList.add("hs-slide--active");slides[cur].setAttribute("aria-hidden","false");if(dots[cur]){dots[cur].classList.add("hs-dot--active");dots[cur].setAttribute("aria-selected","true");}}function start(){timer=setInterval(function(){goTo(cur+1);},7000);}function stop(){if(timer){clearInterval(timer);timer=null;}}dots.forEach(function(d){d.addEventListener("click",function(){stop();goTo(parseInt(d.getAttribute("data-dot"),10));start();});});s.addEventListener("mouseenter",stop);s.addEventListener("mouseleave",start);var sx=0;s.addEventListener("touchstart",function(e){sx=e.touches[0].clientX;},{passive:true});s.addEventListener("touchend",function(e){var diff=sx-e.changedTouches[0].clientX;if(Math.abs(diff)>50){stop();goTo(diff>0?cur+1:cur-1);start();}},{passive:true});s.addEventListener("keydown",function(e){if(e.key==="ArrowRight"){stop();goTo(cur+1);start();}if(e.key==="ArrowLeft"){stop();goTo(cur-1);start();}});if(total>1)start();})();
</script>
