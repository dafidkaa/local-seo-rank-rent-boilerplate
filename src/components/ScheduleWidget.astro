---
import { siteConfig } from "@/site.config";
const { title = "Schedule An Estimate", text = "Select a day and time to schedule a no-pressure, no-obligation quote." } = Astro.props;
---

<section class="section">
  <div class="container split">
    <div>
      <p class="eyebrow">Booking</p>
      <h2>{title}</h2>
      <p>{text}</p>
      <p>Connect Calendly, Acuity, SavvyCal, GoHighLevel, or a CRM-native booking widget in <code>siteConfig.integrations.calendlyUrl</code>.</p>
    </div>
    <div class="card">
      <div class="card-body">
        {siteConfig.integrations.calendlyUrl ? (
          <iframe
            title="Schedule an estimate"
            src={siteConfig.integrations.calendlyUrl}
            loading="lazy"
            style="width:100%;min-height:520px;border:0"
          ></iframe>
        ) : (
          <div style="min-height:320px;display:grid;place-items:center;text-align:center;background:var(--color-light);border-radius:var(--radius);padding:24px">
            <div>
              <h3>Booking Widget Placeholder</h3>
              <p>Add your real scheduling link before publishing this page.</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
