---
/**
 * BlogHub — shared blog archive template
 * ======================================
 * Used by /[lang]/blog/ (page 1) and /[lang]/blog/page/[page]/ (page 2+).
 *
 * SEO: every page is statically rendered with its own 9 posts and numbered
 * pagination links, so crawlers reach every post without JavaScript.
 * UX: search / category filter / sort run client-side over a JSON index of
 * ALL posts. While a filter is active the server grid is hidden and results
 * render dynamically; clearing filters restores the static grid.
 */
import BlogCard from "@/components/BlogCard.astro";
import { siteConfig } from "@/site.config";
import { t, localizedPath } from "@/lib/routes";

interface Props {
  locale: string;
  /** Posts for THIS page (already sliced) */
  pagePosts: any[];
  /** Newest post — rendered as the featured card on page 1 only */
  featured?: any | null;
  /** All posts (for the client-side search index + counts) */
  allPosts: any[];
  currentPage: number;
  totalPages: number;
}
const { locale, pagePosts, featured = null, allPosts, currentPage, totalPages } = Astro.props;

const dateLocaleStr = (l: string) => (l === "hr" ? "hr-HR" : "en-US");
const categories = [...new Set(allPosts.map((p) => p.data.category))].filter(Boolean);

const blogBase = localizedPath(locale, "blog");
const pageHref = (n: number) => (n <= 1 ? blogBase : `${blogBase}page/${n}/`);

// Compact JSON index for client-side search/filter/sort across all posts
const searchIndex = allPosts.map((p) => ({
  u: `${blogBase}${p.slug}/`,
  t: t(p.data.title, locale),
  e: t(p.data.excerpt, locale),
  i: p.data.image,
  c: p.data.category,
  d: p.data.date
}));

const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<!-- Blog Hub Hero -->
<section class="blog-hub-hero" aria-label="Blog">
  <img
    src={(siteConfig.brand as any).images?.blog ?? (siteConfig.brand as any).images?.hero1 ?? "https://images.unsplash.com/photo-1486325212027-8081e485255e?auto=format&fit=crop&w=1920&q=80"}
    alt=""
    role="presentation"
    class="blog-hub-hero-bg"
    width="1920"
    height="500"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="blog-hub-hero-overlay" aria-hidden="true"></div>
  <div class="blog-hub-hero-body">
    <div class="container blog-hub-hero-content">
      <nav class="blog-hub-hero-breadcrumbs" aria-label="Breadcrumb">
        <ol class="blog-hub-crumb-list">
          <li><a href={`/${locale}/`} class="blog-hub-crumb-link">Home</a><span class="blog-hub-crumb-sep" aria-hidden="true">›</span></li>
          {currentPage > 1 ? (
            <li><a href={blogBase} class="blog-hub-crumb-link">Blog</a><span class="blog-hub-crumb-sep" aria-hidden="true">›</span></li>
            <li><span aria-current="page" class="blog-hub-crumb-current">Page {currentPage}</span></li>
          ) : (
            <li><span aria-current="page" class="blog-hub-crumb-current">Blog</span></li>
          )}
        </ol>
      </nav>
      <p class="blog-hub-hero-eyebrow">Blog &amp; Resources</p>
      <h1 class="blog-hub-hero-h1">{siteConfig.business.name} Blog{currentPage > 1 ? ` — Page ${currentPage}` : ""}</h1>
      <p class="blog-hub-hero-desc">Tips, guides, and updates about {t(siteConfig.business.primaryService, locale)} in {siteConfig.business.city}.</p>
      <div class="blog-hub-hero-stats">
        <span class="blog-hub-hero-stat"><strong>{allPosts.length}</strong> Articles</span>
        <span class="blog-hub-hero-stat-sep" aria-hidden="true">·</span>
        <span class="blog-hub-hero-stat"><strong>{categories.length}</strong> Topics</span>
      </div>
    </div>
  </div>
</section>

<!-- Featured post (page 1 only) -->
{featured && (
  <section class="blog-featured-section">
    <div class="container">
      <a href={`${blogBase}${featured.slug}/`} class="blog-featured-card" aria-label={`Featured: ${t(featured.data.title, locale)}`}>
        <div class="blog-featured-img-wrap">
          <img
            src={featured.data.image}
            alt={t(featured.data.title, locale)}
            width="800"
            height="450"
            loading="eager"
            decoding="async"
            class="blog-featured-img"
          />
          <span class="blog-featured-badge">Featured</span>
        </div>
        <div class="blog-featured-body">
          <span class="blog-cat-pill">{featured.data.category}</span>
          <h2 class="blog-featured-title">{t(featured.data.title, locale)}</h2>
          <p class="blog-featured-excerpt">{t(featured.data.excerpt, locale)}</p>
          <div class="blog-featured-meta">
            <time datetime={featured.data.date}>
              {new Date(featured.data.date).toLocaleDateString(dateLocaleStr(locale), { year: "numeric", month: "long", day: "numeric" })}
            </time>
            <span class="blog-read-more">Read Article →</span>
          </div>
        </div>
      </a>
    </div>
  </section>
)}

<!-- Filter bar + grid -->
<section class="blog-grid-section">
  <div class="container">
    <div class="blog-filter-bar" id="blog-filters" role="search" aria-label="Filter blog posts">
      <div class="blog-filter-cats" role="group" aria-label="Filter by category">
        <button class="blog-filter-btn is-active" data-category="all" type="button">All</button>
        {categories.map((cat) => (
          <button class="blog-filter-btn" data-category={cat} type="button">{cat}</button>
        ))}
      </div>
      <div class="blog-filter-controls">
        <div class="blog-search-wrap">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            class="blog-search-input"
            type="search"
            placeholder="Search articles…"
            id="blog-search"
            aria-label="Search blog posts"
          />
        </div>
        <select class="blog-sort-select" id="blog-sort" aria-label="Sort posts">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
        </select>
      </div>
    </div>

    <p class="blog-no-results" id="blog-no-results" aria-live="polite" hidden>No posts match your search. Try a different keyword or category.</p>

    <!-- Static, crawlable grid for this page -->
    <div class="blog-grid" id="blog-grid" role="list">
      {pagePosts.map((post) => (
        <div class="blog-grid-item" role="listitem">
          <BlogCard post={post} locale={locale} />
        </div>
      ))}
    </div>

    <!-- Dynamic grid used while searching/filtering (hidden by default) -->
    <div class="blog-grid bdyn-grid" id="blog-dynamic-grid" role="list" hidden></div>

    <!-- Numbered static pagination -->
    {totalPages > 1 && (
      <nav class="blog-page-nav" id="blog-page-nav" aria-label="Blog pages">
        {currentPage > 1 && (
          <a href={pageHref(currentPage - 1)} class="blog-page-link blog-page-prev" rel="prev">← Previous</a>
        )}
        <ol class="blog-page-list">
          {pageNumbers.map((n) => (
            <li>
              {n === currentPage ? (
                <span class="blog-page-num is-current" aria-current="page">{n}</span>
              ) : (
                <a href={pageHref(n)} class="blog-page-num">{n}</a>
              )}
            </li>
          ))}
        </ol>
        {currentPage < totalPages && (
          <a href={pageHref(currentPage + 1)} class="blog-page-link blog-page-next" rel="next">Next →</a>
        )}
      </nav>
    )}

    <p class="blog-showing" id="blog-showing" aria-live="polite" hidden></p>
  </div>
</section>

<script is:inline type="application/json" id="blog-search-index" set:html={JSON.stringify(searchIndex)} />

<style>
  /* ── Blog Hub Hero ─────────────────────────────────────────────────────── */
  .blog-hub-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #0a0f1e;
    min-height: clamp(220px, 32vh, 340px);
  }
  .blog-hub-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .blog-hub-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right,
        color-mix(in srgb, var(--brand-secondary) 84%, black) 0%,
        color-mix(in srgb, var(--brand-secondary) 62%, transparent) 45%,
        color-mix(in srgb, var(--brand-secondary) 26%, transparent) 100%),
