---
/**
 * Gallery — image-rich proof section with lightbox
 * ================================================
 * Responsive grid (first image featured larger) + native <dialog> lightbox
 * with prev/next navigation. Feeds the "6–10 images per major page"
 * requirement and the image-rich proof section (master prompt §12.21).
 */
interface GalleryImage {
  src: string;
  alt: string;
}
interface Props {
  images: GalleryImage[];
  title?: string;
  eyebrow?: string;
  lead?: string;
}
const { images, title, eyebrow, lead } = Astro.props;
const galleryId = `gal-${Math.abs([...(title ?? "g")].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
---
{images.length > 0 && (
  <section class="gallery-section section" aria-label={title ?? "Gallery"}>
    <div class="container">
      {(title || eyebrow) && (
        <div class="section-header center">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2>{title}</h2>}
          {lead && <p class="gallery-lead">{lead}</p>}
        </div>
      )}
      <div class="gallery-grid" data-gallery={galleryId} data-reveal>
        {images.map((img, i) => (
          <button type="button" class={`gallery-item${i === 0 ? " gallery-item--featured" : ""}`} data-gallery-index={i} aria-label={`Open image: ${img.alt}`}>
            <img
              src={img.src}
              alt={img.alt}
              width={i === 0 ? 1200 : 600}
              height={i === 0 ? 800 : 400}
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-zoom" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </button>
        ))}
      </div>
    </div>

    <dialog class="gallery-lightbox" id={galleryId} aria-label={title ?? "Image viewer"}>
      <button type="button" class="gallery-close" data-lightbox-close aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button type="button" class="gallery-nav gallery-nav--prev" data-lightbox-prev aria-label="Previous image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <figure class="gallery-figure">
        <img class="gallery-lightbox-img" src="" alt="" />
        <figcaption class="gallery-caption"></figcaption>
      </figure>
      <button type="button" class="gallery-nav gallery-nav--next" data-lightbox-next aria-label="Next image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </dialog>
  </section>
)}

<style>
  .gallery-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted, #475569);
    max-width: 680px;
    margin: 12px auto 0;
    line-height: 1.7;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: clamp(28px, 4vw, 44px);
  }
  .gallery-item {
    position: relative;
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    aspect-ratio: 3/2;
  }
  .gallery-item--featured { grid-column: span 2; grid-row: span 2; }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-item:hover img { transform: scale(1.05); }
  .gallery-zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(4px);
    color: var(--brand-primary);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .gallery-item:hover .gallery-zoom, .gallery-item:focus-visible .gallery-zoom { opacity: 1; transform: translateY(0); }
  .gallery-item:focus-visible { outline: 3px solid var(--brand-accent); outline-offset: 2px; }

  .gallery-lightbox {
    border: none;
    background: transparent;
    padding: 0;
    max-width: min(92vw, 1100px);
    width: 100%;
  }
  .gallery-lightbox::backdrop { background: rgba(8, 12, 24, 0.92); backdrop-filter: blur(4px); }
  .gallery-figure { margin: 0; }
  .gallery-lightbox-img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-lg, 12px);
    display: block;
  }
  .gallery-caption { color: rgba(255,255,255,.8); text-align: center; font-size: 0.875rem; padding: 12px 8px 0; }
  .gallery-close, .gallery-nav {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,.12);
    color: white;
    cursor: pointer;
    transition: background 0.15s;
    z-index: 2;
  }
  .gallery-close:hover, .gallery-nav:hover { background: rgba(255,255,255,.25); }
  .gallery-close { top: 18px; right: 18px; }
  .gallery-nav--prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .gallery-nav--next { right: 14px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 900px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .gallery-item--featured { grid-column: span 2; grid-row: span 1; }
  }
</style>

<script is:inline>
(function () {
  document.querySelectorAll("[data-gallery]").forEach(function (grid) {
    if (grid.__galleryBound) return;
    grid.__galleryBound = true;

    var dialog = document.getElementById(grid.getAttribute("data-gallery"));
    if (!dialog || !dialog.showModal) return;
    var imgEl = dialog.querySelector(".gallery-lightbox-img");
    var capEl = dialog.querySelector(".gallery-caption");
    var items = Array.from(grid.querySelectorAll("[data-gallery-index]"));
    var current = 0;

    function show(i) {
      current = (i + items.length) % items.length;
      var src = items[current].querySelector("img");
      if (imgEl && src) {
        imgEl.src = src.src;
        imgEl.alt = src.alt;
        if (capEl) capEl.textContent = src.alt;
      }
    }

    items.forEach(function (item, i) {
      item.addEventListener("click", function () {
        show(i);
        dialog.showModal();
        if (window.gtag) window.gtag("event", "gallery_open", { index: i });
      });
    });
    dialog.querySelector("[data-lightbox-close]").addEventListener("click", function () { dialog.close(); });
    dialog.querySelector("[data-lightbox-prev]").addEventListener("click", function () { show(current - 1); });
    dialog.querySelector("[data-lightbox-next]").addEventListener("click", function () { show(current + 1); });
    dialog.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
    dialog.addEventListener("click", function (e) {
      if (e.target === dialog) dialog.close();
    });
  });
})();
</script>
