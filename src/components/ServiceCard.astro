---
/**
 * ServiceCard — Premium Photo-Rich Service Card
 * Hover: image zooms, card lifts, arrow appears
 */
const { title, description, image, href, alt } = Astro.props;
---
<a class="sc-card" href={href} aria-label={`Learn more about ${title}`}>
  <div class="sc-img-wrap">
    <img src={image} alt={alt} width="600" height="400" loading="lazy" decoding="async" class="sc-img" />
    <div class="sc-img-overlay"></div>
  </div>
  <div class="sc-body">
    <h3 class="sc-title">{title}</h3>
    <p class="sc-desc">{description}</p>
    <div class="sc-cta">
      <span>Learn More</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
  </div>
</a>

<style>
.sc-card { display:flex; flex-direction:column; background:white; border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; box-shadow:0 1px 3px rgba(0,0,0,.06),0 4px 16px rgba(0,0,0,.06); transition:box-shadow 0.25s ease,transform 0.25s ease; }
.sc-card:hover { box-shadow:0 4px 8px rgba(0,0,0,.08),0 16px 40px rgba(0,0,0,.12); transform:translateY(-4px); }
.sc-img-wrap { position:relative; overflow:hidden; aspect-ratio:3/2; }
.sc-img { width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; }
.sc-card:hover .sc-img { transform:scale(1.06); }
.sc-img-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(10,24,50,0.45) 0%,transparent 60%); opacity:0; transition:opacity 0.3s ease; }
.sc-card:hover .sc-img-overlay { opacity:1; }
.sc-body { padding:24px; display:flex; flex-direction:column; flex:1; }
.sc-title { font-family:var(--font-display); font-size:1.1rem; font-weight:800; color:var(--brand-primary,#1e3a5f); margin:0 0 10px; line-height:1.25; letter-spacing:-0.01em; }
.sc-desc { font-size:0.9rem; color:#475569; line-height:1.65; margin:0 0 20px; flex:1; }
.sc-cta { display:flex; align-items:center; gap:8px; font-family:var(--font-display); font-size:0.82rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--brand-accent,#f59e0b); margin-top:auto; transition:gap 0.2s ease; }
.sc-card:hover .sc-cta { gap:12px; }
</style>
