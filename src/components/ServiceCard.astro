---
/**
 * ServiceCard — Premium photo-rich service card
 * - Image zoom on hover, card lift, arrow reveal
 * - Proper alt text, cursor-pointer, focus-visible ring
 */
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  alt: string;
}

const { title, description, image, href, alt } = Astro.props;
---

<article class="svc-card">
  <a href={href} class="svc-card-link" aria-label={`Learn more about ${title}`}>
    <!-- Image -->
    <div class="svc-card-img-wrap" aria-hidden="true">
      <img
        src={image}
        alt={alt}
        class="svc-card-img"
        width="900"
        height="540"
        loading="lazy"
        decoding="async"
      />
      <div class="svc-card-img-overlay" aria-hidden="true"></div>
    </div>

    <!-- Body -->
    <div class="svc-card-body">
      <h3 class="svc-card-title">{title}</h3>
      <p class="svc-card-desc">{description}</p>
      <span class="svc-card-cta" aria-hidden="true">
        Learn More
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </span>
    </div>
  </a>
</article>

<style>
  .svc-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: white;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition-slow),
                transform var(--transition-slow),
                border-color var(--transition-slow);
  }
  .svc-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
    border-color: var(--color-border-dark);
  }

  .svc-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    height: 100%;
  }
  .svc-card-link:focus-visible {
    outline: 3px solid var(--brand-accent);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  /* Image */
  .svc-card-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/10;
  }
  .svc-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
  }
  .svc-card:hover .svc-card-img { transform: scale(1.06); }

  .svc-card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,15,40,.55) 0%, transparent 60%);
    transition: opacity var(--transition-slow);
  }
  .svc-card:hover .svc-card-img-overlay { opacity: 0.7; }

  /* Body */
  .svc-card-body {
    padding: 22px 24px 24px;
  }

  .svc-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin: 0 0 8px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    transition: color var(--transition-base);
  }
  .svc-card:hover .svc-card-title { color: var(--brand-accent-dark); }

  .svc-card-desc {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: none;
  }

  .svc-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-accent-dark);
    transition: gap var(--transition-base), color var(--transition-base);
  }
  .svc-card:hover .svc-card-cta { gap: 9px; }
  .svc-card-cta svg { transition: transform var(--transition-base); }
  .svc-card:hover .svc-card-cta svg { transform: translateX(3px); }
</style>
