---
/**
 * LocationCard — Photo-rich location card with overlay
 * Premium: gradient overlay, hover zoom, city name prominent
 */
interface Props {
  title: string;
  href: string;
  image: string;
}

const { title, href, image } = Astro.props;
---

<a href={href} class="loc-card" aria-label={`Plumbing services in ${title}`}>
  <div class="loc-card-img-wrap">
    <img
      src={image}
      alt={`${title} service area`}
      class="loc-card-img"
      width="600"
      height="400"
      loading="lazy"
      decoding="async"
    />
    <div class="loc-card-overlay" aria-hidden="true"></div>
  </div>
  <div class="loc-card-body">
    <h3 class="loc-card-title">{title}</h3>
    <span class="loc-card-link" aria-hidden="true">
      View Services
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </span>
  </div>
</a>

<style>
  .loc-card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    text-decoration: none;
    min-height: 220px;
    background: var(--brand-primary);
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
    box-shadow: var(--shadow-card);
  }
  .loc-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .loc-card:focus-visible {
    outline: 3px solid var(--brand-accent);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  .loc-card-img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .loc-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .loc-card:hover .loc-card-img { transform: scale(1.07); }

  .loc-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,15,40,.85) 0%, rgba(10,15,40,.3) 60%, transparent 100%);
    transition: opacity var(--transition-slow);
  }
  .loc-card:hover .loc-card-overlay { opacity: 0.9; }

  .loc-card-body {
    position: relative;
    z-index: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 220px;
  }

  .loc-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: white;
    margin: 0 0 6px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .loc-card-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand-accent);
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    transition: gap var(--transition-base);
  }
  .loc-card:hover .loc-card-link { gap: 8px; }
</style>
