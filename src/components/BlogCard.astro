---
/**
 * BlogCard — Compact, photo-rich blog post card
 */
import { t } from "@/lib/routes";
import type { Locale } from "@/site.config";
interface Props {
  post: any;
  locale: string;
}
const { post, locale } = Astro.props;
const dateLocale = locale === "hr" ? "hr-HR" : "en-US";
const dateStr = new Date(post.data.date).toLocaleDateString(dateLocale, { year: "numeric", month: "short", day: "numeric" });
const href = `/${locale}/blog/${post.slug}/`;
---
<article class="blog-card">
  <a href={href} class="blog-card-img-link" tabindex="-1" aria-hidden="true">
    <div class="blog-card-img-wrap">
      <img
        src={post.data.image}
        alt={t(post.data.title, locale)}
        width="600"
        height="338"
        loading="lazy"
        decoding="async"
        class="blog-card-img"
      />
      {post.data.category && <span class="blog-card-cat">{post.data.category}</span>}
    </div>
  </a>
  <div class="blog-card-body">
    <time class="blog-card-date" datetime={post.data.date}>{dateStr}</time>
    <h3 class="blog-card-title">
      <a href={href}>{t(post.data.title, locale)}</a>
    </h3>
    <p class="blog-card-excerpt">{t(post.data.excerpt, locale)}</p>
    <a href={href} class="blog-card-link" aria-label={`Read: ${t(post.data.title, locale)}`}>
      Read Article
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</article>
<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-xl, 16px);
    overflow: hidden;
    height: 100%;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .blog-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-3px); }
  .blog-card-img-link { display: block; }
  .blog-card-img-wrap { position: relative; overflow: hidden; aspect-ratio: 16/9; }
  .blog-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; display: block; }
  .blog-card:hover .blog-card-img { transform: scale(1.04); }
  .blog-card-cat {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: var(--brand-accent);
    color: var(--brand-primary);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }
  .blog-card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
  }
  .blog-card-date { font-size: 0.75rem; color: #94a3b8; font-family: var(--font-display); font-weight: 500; }
  .blog-card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand-primary);
    line-height: 1.35;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .blog-card-title a { color: inherit; text-decoration: none; }
  .blog-card-title a:hover { color: var(--brand-accent-dark, #d97706); }
  .blog-card-excerpt {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-accent-dark, #d97706);
    text-decoration: none;
    margin-top: 4px;
    transition: gap 0.15s;
  }
  .blog-card-link:hover { gap: 8px; }
</style>
