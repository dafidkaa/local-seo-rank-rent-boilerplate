---
/**
 * Hero — Inner page hero (used on About, Service, Location, Contact, etc.)
 * - Shorter than homepage hero (60vh)
 * - Eyebrow + heading + subtext + dual CTAs
 * - Same dark overlay system as HeroSlider
 */
import { siteConfig, type Locale } from "@/site.config";
import { localizedPath } from "@/lib/routes";

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  image: string;
  primaryHref?: string;
  primaryText?: string;
  secondaryHref?: string;
  secondaryText?: string;
  locale?: Locale;
  size?: "normal" | "large";
}

const {
  eyebrow,
  title,
  text,
  image,
  primaryHref,
  primaryText,
  secondaryHref,
  secondaryText,
  locale = "en",
  size = "normal",
} = Astro.props;
---

<section class={`inner-hero inner-hero--${size}`} aria-label={title}>
  <!-- Background -->
  <img
    src={image}
    alt=""
    role="presentation"
    class="inner-hero-bg"
    width="1920"
    height="700"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="inner-hero-overlay" aria-hidden="true"></div>

  <!-- Content -->
  <div class="container inner-hero-content">
    {eyebrow && (
      <p class="inner-hero-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        {eyebrow}
      </p>
    )}
    <h1 class="inner-hero-heading">{title}</h1>
    {text && <p class="inner-hero-text">{text}</p>}
    {(primaryHref || secondaryHref) && (
      <div class="inner-hero-actions">
        {primaryHref && (
          <a href={primaryHref} class="btn btn-primary btn-lg">
            {primaryText ?? "Get Free Estimate"}
          </a>
        )}
        {secondaryHref && (
          <a href={secondaryHref} class="btn btn-secondary btn-lg">
            {secondaryText ?? "Learn More"}
          </a>
        )}
        {!secondaryHref && (
          <a href={`tel:${siteConfig.business.phone}`} class="btn btn-secondary btn-lg">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
            {siteConfig.business.phone}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .inner-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #0a0f1e;
    min-height: 55vh;
  }
  .inner-hero--large { min-height: 70vh; }

  .inner-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .inner-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8,14,35,.85) 50%, rgba(8,14,35,.45) 100%),
      linear-gradient(to top, rgba(0,0,0,.4) 0%, transparent 60%);
    z-index: -1;
  }

  .inner-hero-content {
    padding-block: clamp(64px, 9vw, 112px);
    position: relative;
    z-index: 1;
  }

  .inner-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin: 0 0 16px;
    max-width: none;
  }

  .inner-hero-heading {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    max-width: 700px;
    text-wrap: balance;
  }

  .inner-hero-text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: rgba(255,255,255,.78);
    line-height: 1.7;
    margin: 0 0 32px;
    max-width: 580px;
  }

  .inner-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  @media (max-width: 640px) {
    .inner-hero { min-height: 50vh; }
    .inner-hero-actions { flex-direction: column; align-items: flex-start; }
    .inner-hero-actions .btn { width: 100%; justify-content: center; }
  }
</style>
