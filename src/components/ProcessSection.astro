---
/**
 * ProcessSection — Dark numbered steps with connecting line
 * Premium: large step numbers, subtle connecting line, icon marks
 */
interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  subtitle?: string;
  steps: Step[];
}

const { title, subtitle, steps } = Astro.props;
---

<section class="process-section section-charcoal section">
  <div class="container">
    <!-- Header -->
    <div class="section-header center">
      <p class="eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        How It Works
      </p>
      <h2 style="color:white">{title}</h2>
      {subtitle && <p style="color:rgba(255,255,255,.65);margin-inline:auto">{subtitle}</p>}
    </div>

    <!-- Steps -->
    <div class="process-steps" role="list">
      {steps.map((step, i) => (
        <article class="process-step" role="listitem">
          <!-- Number -->
          <div class="process-num" aria-hidden="true">
            <span>{String(i + 1).padStart(2, "0")}</span>
          </div>

          <!-- Connector (hidden on last) -->
          {i < steps.length - 1 && (
            <div class="process-connector" aria-hidden="true"></div>
          )}

          <!-- Content -->
          <div class="process-content">
            <h3 class="process-title">{step.title}</h3>
            <p class="process-text">{step.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 0 24px;
  }

  /* Number circle */
  .process-num {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: transparent;
    border: 2px solid var(--brand-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  .process-num span {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--brand-accent);
    letter-spacing: -0.02em;
  }

  /* Horizontal connector line */
  .process-connector {
    position: absolute;
    top: 36px;
    left: calc(50% + 36px);
    right: calc(-50% + 36px);
    height: 1px;
    background: linear-gradient(to right, rgba(245,158,11,.4), rgba(245,158,11,.1));
    z-index: 0;
  }

  .process-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: white;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .process-text {
    font-size: 0.875rem;
    color: rgba(255,255,255,.6);
    line-height: 1.7;
    margin: 0;
    max-width: 220px;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .process-steps {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .process-connector { display: none; }
    .process-step { flex-direction: row; text-align: left; gap: 20px; padding: 0; }
    .process-num { margin-bottom: 0; flex-shrink: 0; }
    .process-text { margin-inline: 0; max-width: none; }
  }
</style>
