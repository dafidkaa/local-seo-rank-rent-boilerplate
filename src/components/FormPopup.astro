---
/**
 * FormPopup — Global modal form triggered by [data-open-form-popup]
 * Features:
 * - Appears on any page without redirect
 * - Webhook POST with full metadata: page URL, referrer, timestamp
 * - GDPR consent checkbox with privacy policy + T&C links
 * - Wide 2-column layout to minimize vertical scrolling
 * - Trap focus, Escape to close, scroll lock
 * - Analytics events on open and submit
 */
import { siteConfig, allServices, type Locale } from "@/site.config";
import { localizedPath, t } from "@/lib/routes";
import { ui } from "@/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const webhookUrl  = siteConfig.integrations.crmWebhookUrl;
const privacyUrl  = localizedPath(locale, "privacy-policy");
const termsUrl    = localizedPath(locale, "terms-and-conditions");
const serviceName = t(siteConfig.business.primaryService, locale);
---
<!-- Popup backdrop -->
<div
  id="form-popup"
  class="fp-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fp-title"
  aria-hidden="true"
  data-popup-backdrop
>
  <div class="fp-panel" role="document">
    <!-- Close button -->
    <button
      type="button"
      class="fp-close"
      data-popup-close
      aria-label="Close form"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <!-- Panel header -->
    <div class="fp-header">
      <p class="fp-eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
        Free Estimate
      </p>
      <h2 id="fp-title" class="fp-title">Get Your Free {serviceName} Estimate</h2>
      <p class="fp-subtitle">We respond within one business hour. No obligation, no pressure.</p>
    </div>
    <!-- Form -->
    <form
      class="fp-form"
      id="fp-form"
      data-popup-form
      data-webhook={webhookUrl}
      data-locale={locale}
      novalidate
      aria-label="Free estimate request form"
    >
      <!-- Honeypot -->
      <div class="fp-honeypot" aria-hidden="true">
        <label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      <!-- Hidden metadata fields — populated by JS -->
      <input type="hidden" name="locale"    value={locale} />
      <input type="hidden" name="pagePath"  id="fp-pagePath" />
      <input type="hidden" name="referrer"  id="fp-referrer" />
      <input type="hidden" name="timestamp" id="fp-timestamp" />
      <!-- Row 1: First + Last name -->
      <div class="fp-row">
        <div class="fp-field">
          <label class="fp-label" for="fp-firstName">
            First Name <span class="fp-req" aria-hidden="true">*</span>
          </label>
          <input
            id="fp-firstName"
            class="fp-input"
            name="firstName"
            type="text"
            required
            autocomplete="given-name"
            aria-required="true"
            placeholder="John"
          />
        </div>
        <div class="fp-field">
          <label class="fp-label" for="fp-lastName">
            Last Name <span class="fp-req" aria-hidden="true">*</span>
          </label>
          <input
            id="fp-lastName"
            class="fp-input"
            name="lastName"
            type="text"
            required
            autocomplete="family-name"
            aria-required="true"
            placeholder="Smith"
          />
        </div>
      </div>
      <!-- Row 2: Phone + Email -->
      <div class="fp-row">
        <div class="fp-field">
          <label class="fp-label" for="fp-phone">
            Phone <span class="fp-req" aria-hidden="true">*</span>
          </label>
          <input
            id="fp-phone"
            class="fp-input"
            name="phone"
            type="tel"
            required
            inputmode="tel"
            autocomplete="tel"
            aria-required="true"
            pattern="^[0-9+() .\-]{7,}$"
            placeholder="(512) 555-0100"
          />
        </div>
        <div class="fp-field">
          <label class="fp-label" for="fp-email">
            Email <span class="fp-req" aria-hidden="true">*</span>
          </label>
          <input
            id="fp-email"
            class="fp-input"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-required="true"
            placeholder="john@example.com"
          />
        </div>
      </div>
      <!-- Row 3: Service + Address -->
      <div class="fp-row">
        <div class="fp-field">
          <label class="fp-label" for="fp-service">
            Service Needed <span class="fp-req" aria-hidden="true">*</span>
          </label>
          <div class="fp-select-wrap">
            <select
              id="fp-service"
              class="fp-select"
              name="serviceNeeded"
              required
              aria-required="true"
            >
              <option value="">Select a service…</option>
              {allServices.map((item) => (
                <option value={item.id}>{t(item.title, locale)}</option>
              ))}
            </select>
            <svg class="fp-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <div class="fp-field">
          <label class="fp-label" for="fp-address">
            Service Address
          </label>
          <input
            id="fp-address"
            class="fp-input"
            name="serviceAddress"
            type="text"
            autocomplete="street-address"
            placeholder="123 Main St, Austin TX"
          />
        </div>
      </div>
      <!-- Row 4: Details (full width) -->
      <div class="fp-field fp-field--full">
        <label class="fp-label" for="fp-details">
          Additional Details <span class="fp-optional">(optional)</span>
        </label>
        <textarea
          id="fp-details"
          class="fp-textarea"
          name="details"
          rows="2"
          placeholder="Describe the issue, any urgency, or special requirements…"
        ></textarea>
      </div>
      <!-- GDPR consent checkbox -->
      <div class="fp-consent-row">
        <input
          type="checkbox"
          id="fp-consent"
          name="gdprConsent"
          required
          aria-required="true"
          class="fp-checkbox"
        />
        <label for="fp-consent" class="fp-consent-label">
          I agree to the processing of my personal data for the purposes of this inquiry, in accordance with the
          <a href={privacyUrl} target="_blank" rel="noopener noreferrer">Privacy Policy</a>
          and
          <a href={termsUrl} target="_blank" rel="noopener noreferrer">Terms of Service</a>.
          <span class="fp-req" aria-hidden="true">*</span>
        </label>
      </div>
      <!-- Error message -->
      <div class="fp-error" role="alert" aria-live="polite" id="fp-error"></div>
      <!-- Submit -->
      <button type="submit" class="btn btn-primary fp-submit" data-fp-submit>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
        <span data-fp-btn-text>Get My Free Estimate</span>
      </button>
      <!-- Privacy note -->
      <p class="fp-privacy-note">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Your information is private and will never be shared.
      </p>
    </form>
  </div>
</div>
<style>
  /* ── Backdrop ──────────────────────────────────────────────────────────── */
  .fp-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(10, 15, 30, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .fp-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }
  /* ── Panel ─────────────────────────────────────────────────────────────── */
  .fp-panel {
    background: white;
    border-radius: var(--radius-2xl, 20px);
    width: 100%;
    max-width: 760px;
    max-height: 90svh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 24px 80px rgba(0,0,0,.35);
    transform: translateY(16px) scale(0.98);
    transition: transform 0.25s ease;
    padding: clamp(24px, 4vw, 40px);
  }
  .fp-backdrop.is-open .fp-panel {
    transform: translateY(0) scale(1);
  }
  /* ── Close button ──────────────────────────────────────────────────────── */
  .fp-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f1f5f9;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: background 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .fp-close:hover { background: #e2e8f0; color: var(--brand-primary); }
  .fp-close:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  /* ── Header ────────────────────────────────────────────────────────────── */
  .fp-header { margin-bottom: 24px; padding-right: 40px; }
  .fp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent-dark, #d97706);
    margin: 0 0 8px;
  }
  .fp-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    font-weight: 800;
    color: var(--brand-primary);
    margin: 0 0 6px;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .fp-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
  }
  /* ── Form layout ───────────────────────────────────────────────────────── */
  .fp-form { display: flex; flex-direction: column; gap: 14px; }
  .fp-honeypot { display: none !important; visibility: hidden; }
  /* ── Row: 2-column ─────────────────────────────────────────────────────── */
  .fp-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .fp-field { display: flex; flex-direction: column; gap: 5px; }
  .fp-field--full { grid-column: 1 / -1; }
  /* ── Labels ────────────────────────────────────────────────────────────── */
  .fp-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand-primary);
    line-height: 1.3;
  }
  .fp-req { color: var(--brand-accent-dark, #d97706); margin-left: 2px; }
  .fp-optional { font-weight: 400; color: #94a3b8; font-size: 0.75rem; }
  /* ── Inputs ────────────────────────────────────────────────────────────── */
  .fp-input,
  .fp-select,
  .fp-textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: var(--radius-lg, 10px);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--brand-primary);
    background: white;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
  }
  .fp-input::placeholder,
  .fp-textarea::placeholder { color: #94a3b8; }
  .fp-input:focus,
  .fp-select:focus,
  .fp-textarea:focus {
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 3px var(--brand-accent-light, #fef3c7);
  }
  .fp-input.is-invalid,
  .fp-select.is-invalid { border-color: #ef4444; box-shadow: 0 0 0 3px #fee2e2; }
  /* ── Select wrapper ────────────────────────────────────────────────────── */
  .fp-select-wrap { position: relative; }
  .fp-select { padding-right: 36px; cursor: pointer; }
  .fp-select-arrow {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #94a3b8;
  }
  /* ── Textarea ──────────────────────────────────────────────────────────── */
  .fp-textarea { resize: vertical; min-height: 64px; }
  /* ── Consent row ───────────────────────────────────────────────────────── */
  .fp-consent-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-lg, 10px);
  }
  .fp-checkbox {
    width: 18px;
    height: 18px;
    border: 2px solid #cbd5e1;
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 1px;
    accent-color: var(--brand-accent);
  }
  .fp-consent-label {
    font-size: 0.8125rem;
    color: #475569;
    line-height: 1.55;
    cursor: pointer;
  }
  .fp-consent-label a {
    color: var(--brand-accent-dark, #d97706);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* ── Error ─────────────────────────────────────────────────────────────── */
  .fp-error {
    font-size: 0.875rem;
    color: #ef4444;
    min-height: 0;
    transition: min-height 0.2s;
  }
  .fp-error:not(:empty) { min-height: 20px; }
  /* ── Submit ────────────────────────────────────────────────────────────── */
  .fp-submit {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 14px 24px;
  }
  /* ── Privacy note ──────────────────────────────────────────────────────── */
  .fp-privacy-note {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #94a3b8;
    margin: 0;
    justify-content: center;
  }
  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .fp-row { grid-template-columns: 1fr; }
    .fp-panel { padding: 20px 16px; }
  }
</style>
<script is:inline>
(function() {
  var backdrop = document.getElementById("form-popup");
  if (!backdrop) return;
  var form     = document.getElementById("fp-form");
  var errorEl  = document.getElementById("fp-error");
  var btn      = form ? form.querySelector("[data-fp-submit]") : null;
  var btnText  = form ? form.querySelector("[data-fp-btn-text]") : null;

  /* ── Open / close helpers ─────────────────────────────────────────────── */
  function openPopup() {
    backdrop.classList.add("is-open");
    backdrop.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // Populate metadata
    var now = new Date();
    var pad = function(n) { return String(n).padStart(2, "0"); };
    var ts  = pad(now.getDate()) + "." + pad(now.getMonth()+1) + "." + now.getFullYear()
            + ", " + pad(now.getHours()) + ":" + pad(now.getMinutes()) + ":" + pad(now.getSeconds());
    var pathEl = document.getElementById("fp-pagePath");
    var refEl  = document.getElementById("fp-referrer");
    var tsEl   = document.getElementById("fp-timestamp");
    if (pathEl) pathEl.value = window.location.href;
    if (refEl)  refEl.value  = document.referrer || "";
    if (tsEl)   tsEl.value   = ts;
    // Analytics
    if (window.gtag) window.gtag("event", "form_popup_open", { page: window.location.pathname });
    // Focus first input
    setTimeout(function() {
      var first = backdrop.querySelector("input:not([type=hidden]):not([tabindex='-1'])");
      if (first) first.focus();
    }, 50);
  }

  function closePopup() {
    backdrop.classList.remove("is-open");
    backdrop.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    // Return focus to trigger
    if (window.__fpLastTrigger) { window.__fpLastTrigger.focus(); window.__fpLastTrigger = null; }
  }

  /* ── Trigger: any [data-open-form-popup] ─────────────────────────────── */
  document.addEventListener("click", function(e) {
    var trigger = e.target.closest("[data-open-form-popup]");
    if (trigger) {
      e.preventDefault();
      window.__fpLastTrigger = trigger;
      openPopup();
    }
  });

  /* ── Close: backdrop click, close button, Escape ─────────────────────── */
  backdrop.addEventListener("click", function(e) {
    if (e.target === backdrop) closePopup();
  });
  var closeBtn = backdrop.querySelector("[data-popup-close]");
  if (closeBtn) closeBtn.addEventListener("click", closePopup);
  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape" && backdrop.classList.contains("is-open")) closePopup();
  });

  /* ── Focus trap ───────────────────────────────────────────────────────── */
  backdrop.addEventListener("keydown", function(e) {
    if (e.key !== "Tab") return;
    var focusable = Array.from(backdrop.querySelectorAll(
      'a[href],button:not([disabled]),input:not([tabindex="-1"]),select,textarea,[tabindex]:not([tabindex="-1"])'
    )).filter(function(el) { return !el.closest(".fp-honeypot"); });
    if (!focusable.length) return;
    var first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
    else            { if (document.activeElement === last)  { e.preventDefault(); first.focus(); } }
  });

  /* ── Form submission ──────────────────────────────────────────────────── */
  if (!form) return;
  form.addEventListener("submit", function(e) {
    e.preventDefault();
    if (errorEl) errorEl.textContent = "";
    // Validate required fields
    var invalid = false;
    form.querySelectorAll("[required]").forEach(function(field) {
      field.classList.remove("is-invalid");
      var val = field.type === "checkbox" ? field.checked : field.value.trim();
      if (!val) { field.classList.add("is-invalid"); invalid = true; }
    });
    if (invalid) {
      if (errorEl) errorEl.textContent = "Please fill in all required fields.";
      return;
    }
    // Collect all data
    var data = {};
    form.querySelectorAll("input, select, textarea").forEach(function(field) {
      if (field.closest(".fp-honeypot")) return;
      if (field.name === "company") return; // honeypot
      if (field.type === "checkbox") { data[field.name] = field.checked; }
      else if (field.name)           { data[field.name] = field.value; }
    });
    // Analytics
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "lead_form_submit", form_type: "popup", page: data.pagePath });
    if (window.fbq)  window.fbq("track", "Lead");
    if (window.gtag) window.gtag("event", "conversion", { send_to: "AW-CONVERSION_ID/LABEL" });
    var webhook = form.getAttribute("data-webhook") || "";
    var locale  = form.getAttribute("data-locale") || "en";
    if (!webhook) {
      window.location.href = "/" + locale + "/thank-you/";
      return;
    }
    // Loading state
    if (btn) { btn.disabled = true; if (btnText) btnText.textContent = "Sending…"; }
    fetch(webhook, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
      mode: "cors"
    })
    .then(function(res) {
      if (res.ok) { window.location.href = "/" + locale + "/thank-you/"; }
      else { throw new Error("Server error " + res.status); }
    })
    .catch(function() {
      if (errorEl) errorEl.textContent = "Something went wrong. Please try again or call us directly.";
      if (btn) { btn.disabled = false; if (btnText) btnText.textContent = "Get My Free Estimate"; }
    });
  });
})();
</script>
