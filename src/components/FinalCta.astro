---
/**
 * FinalCta — Full-bleed dark CTA section with inline form
 * Split layout: compelling copy left, estimate form right
 */
import EstimateForm from "@/components/EstimateForm.astro";
import { siteConfig, type Locale } from "@/site.config";
import { ui } from "@/i18n";
import { t } from "@/lib/routes";

interface Props {
  locale: Locale;
  title?: string;
  text?: string;
  service?: string;
}

const { locale, title, text, service = "" } = Astro.props;

const serviceName = t(siteConfig.business.primaryService, locale);
const heading = title ?? ui("cta.heading", locale).replace("{service}", serviceName);
const body    = text  ?? ui("cta.subheading", locale)
  .replace("{service}", serviceName)
  .replace("{city}", siteConfig.business.city);
const trust   = ui("cta.trust", locale);
---

<section class="fcta-section">
  <!-- Background image with overlay -->
  <div class="fcta-bg" aria-hidden="true">
    <img src={siteConfig.brand.images.cta} alt="" role="presentation" width="1920" height="600" loading="lazy" decoding="async" class="fcta-bg-img" />
    <div class="fcta-bg-overlay"></div>
  </div>

  <div class="container">
    <div class="fcta-grid">

      <!-- Left: Copy -->
      <div class="fcta-copy">
        <p class="eyebrow">{ui("cta.eyebrow", locale)}</p>
        <h2 class="fcta-heading">{heading}</h2>
        <p class="fcta-body">{body}</p>

        <!-- Phone CTA -->
        <a href={`tel:${siteConfig.business.phone}`} class="fcta-phone">
          <div class="fcta-phone-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
          </div>
          <div>
            <div class="fcta-phone-label">Call us directly</div>
            <div class="fcta-phone-number">{siteConfig.business.phone}</div>
          </div>
        </a>

        <!-- Trust line -->
        <p class="fcta-trust">{trust}</p>
      </div>

      <!-- Right: Form card -->
      <div class="fcta-form-card">
        <div class="fcta-form-header">
          <h3>{ui("form.heading", locale)}</h3>
          <p>{ui("form.subheading", locale)}</p>
        </div>
        <EstimateForm locale={locale} service={service} />
      </div>

    </div>
  </div>
</section>

<style>
.fcta-section { position:relative; isolation:isolate; padding:clamp(72px,10vw,120px) 0; }
.fcta-bg { position:absolute; inset:0; z-index:-1; }
.fcta-bg-img { width:100%; height:100%; object-fit:cover; object-position:center; }
.fcta-bg-overlay { position:absolute; inset:0; background:linear-gradient(135deg,rgba(10,24,50,0.95) 0%,rgba(10,24,50,0.88) 50%,rgba(30,58,95,0.92) 100%); }
.fcta-grid { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:start; }
.fcta-copy { color:white; }
.fcta-copy .eyebrow { color:var(--brand-accent,#f59e0b); }
.fcta-heading { color:white; font-size:clamp(1.8rem,3vw,2.6rem); margin:0 0 20px; }
.fcta-body { color:rgba(255,255,255,0.75); font-size:1.05rem; line-height:1.7; margin:0 0 36px; }
.fcta-phone { display:flex; align-items:center; gap:16px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:12px; padding:16px 20px; text-decoration:none; color:white; transition:background 0.2s,border-color 0.2s; margin-bottom:24px; }
.fcta-phone:hover { background:rgba(255,255,255,0.14); border-color:rgba(255,255,255,0.3); }
.fcta-phone-icon { width:44px; height:44px; background:var(--brand-accent,#f59e0b); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#0f172a; }
.fcta-phone-label { font-size:0.78rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:rgba(255,255,255,0.6); margin-bottom:2px; }
.fcta-phone-number { font-family:var(--font-display); font-size:1.35rem; font-weight:800; color:white; letter-spacing:-0.01em; }
.fcta-trust { font-size:0.82rem; color:rgba(255,255,255,0.5); margin:0; }
.fcta-form-card { background:white; border-radius:20px; overflow:hidden; box-shadow:0 24px 64px rgba(0,0,0,0.35); }
.fcta-form-header { background:var(--brand-primary,#1e3a5f); padding:24px 28px; }
.fcta-form-header h3 { font-family:var(--font-display); font-size:1.15rem; font-weight:800; color:white; margin:0 0 6px; }
.fcta-form-header p { font-size:0.85rem; color:rgba(255,255,255,0.7); margin:0; }
@media(max-width:900px){.fcta-grid{grid-template-columns:1fr;gap:40px}}
</style>
